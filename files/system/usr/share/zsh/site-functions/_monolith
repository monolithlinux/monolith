#compdef monolith mjust ujust update upgrade
# Tab completion for monolith, its old names mjust and ujust, and update and
# upgrade, which are short for monolith update. monolith itself lists what can
# follow the words typed so far (monolith __complete), one
# VALUE<TAB>DESCRIPTION per line.
local -a candidates described before
local line
before=("${(@)words[2,CURRENT-1]}")
[[ $service == update || $service == upgrade ]] && before=(update "${before[@]}")
candidates=("${(@f)$(monolith __complete "${before[@]}" 2>/dev/null)}")
for line in "${candidates[@]}"; do
    [[ -n $line ]] || continue
    if [[ $line == *$'\t'* ]]; then
        described+=("${${line%%$'\t'*}//:/\\:}:${line#*$'\t'}")
    else
        described+=("${line//:/\\:}")
    fi
done
_describe -t commands 'monolith' described
