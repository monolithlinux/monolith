#!/usr/bin/bash
# monolith status: one screen that says how this computer is doing, and the
# command that fixes anything that needs attention. It changes nothing.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=common.sh
. "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/common.sh"

case "${1-}" in
    -h|--help)
        cat <<'EOF'
Usage: monolith status

Shows the build you're running, waiting updates, Secure Boot, the NVIDIA
driver, your last full update and the CPU scheduler, and says what to do
about anything that needs attention. It changes nothing.
EOF
        exit 0
        ;;
    "") ;;
    *) die "monolith status doesn't take arguments." ;;
esac

# row LEVEL KEY VALUE [NOTE COMMAND]...: one line of the card. LEVEL is ok,
# warn (needs attention), wait (happens at the next restart) or note. Each
# NOTE and COMMAND pair goes below the line; either can be empty.
rows=()
warnings=0
row() {
    local entry="$1"$'\x1f'"$2"$'\x1f'"$3"
    [[ $1 != warn ]] || warnings=$((warnings + 1))
    shift 3
    while (($# >= 2)); do
        entry+=$'\x1f'"$1"$'\x1e'"$2"
        shift 2
    done
    rows+=("$entry")
}

# hint TEXT COLOR: a line under a row, lined up with the values, or further
# left when it wouldn't fit there.
hint() {
    local indent=18
    if ((indent + ${#1} > MONOLITH_COLUMNS && ${#1} + 4 <= MONOLITH_COLUMNS)); then
        indent=4
    fi
    printf '%*s%s%s%s\n' "$indent" '' "$2" "$1" "$RESET"
}

print_rows() {
    local entry pair note command symbol color fields=()
    for entry in "${rows[@]}"; do
        IFS=$'\x1f' read -r -a fields <<<"$entry"
        case "${fields[0]}" in
            ok) symbol="$SYM_OK" color="$GOOD" ;;
            warn) symbol="$SYM_WARN" color="$WARN$BOLD" ;;
            wait) symbol="$SYM_UP" color="$ACCENT" ;;
            *) symbol="$SYM_NOTE" color="$DIM" ;;
        esac
        printf '  %s%s%s %s%-13s%s %s\n' "$color" "$symbol" "$RESET" "$BOLD" "${fields[1]}" "$RESET" "${fields[2]}"
        for pair in "${fields[@]:3}"; do
            note="${pair%%$'\x1e'*}" command="${pair#*$'\x1e'}"
            [[ -z $note ]] || hint "$note" "$DIM"
            [[ -z $command ]] || hint "$SYM_TO $command" "$ACCENT"
        done
    done
}

monolith_columns

# The build, and whether updates reach it.
if load_image_info; then
    if [[ $IMAGE_EDITION ]]; then
        source_text="$IMAGE_EDITION:${IMAGE_TAG:-?}"
    else
        source_text="${IMAGE_NAME:-an unknown image}${IMAGE_TAG:+:$IMAGE_TAG}"
    fi
    case "$IMAGE_SIGNED" in
        yes) source_text+=", signed" ;;
        no) source_text+=", not signed" ;;
    esac
    build="${IMAGE_VERSION:-unknown} from $source_text"
    if [[ $IMAGE_EDITION && $IMAGE_TAG =~ ^[0-9]{8}$ ]]; then
        row warn Updates "paused on the build from $(nice_date "$IMAGE_TAG")" \
            "When you're ready for the newest build:" "monolith rollback latest"
    elif [[ $IMAGE_EDITION && $IMAGE_TAG == pr-* ]]; then
        row warn Updates "test build from pull request ${IMAGE_TAG#pr-}" \
            "To return to the newest regular build:" "monolith rollback latest"
    elif [[ $NEXT_VERSION && $STAGED == yes ]]; then
        row wait Updates "build $NEXT_VERSION is downloaded; restart to use it"
    elif [[ $NEXT_VERSION ]]; then
        row wait Updates "your next restart starts build $NEXT_VERSION"
    else
        row ok Updates "up to date as of the last check"
    fi
    if [[ $IMAGE_SIGNED == no && $IMAGE_EDITION ]]; then
        row warn Signature "updates aren't checked against Monolith's signature" \
            "Switch to the signed image:" "rpm-ostree rebase ostree-image-signed:docker://$IMAGE_NAME:${IMAGE_TAG:-latest}"
    fi
    [[ -z ${LAYERED-} ]] || row note Layered "${LAYERED// /, }"
else
    build="unknown, rpm-ostree didn't answer"
fi

if systemctl -q is-enabled rpm-ostreed-automatic.timer 2>/dev/null; then
    row ok "Auto updates" "on, daily"
else
    row note "Auto updates" "off" "" "monolith toggle-updates enable"
fi

# Secure Boot and Monolith's key, which signs the kernel and NVIDIA driver.
sb="$(mokutil --sb-state 2>&1 || true)"
key="$(mokutil --test-key "$MONOLITH_MOK_KEY" 2>&1 || true)"
case "$key" in
    *"is already enrolled"*) key=enrolled ;;
    *"enrollment request"*) key=pending ;;
    *"is not enrolled"*) key=missing ;;
    *) key=unknown ;;
esac
enroll="Restart, choose Enroll MOK, and type the password monolith."
case "$sb" in
    *"SecureBoot enabled"*)
        if [[ $key == pending ]]; then
            row warn "Secure Boot" "on; Monolith's key waits to be enrolled" "$enroll" ""
        else
            row ok "Secure Boot" "on"
        fi
        ;;
    *"SecureBoot disabled"*)
        case "$key" in
            enrolled) row note "Secure Boot" "off; Monolith's key is enrolled, so you can turn it on" ;;
            pending) row warn "Secure Boot" "off; Monolith's key waits to be enrolled" "$enroll" "" ;;
            *) row note "Secure Boot" "off" "Before you turn it on:" "monolith enroll-secure-boot-key" ;;
        esac
        ;;
    *) row note "Secure Boot" "not available on this computer" ;;
esac

# The NVIDIA driver, where it matters.
nvidia_gpu=no
has_nvidia_gpu && nvidia_gpu=yes
if [[ -r $MONOLITH_SYSFS/module/nvidia/version ]]; then
    row ok NVIDIA "driver $(<"$MONOLITH_SYSFS/module/nvidia/version") is running"
elif [[ ${IMAGE_EDITION-} == kde-nvidia && $nvidia_gpu == yes ]]; then
    row warn NVIDIA "the driver didn't load" \
        "Its messages from this boot:" "journalctl -b -k --grep=nvidia" \
        "Cards older than the GTX 16 series need the KDE edition:" "monolith edition kde"
elif [[ ${IMAGE_EDITION-} == kde-nvidia ]]; then
    row warn NVIDIA "no NVIDIA card found" \
        "The KDE edition fits this computer better:" "monolith edition kde"
elif [[ $nvidia_gpu == yes ]]; then
    row note NVIDIA "card found, running on Nouveau/NVK" \
        "For NVIDIA's own driver on a GTX 16, RTX 20 or newer card:" "monolith edition kde-nvidia"
fi

# The last full update, which topgrade records for the login reminder.
if days="$(full_update_days)"; then
    if ((days >= 7)); then
        row warn "Full update" "$(days_ago "$days")" "Update your apps, containers and dev tools:" "monolith update"
    else
        row ok "Full update" "$(days_ago "$days")"
    fi
else
    row note "Full update" "not run yet" "" "monolith update"
fi

# The CPU scheduler.
if [[ -r $MONOLITH_SYSFS/kernel/sched_ext/state ]]; then
    if [[ $(<"$MONOLITH_SYSFS/kernel/sched_ext/state") == enabled ]]; then
        name="$(busctl --timeout=5 get-property org.scx.Loader /org/scx/Loader org.scx.Loader CurrentScheduler 2>/dev/null |
            sed -n 's/^s "\(.*\)"$/\1/p' || true)"
        if [[ -z $name || $name == unknown ]]; then
            name="$(cat -- "$MONOLITH_SYSFS/kernel/sched_ext/root/ops" 2>/dev/null || echo sched-ext)"
        fi
        mode="$(busctl --timeout=5 get-property org.scx.Loader /org/scx/Loader org.scx.Loader SchedulerMode 2>/dev/null |
            awk '{print $2}' || true)"
        case "$mode" in
            0) name+=" in auto mode" ;;
            1) name+=" in gaming mode" ;;
            2) name+=" in power save mode" ;;
            3) name+=" in low latency mode" ;;
            4) name+=" in server mode" ;;
        esac
        row ok Scheduler "$name"
    else
        row note Scheduler "the kernel's own" "" "monolith scheduler gaming"
    fi
fi

if ((warnings == 0)); then
    verdict="$GOOD$SYM_OK Everything looks fine$RESET"
elif ((warnings == 1)); then
    verdict="$WARN$BOLD$SYM_WARN 1 thing needs your attention$RESET"
else
    verdict="$WARN$BOLD$SYM_WARN $warnings things need your attention$RESET"
fi
beside small "$BOLD$(os_pretty_name)$RESET" "$DIM$build$RESET" "$verdict"
printf '\n'
print_rows
((warnings == 0))
