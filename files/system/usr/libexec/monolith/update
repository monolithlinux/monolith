             changes=[(r"upgraded package (\S+) from (\S+) to (\S+)", "{0} {1} {to} {2}")],
             current=[r"no packages to upgrade", r"versions did not change"]),
        Tool("uv", "uv", lambda s: present("uv")(s) and [["uv", "tool", "upgrade", "--all"]],
             changes=[(r"Updated (\S+) v?(\S+) -> v?(\S+)", "{0} {1} {to} {2}")],
             current=[r"nothing to upgrade"]),
        Tool("brew", "Homebrew", brew_commands,
             changes=[(r"Upgrading (\d+) outdated packages?", "{0} upgraded")],
             current=[r"already up-to-date"]),
        Tool("mise", "mise", lambda s: present("mise")(s) and [["mise", "plugins", "update"], ["mise", "upgrade"]]),
        Tool("cargo", "Cargo tools",
             lambda s: present("cargo", "cargo-install-update")(s) and [["cargo", "install-update", "--all"]],
             changes=[(r"[Uu]pdated (\d+ packages?)", "{0} updated")],
             current=[r"no packages need updating"]),
        Tool("claude", "Claude Code", lambda s: present("claude")(s) and [["claude", "update"]],
             changes=[(r"[Uu]pdated from (\S+) to (?:version )?(\S+)", "{0} {to} {1}")],
             current=[r"up to date"]),
        Tool("gh", "GitHub CLI", gh_commands,
             changes=[(r"(?:\[(\S+)\]:\s+)?upgraded from (\S+) to (\S+)", "{0} {1} {to} {2}"),
                      (r"Updated (\S+)$", "{0} updated")],
             current=[r"already up to date", r"all skills are up to date"]),
        Tool("fisher", "fish plugins",
             lambda s: present("fish")(s) and (CONFIG_HOME / "fish/functions/fisher.fish").is_file()
             and [["fish", "-c", "fisher update"]]),
        Tool("micro", "micro plugins",
             lambda s: present("micro")(s) and has_entries(CONFIG_HOME / "micro/plug")
             and [["micro", "-plugin", "update"]]),
        Tool("tmux", "tmux plugins", tpm_commands),
    ]


class Custom(Step):
    """A command from update.toml, run in the user's own shell."""
    weight, expect = 1, 30

    def __init__(self, id, title, command):
        super().__init__()
        self.id, self.title, self.command = id, title, command

    def commands(self):
        return self.command

    def run(self, session):
        shell = os.environ.get("SHELL") or ""
        if not (os.path.isabs(shell) and os.access(shell, os.X_OK)):
            shell = "/bin/sh"
        self.detail = self.command
        code, lines = session.run([shell, "-c", self.command])
        if code != 0:
            return Result(FAIL, last_error(lines) or f"exit {code}")
        return Result(OK, "Done")


def load_config():
    """skip and [commands] from update.toml."""
    try:
        text = CONFIG.read_text(encoding="utf-8")
    except FileNotFoundError:
        return [], {}
    except OSError as error:
        raise Usage(f"Can't read {tilde(CONFIG)}: {error.strerror}") from error
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        raise Usage(f"{tilde(CONFIG)} isn't valid TOML: {error}") from error
    unknown = sorted(set(data) - {"skip", "commands"})
    if unknown:
        raise Usage(f"{tilde(CONFIG)} has settings monolith update doesn't know: {', '.join(unknown)}")
    skip, commands = data.get("skip", []), data.get("commands", {})
    if not isinstance(skip, list) or not all(isinstance(s, str) for s in skip):
        raise Usage(f'In {tilde(CONFIG)}, skip must be a list of step names, such as skip = ["distrobox"]')
    if not isinstance(commands, dict) or not all(isinstance(v, str) and v.strip() for v in commands.values()):
        raise Usage(f'In {tilde(CONFIG)}, each command must be text, such as "Dotfiles" = "git -C ~/dotfiles pull"')
    return skip, commands


def all_steps(commands):
    steps = [System(), Flatpaks(), Apps(), Proton(), AppImages(), Distrobox(), Firmware()] + tools()
    taken = {step.id for step in steps}
    for name, command in commands.items():
        base = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "command"
        sid, n = base, 1
        while sid in taken:
            n += 1
            sid = f"{base}-{n}"
        taken.add(sid)
        steps.append(Custom(sid, name, command))
    return steps


def suggest(word, choices):
    import difflib
    match = difflib.get_close_matches(word, choices, n=1, cutoff=0.6)
    return f" Did you mean {match[0]}?" if match else ""


def select(steps, only, skip, config_skip):
    ids = [step.id for step in steps]
    for name in list(only) + list(skip):
        if name not in ids:
            raise Usage(f"monolith update doesn't have a step called {name}.{suggest(name, ids)} "
                        "See them all with: monolith update --list")
    warnings = [f"{tilde(CONFIG)} skips {name}, which isn't a step.{suggest(name, ids)}"
                for name in config_skip if name not in ids]
    left_out = set(skip) | (set(config_skip) - set(only))
    chosen = [s for s in steps if (not only or s.id in only) and s.id not in left_out]
    return chosen, [s for s in steps if s.id in left_out], warnings


# --- showing it ---------------------------------------------------------------------------

def mark(kind, paint):
    symbol = {OK: paint.good + SYM["ok"], WARN: paint.warn + SYM["warn"], FAIL: paint.bad + SYM["fail"]}
    return symbol.get(kind, paint.dim + SYM["stop"]) + paint.reset


def headline(session, paint):
    failed = sum(1 for s in session.found if s.result and s.result.kind == FAIL)
    if session.stop or session.abort or session.signal:
        return f"{paint.dim}{SYM['stop']}{paint.reset} {paint.bold}Stopped before the end{paint.reset}"
    if failed:
        return f"{paint.bad}{SYM['fail']}{paint.reset} {paint.bold}{plural(failed, 'step')} failed{paint.reset}"
    return f"{paint.good}{SYM['ok']}{paint.reset} {paint.bold}Everything is updated{paint.reset}"


class Panel:
    """The steps beside the art: what's done, what's running and what's next."""

    def __init__(self, session, paint, motion):
        self.session, self.paint, self.motion = session, paint, motion
        self.t0 = time.monotonic()

    def lines(self, w, now, budget=None, final=False):
        s, p = self.session, self.paint
        out = [""]
        if final:
            out += [headline(s, p), f"{p.dim}Took {clock((s.ended or now) - s.started)}{p.reset}"]
        else:
            out.append(f"{p.bold}Updating Monolith{p.reset}")
            sub = "Looking for things to update" if s.phase == "find" else s.subtitle
            out.append(f"{p.dim}{fit(sub, w)}{p.reset}")
        out.append("")
        progress = 1.0 if final and not (s.stop or s.abort) else s.progress(now)
        done = sum(1 for step in s.found if step.state == "done")
        count = f"{done} of {len(s.found)} {SYM['dot']} {clock((s.ended or now) - s.started)}"
        size = max(8, min(30, w - 7 - width(count)))
        out.append(clip(f"{progress_bar(progress, size, p)} {p.bold}{int(progress * 100):3d}%{p.reset}  "
                        f"{p.dim}{count}{p.reset}", w))
        out.append("")
        room = None if budget is None else max(0, budget - len(out))
        return out + self.steps(w, now, room, final)

    def name_width(self):
        return max([10] + [min(15, width(s.title)) + 2 for s in self.session.found])

    def block(self, step, w, now, final):
        p, namew = self.paint, self.name_width()
        body = max(4, w - 4 - namew - 6)
        title = fit(step.title, namew - 2)
        if step.state == "done":
            r = step.result
            text = fit(r.text, body)
            if r.kind in (OK, STOPPED, NOT_RUN):
                text = p.dim + text + p.reset
            took = clock(step.ended - step.started) if step.started and step.ended else ""
            head = pad(f"{mark(r.kind, p)}   {pad(title, namew)}{text}", w - 6) + f"{p.dim}{took:>6}{p.reset}"
            return [head] + [f"    {p.dim}{SYM['sub']} {fit(more, w - 6)}{p.reset}" for more in r.more]
        if step.state == "running":
            spin = spinner(now - self.t0, self.motion and not final)
            lines = [f"{p.accent}{spin}{p.reset} {p.bold}{pad(title, namew)}{p.reset}{fit(step.detail, body + 6)}"]
            if step.sub and not final:
                lines.append(f"    {p.dim}{SYM['sub']} {fit(step.sub, w - 6)}{p.reset}")
            return lines
        return [f"{p.dim}{SYM['wait']}   {title}{p.reset}"]

    def steps(self, w, now, room, final):
        found, p = self.session.found, self.paint
        blocks = [self.block(step, w, now, final) for step in found]
        if room is None or sum(map(len, blocks)) <= room:
            return [line for block in blocks for line in block]
        # Short on room: drop the notes under finished steps first...
        blocks = [b[:1] if step.state == "done" else b for step, b in zip(found, blocks)]
        if sum(map(len, blocks)) <= room:
            return [line for block in blocks for line in block]
        # ...then show the steps around the one running and count the rest.
        n = len(blocks)
        focus = next((i for i, step in enumerate(found) if step.state != "done"), n - 1)
        lo, hi, used = focus, focus + 1, len(blocks[focus])

        def fits(lo, hi, used):
            return used + (lo > 0) + (hi < n) <= room

        grew = True
        while grew:
            grew = False
            if hi < n and fits(lo, hi + 1, used + len(blocks[hi])):
                used, hi, grew = used + len(blocks[hi]), hi + 1, True
            if lo > 0 and fits(lo - 1, hi, used + len(blocks[lo - 1])):
                lo, grew = lo - 1, True
                used += len(blocks[lo])
        lines = [f"{p.dim}{SYM['more']} {lo} more done{p.reset}"] if lo else []
        for block in blocks[lo:hi]:
            lines += block
        if hi < n:
            lines.append(f"{p.dim}{SYM['more']} {n - hi} more to go{p.reset}")
        return lines[:room]


class Screen:
    """The live view on the alternate screen, redrawn in place."""

    LAYOUTS = (("large", 92, 60), ("medium", 68, 60), (None, 0, 72))

    def __init__(self, look, paint, session):
        self.look, self.paint, self.session = look, paint, session
        self.panel = Panel(session, paint, look.motion)
        self.t0 = time.monotonic()
        self.scenes = {}
        self.last, self.dirty, self.resized = 0.0, True, False
        self.active, self.broken, self.saved_tty = False, False, None
        self.celebrate = False

    def scene(self, size):
        if size not in self.scenes:
            try:
                self.scenes[size] = Scene(size)
            except (OSError, ValueError):
                self.scenes[size] = None
        return self.scenes[size]

    def footer(self, w, final):
        s, p = self.session, self.paint

        def first_fitting(*texts):
            return next((text for text in texts if width(text) <= w), "")

        if final:
            lines = []
            if s.restart_to:
                # A cut-off link is no use, so it only shows when it fits.
                lines.append(first_fitting(f"Release notes: {RELEASE_NOTES}", RELEASE_NOTES))
            if any(step.result and step.result.kind == FAIL for step in s.found):
                lines.append(first_fitting(f"What went wrong is in {tilde(s.log.path)}", tilde(s.log.path)))
            return [f"{p.dim}{line}{p.reset}" for line in lines if line]
        if s.stop or s.abort:
            text = first_fitting(f"Stopping after this step {SYM['dot']} Ctrl+C again stops now",
                                 "Stopping after this step")
            return [clip(f"{p.warn}{text}{p.reset}", w)]
        text = first_fitting(f"Ctrl+C stops after this step {SYM['dot']} Log: {tilde(LOG_DIR / 'latest.log')}",
                             "Ctrl+C stops after this step", "Ctrl+C stops")
        return [f"{p.dim}{text}{p.reset}"]

    def compose(self, cols, rows, now, final=False):
        s = self.session
        motion = self.look.motion and not final
        t = now - self.t0 if motion else 0.0
        rise = smooth(t / 1.2) if motion else 1.0
        progress = 1.0 if final and not (s.stop or s.abort) else s.progress(now)
        flare = None
        if motion and self.celebrate and s.ended:
            flare = (now - s.ended) / FLARE
            flare = flare if flare < 1 else None
        w = max(10, cols - 1)
        for size, least, widest in self.LAYOUTS:
            scene = self.scene(size) if size else None
            if size and (scene is None or w < least):
                continue
            art_w = scene.cols + 2 if scene else 0
            panel_w = min(widest, w - 1 - art_w)
            footer = self.footer(w - 1, final)
            budget = None if final else rows - 2 - len(footer)
            if scene and budget is not None and scene.rows > budget:
                continue
            break
        panel = self.panel.lines(panel_w, now, budget, final)
        art = scene.frame(t, rise, progress, flare) if scene else []
        height = max(len(art), len(panel))
        # The mark sits beside the title, as in monolith help.
        art = art + [" " * scene.cols] * (height - len(art)) if scene else [""] * height
        panel += [""] * (height - len(panel))
        gap = "  " if scene else ""
        lines = [""] + [clip(f" {a}{gap}{b}", w) for a, b in zip(art, panel)] + [""]
        lines += [clip(" " + line, w) for line in footer]
        return lines if final else lines[:rows]

    def write(self, text):
        if self.broken:
            return
        try:
            sys.stdout.buffer.write(text.encode("utf-8", "replace"))
            sys.stdout.buffer.flush()
        except OSError:
            self.broken = True

    def start(self):
        if sys.stdin.isatty():
            try:
                self.saved_tty = termios.tcgetattr(0)
                quiet = termios.tcgetattr(0)
                quiet[3] &= ~termios.ECHO
                termios.tcsetattr(0, termios.TCSANOW, quiet)
            except termios.error:
                self.saved_tty = None
        self.write("\x1b[?1049h\x1b[?25l\x1b[2J")
        self.active = True
        self.draw()

    def close(self):
        if not self.active:
            return
        self.active = False
        self.write("\x1b[?2026l\x1b[0m\x1b[?25h\x1b[?1049l")
        if self.saved_tty is not None:
            try:
                termios.tcsetattr(0, termios.TCSADRAIN, self.saved_tty)
            except termios.error:
                pass

    def suspend(self):
        """Ctrl+Z: give the terminal back as it was."""
        was = self.active
        self.close()
        self.active_before_suspend = was

    def resume(self):
        if getattr(self, "active_before_suspend", False):
            self.resized = True
            self.start()

    def tick(self, force=False):
        if not self.active:
            return
        now = time.monotonic()
        interval = 1 / FPS if self.look.motion else 1.0
        if force or now - self.last >= interval or (self.dirty and now - self.last >= 1 / 30):
            self.draw(now)

    def draw(self, now=None):
        now = now or time.monotonic()
        cols, rows = terminal_size()
        lines = self.compose(cols, rows, now)
        out = ["\x1b[?2026h"]
        if self.resized:
            out.append("\x1b[2J")
            self.resized = False
        for i, line in enumerate(lines):
            out.append(f"\x1b[{i + 1};1H{line}\x1b[K")
        if len(lines) < rows:
            out.append(f"\x1b[{len(lines) + 1};1H\x1b[J")
        out.append("\x1b[?2026l")
        self.write("".join(out))
        self.last, self.dirty = now, False

    def found(self, step):
        self.dirty = True

    def begin(self, step):
        self.dirty = True

    def end(self, step):
        self.dirty = True

    def notice(self, text):
        self.dirty = True

    def finish(self):
        """The sunburst, then the summary on the normal screen."""
        s = self.session
        self.celebrate = (self.look.motion and not (s.stop or s.abort or s.signal)
                          and not any(st.result and st.result.kind == FAIL for st in s.found))
        if self.celebrate and self.active:
            until = time.monotonic() + FLARE + 0.3
            while time.monotonic() < until and not (s.abort or s.signal):
                time.sleep(1 / FPS)
                self.tick()
        self.close()
        if self.broken:
            return
        cols, rows = terminal_size()
        self.write("\n".join(self.compose(cols, rows, time.monotonic(), final=True)) + "\n")


class Lines:
    """Plain output, one line per finished step, for pipes and simple terminals."""

    def __init__(self, look, paint, session):
        self.look, self.paint, self.session = look, paint, session
        self.status = look.tty and (os.environ.get("TERM") or "dumb") != "dumb"
        self.last, self.shown = 0.0, False

    def say(self, text="", stream=None):
        self.clear()
        try:
            print(text, file=stream or sys.stdout, flush=True)
        except OSError:
            pass

    def clear(self):
        if self.shown:
            sys.stdout.write("\r\x1b[K")
            self.shown = False

    def start(self):
        s = self.session
        self.say(f"{self.paint.bold}Updating Monolith{self.paint.reset}" + (f" ({s.subtitle})" if s.subtitle else ""))

    def found(self, step):
        pass

    def begin(self, step):
        self.tick(force=True)

    def tick(self, force=False):
        step = self.session.step
        now = time.monotonic()
        if not self.status or not step or step.state != "running" or (not force and now - self.last < 0.25):
            return
        cols, _rows = terminal_size()
        detail = step.sub or step.detail
        text = f"{step.title}{': ' + detail if detail else ''}"
        try:
            sys.stdout.write("\r\x1b[K" + clip(f"{self.paint.dim}{text}{self.paint.reset}", cols - 1))
            sys.stdout.flush()
        except OSError:
            self.status = False
        self.shown, self.last = True, now

    def end(self, step):
        r, p = step.result, self.paint
        namew = max([10] + [min(15, width(s.title)) + 2 for s in self.session.found])
        took = f"  ({clock(step.ended - step.started)})" if step.started and step.ended else ""
        self.say(f"{mark(r.kind, p)} {pad(step.title, namew)}{r.text}{p.dim}{took}{p.reset}")
        for more in r.more:
            self.say(f"  {' ' * namew}{p.dim}{more}{p.reset}")

    def notice(self, text):
        self.say(text, sys.stderr)

    def close(self):
        self.clear()

    def finish(self):
        s, p = self.session, self.paint
        self.close()
        self.say()
        self.say(f"{headline(s, p)}{p.dim} {SYM['dot']} took {clock((s.ended or time.monotonic()) - s.started)}{p.reset}")
        if s.restart_to:
            self.say(f"{s.restart_to} is ready. Restart to use it.")
            self.say(f"{p.dim}Release notes: {RELEASE_NOTES}{p.reset}")
        if any(step.result and step.result.kind == FAIL for step in s.found):
            self.say(f"{p.dim}What went wrong is in {s.log.path}{p.reset}")


def ask_restart(version, paint, margin=""):
    """MARGIN lines the question up with the summary above it."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    try:
        termios.tcflush(0, termios.TCIFLUSH)
    except termios.error:
        pass
    question = f"Restart now to use {version}?"
    if len(margin) + width(question) + 7 > terminal_size()[0] - 1:
        question = "Restart now?"
    try:
        answer = input(f"\n{margin}{question} {paint.dim}[y/N]{paint.reset} ")
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer.strip().lower() in ("y", "yes")


# --- the command --------------------------------------------------------------------------

def parse_args(argv):
    opts = dict(help=False, list=False, steps=False, only=[], skip=[])
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            opts["help"] = True
        elif arg == "--list":
            opts["list"] = True
        elif arg == "__steps":
            opts["steps"] = True
        elif arg.split("=", 1)[0] in ("--only", "--skip"):
            key, sep, value = arg.partition("=")
            if not sep:
                i += 1
                if i == len(argv):
                    raise Usage(f"{key} needs step names, such as {key} flatpak,distrobox")
                value = argv[i]
            opts[key[2:]] += [name.strip() for name in value.split(",") if name.strip()]
        elif arg.startswith("-"):
            raise Usage(f"monolith update doesn't have an option called {arg}. See: monolith update --help")
        else:
            raise Usage(f"To update only some apps, run: monolith update {shlex.join(argv[i:])}")
        i += 1
    return opts


def show_list(steps, left_out, session, paint):
    here = [step for step in steps if step.ready(session)]
    missing = [step for step in steps if step not in here]
    if here:
        print("monolith update runs these steps here, in this order:")
        idw = max(width(step.id) for step in here) + 2
        titlew = max(width(step.title) for step in here) + 2
        for step in here:
            print(f"  {paint.bold}{pad(step.id, idw)}{paint.reset}{pad(step.title, titlew)}{paint.dim}{step.commands()}{paint.reset}")
    else:
        print("Nothing here needs monolith update.")
    if missing:
        print(f"\nNot installed here: {', '.join(step.id for step in missing)}")
    if left_out:
        print(f"Left out: {', '.join(step.id for step in left_out)}")
    return 0


def main(argv):
    try:
        opts = parse_args(argv)
        if opts["help"]:
            print(HELP)
            return 0
        config_skip, commands = load_config()
        steps = all_steps(commands)
        if opts["steps"]:
            for step in steps:
                print(f"{step.id}\t{step.title}")
            return 0
        chosen, left_out, warnings = select(steps, opts["only"], opts["skip"], config_skip)
    except Usage as problem:
        print(problem, file=sys.stderr)
        return 2

    look = Look(sys.stdout)
    if not look.unicode:
        SYM.update(ASCII_SYMBOLS)
    paint = Paint(look.color)
    for warning in warnings:
        print(warning, file=sys.stderr)
    if opts["list"]:
        return show_list(chosen, left_out, Session(Log(None)), paint)

    log = open_log()
    session = Session(log)
    cols, rows = terminal_size()
    ui = Screen(look, paint, session) if look.live and cols >= 30 and rows >= 9 else Lines(look, paint, session)
    session.ui = ui
    log.write(f"monolith update, {time.strftime('%Y-%m-%d %H:%M:%S %Z')}\n")

    def interrupted(_signum, _frame):
        if session.stop:
            session.abort = True
            ui.notice("Stopping now.")
        else:
            session.stop = True
            ui.notice("Stopping after this step. Press Ctrl+C again to stop now.")

    def ended(signum, _frame):
        session.signal = signum
        session.stop = session.abort = True

    def suspended(_signum, _frame):
        if isinstance(ui, Screen):
            ui.suspend()
        signal.signal(signal.SIGTSTP, signal.SIG_DFL)
        os.kill(os.getpid(), signal.SIGTSTP)

    def continued(_signum, _frame):
        signal.signal(signal.SIGTSTP, suspended)
        if isinstance(ui, Screen):
            ui.resume()

    signal.signal(signal.SIGINT, interrupted)
    signal.signal(signal.SIGTERM, ended)
    signal.signal(signal.SIGHUP, ended)
    if isinstance(ui, Screen):
        signal.signal(signal.SIGWINCH, lambda *_: setattr(ui, "resized", True))
        signal.signal(signal.SIGTSTP, suspended)
        signal.signal(signal.SIGCONT, continued)

    try:
        ui.start()
        for step in chosen:
            if session.abort:
                break
            try:
                ready = step.ready(session)
            except Exception:  # A broken check must not stop the update.
                log.write(traceback.format_exc())
                ready = False
            if ready:
                session.found.append(step)
                ui.found(step)
        session.phase = "run"
        if not session.found:
            ui.close()
            print("Nothing here needs monolith update.")
            return 0
        for step in session.found:
            if session.stop or session.abort:
                step.state, step.result = "done", Result(NOT_RUN, "Not run")
                continue
            log.write(f"\n== {step.title} ==\n")
            session.step, step.state, step.started = step, "running", time.monotonic()
            ui.begin(step)
            aborted_before = session.abort
            try:
                result = step.run(session)
            except Exception:
                log.write(traceback.format_exc())
                result = Result(FAIL, "Something unexpected went wrong")
            if session.abort and not aborted_before and result.kind != OK:
                result = Result(STOPPED, "Stopped")
            step.result, step.state, step.ended = result, "done", time.monotonic()
            log.write(f"-> {result.kind}: {result.text}\n")
            for more in result.more:
                log.write(f"   {more}\n")
            log.flush()
            ui.end(step)
        session.step, session.phase, session.ended = None, "done", time.monotonic()
        ui.finish()
    finally:
        ui.close()
        log.close()

    finished = not (session.stop or session.abort or session.signal)
    if finished and not opts["only"]:
        try:
            RECORD.parent.mkdir(parents=True, exist_ok=True)
            RECORD.touch()
        except OSError:
            pass
    if session.signal:
        return 128 + session.signal
    # Ctrl+C at the question just means no. A run that was stopped doesn't ask.
    signal.signal(signal.SIGINT, signal.default_int_handler)
    margin = " " if isinstance(ui, Screen) else ""
    if finished and session.restart_to and ask_restart(session.restart_to, paint, margin):
        os.execvp("systemctl", ["systemctl", "reboot"])
    if not finished:
        return 130
    return 1 if any(step.result and step.result.kind == FAIL for step in session.found) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
