class Tool(Step):
    """A developer tool that updates with one or two commands of its own."""

    def __init__(self, id, title, find, changes=(), current=()):
        super().__init__()
        self.id, self.title, self._find = id, title, find
        self.changes = [(re.compile(pattern), form) for pattern, form in changes]
        self.current = [re.compile(pattern, re.I) for pattern in current]
        self.argvs = []

    def ready(self, session):
        self.argvs = self._find(session) or []
        return bool(self.argvs)

    def commands(self):
        return ", then ".join(shlex.join(argv) for argv in self.argvs)

    def run(self, session):
        seen = []
        for n, argv in enumerate(self.argvs):
            self.detail, self.fraction = shlex.join(argv), n / len(self.argvs)
            code, lines = session.run(argv)
            seen += lines
            if code != 0:
                return Result(FAIL, last_error(lines) or f"exit {code}")
            if session.abort:
                return Result(STOPPED, "Stopped")
        found = []
        for line in seen:
            for pattern, form in self.changes:
                if match := pattern.search(line):
                    found.append(form.format(*match.groups(), to=SYM["to"]))
                    break
        if found:
            return Result(OK, ", ".join(dict.fromkeys(found)))
        if any(pattern.search(line) for pattern in self.current for line in seen):
            return Result(OK, "Up to date")
        return Result(OK, "Done")


def npm_globals(session):
