#!/usr/bin/bash
# monolith boot-menu [on|off]: Monolith's look for the boot menu, the list of
# builds GRUB shows when the computer starts.
#
# The look is a GRUB theme that comes with the image, in
# /usr/share/monolith/grub. GRUB reads themes from /boot, and /boot isn't part
# of the image, so monolith-boot-menu.service runs "boot-menu sync" each time
# the computer starts. It writes two things, and only when they differ from
# what this build has:
#   /boot/grub2/themes/monolith  the theme, with the entries' text moved in
#                                so the longest one sits in the middle
#   /boot/grub2/user.cfg         the settings that turn the theme on, as a
#                                marked block. Lines outside the block, such
#                                as a GRUB password, stay as they are.
# A new look therefore shows from the second start after the update that
# brought it. "off" takes both away and leaves a note in /var/lib/monolith,
# which keeps sync from putting them back.
#
# Going back to an older build doesn't change /boot, so it can't undo a boot
# menu that looks wrong. "monolith boot-menu off" does.
#
# On a screen that is 1800 pixels tall or more the menu is drawn at twice the
# size. GRUB can't say what screen it has, so sync works it out afterwards:
# GRUB hands the kernel the screen it showed its menu on, and the kernel
# keeps that size. What sync learns goes into /var/lib/monolith/boot-menu-screen:
#   native  the size GRUB has when it takes the screen as the firmware left it
#   half    yes or no: did the firmware set half that size when GRUB asked?
# Half the size is only asked for while Secure Boot is on, because GRUB can't
# load a larger font then. user.cfg says what GRUB does in each case.
set -euo pipefail

# No common.sh here: it is written for a person at a terminal and needs HOME,
# which a service started by systemd doesn't have.
die() {
    printf '%s\n' "$*" >&2
    exit 1
}

# Tests point these at stand-ins for /boot, /usr/share, /var/lib/monolith,
# /run and /sys.
boot="${MONOLITH_BOOT:-/boot}"
vendor="${MONOLITH_VENDOR:-/usr/share}"
state="${MONOLITH_STATE:-/var/lib/monolith}"
run="${MONOLITH_RUN:-/run}"
sys="${MONOLITH_SYS:-/sys}"
grub="$boot/grub2"
shipped="$vendor/monolith/grub"
note="$state/boot-menu-off"
screen="$state/boot-menu-screen"
# Gone at every start, like the rest of /run: sync looks at what GRUB did once a start.
seen="$run/monolith-boot-menu-seen"
self="$(readlink -f -- "${BASH_SOURCE[0]}")"
# These two lines mark Monolith's part of user.cfg. Never change them: sync
# finds the block an older build wrote by them.
begin="### BEGIN Monolith boot menu ###"
end="### END Monolith boot menu ###"
# From theme.txt and select_w.png: the highlight's width and the width of its
# two ends. GRUB's font is 8 pixels a letter.
menu_width=560
end_width=16
# A screen at least this many pixels tall gets the menu at twice the size.
tall=1800
# What is known of the screen (read_state, learn) and what follows from it (plan).
native="" half="" scale=1 ask=""

usage() {
    cat <<'EOF'
Usage: monolith boot-menu [on|off]

  monolith boot-menu      say whether Monolith's look is on
  monolith boot-menu on   the logo, centred entries, five seconds to choose
  monolith boot-menu off  GRUB's plain list, shown for one second

The boot menu is the list of builds shown when the computer starts. A change
shows from the next start, and takes your password once.
EOF
}

work=""
trap '[[ -z $work ]] || rm -rf -- "$work"' EXIT

# text_offset: how far to move the entries' text in, so the longest title sits
# in the middle of the highlight. GRUB starts every entry at the same place.
text_offset() {
    local longest=22 file title offset # "UEFI Firmware Settings", which is always there
    for file in "$boot"/loader/entries/*.conf; do
        [[ -r $file ]] || continue
        title="$(awk '$1 == "title" { sub(/^title[ \t]+/, ""); print; exit }' "$file")"
        if ((${#title} > longest)); then longest=${#title}; fi
    done
    offset=$(((menu_width - 2 * end_width - 8 * longest) / 2))
    if ((offset < 0)); then offset=0; fi
    printf '%s\n' "$offset"
}

# set_offset FILE PIXELS: put the text offset into one of the theme's files.
set_offset() {
    sed -i -E "s/^([[:space:]]*item_icon_space[[:space:]]*=[[:space:]]*)[0-9]+[[:space:]]*$/\\1$2/" "$1"
}

# kernel_screen: the size of the screen GRUB handed to the kernel, such as
# 3840x2160. GRUB keeps the screen its menu was on (gfxpayload=keep), so this
# is the size the menu had at this start. It is in the kernel's boot
# parameters: byte 15 says what kind of screen (112 from UEFI firmware, 35
# from a BIOS), bytes 18 to 21 hold its width and height. Prints nothing when
# the kernel got no such screen, or when the file can't be read.
kernel_screen() {
    local data="$sys/kernel/boot_params/data" kind width height
    [[ -r $data ]] || return 0
    kind="$(od -An -tu1 -j15 -N1 -- "$data" 2>/dev/null | tr -d ' \n')"
    width="$(od -An -tu2 -j18 -N2 -- "$data" 2>/dev/null | tr -d ' \n')"
    height="$(od -An -tu2 -j20 -N2 -- "$data" 2>/dev/null | tr -d ' \n')"
    [[ $kind == 112 || $kind == 35 ]] || return 0
    [[ $width =~ ^[1-9][0-9]*$ && $height =~ ^[1-9][0-9]*$ ]] || return 0
    printf '%sx%s\n' "$width" "$height"
}

# efi_value FILE: the first byte of an EFI variable, which follows its four
# bytes of attributes. Prints nothing when the variable isn't there.
efi_value() {
    [[ -r $1 ]] || return 0
    od -An -tu1 -j4 -N1 -- "$1" 2>/dev/null | tr -d ' \n'
}

# locked_down: is Secure Boot on, as GRUB sees it? The firmware says so, it
# isn't in setup mode, and shim's own switch (mokutil --disable-validation)
# isn't off. This follows grub_efi_get_secureboot in GRUB's kern/efi/sb.c,
# which also takes a firmware that doesn't answer for Secure Boot being off.
locked_down() {
    local vars="$sys/firmware/efi/efivars" secure setup
    secure="$(efi_value "$vars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c")"
    setup="$(efi_value "$vars/SetupMode-8be4df61-93ca-11d2-aa0d-00e098032b8c")"
    [[ -n $secure && -n $setup ]] || return 1
    [[ $secure != 0 && $setup != 1 ]] || return 1
    [[ $(efi_value "$vars/MokSBStateRT-605dab50-e046-4300-abb6-3dd810dd8b23") != 1 ]] || return 1
}

# asked_mode: the half size the block on /boot told GRUB to ask for, if any.
asked_mode() {
    [[ -f $grub/user.cfg ]] || return 0
    awk -v b="$begin" -v e="$end" '
        $0 == b { inside = 1; next }
        $0 == e { inside = 0; next }
        inside && /^set monolith_half=[1-9][0-9]*x[1-9][0-9]*$/ { sub(/^set monolith_half=/, ""); print; exit }' "$grub/user.cfg"
}

read_state() {
    native="" half=""
    [[ -r $screen ]] || return 0
    native="$(sed -n -E 's/^native=([1-9][0-9]*x[1-9][0-9]*)$/\1/p' "$screen" | head -n 1)"
    half="$(sed -n -E 's/^half=(yes|no)$/\1/p' "$screen" | head -n 1)"
}

write_state() {
    install -d -m 0755 -- "$state"
    printf '%s\n' "# What boot-menu has seen of this computer's screen. See $self." \
        "native=$native" "half=$half" >"$screen.new"
    mv -f -- "$screen.new" "$screen"
}

# learn: once a start, take note of the screen GRUB had at it.
#   - GRUB took the screen as the firmware left it: that size is the native one.
#   - GRUB was asked for half the native size (Secure Boot is on and the block
#     on /boot says so) and had it: the firmware has that mode.
#   - It was asked and still had the native size: the firmware has no such
#     mode, so it isn't asked for again.
#   - It had some other size: the screen is another one now.
# A second sync in the same start must not do this again: by then the block
# on /boot may be a new one, which GRUB hasn't read yet.
#
# While GRUB runs at the half it asked for, a screen swapped for a smaller
# one whose firmware has that mode too goes unnoticed. The menu then stays at
# that size, which fits such a screen. Turning the look off, restarting and
# turning it on again measures the screen anew.
learn() {
    local ran asked before="$native $half"
    [[ ! -e $seen ]] || return 0
    : 2>/dev/null >"$seen" || return 0
    ran="$(kernel_screen)"
    [[ -n $ran ]] || return 0
    asked="$(asked_mode)"
    if [[ -n $asked ]] && locked_down; then
        if [[ $ran == "$asked" ]]; then
            native="$((2 * ${asked%x*}))x$((2 * ${asked#*x}))" half=yes
        elif [[ $ran == "$native" ]]; then
            half=no
        else
            native="$ran" half=""
        fi
    elif [[ $ran != "$native" ]]; then
        native="$ran" half=""
    fi
    [[ "$native $half" == "$before" ]] || write_state
}

# plan: from the native size, the scale of the menu and the half size to ask
# for under Secure Boot (none once the firmware turned out not to have it).
plan() {
    scale=1 ask=""
    [[ $native =~ ^([0-9]+)x([0-9]+)$ ]] || return 0
    local width=$((10#${BASH_REMATCH[1]})) height=$((10#${BASH_REMATCH[2]}))
    ((height >= tall)) || return 0
    scale=2
    if [[ $half != no ]] && ((width % 2 == 0 && height % 2 == 0)); then
        ask="$((width / 2))x$((height / 2))"
    fi
}

# rest_of_user_cfg: user.cfg without Monolith's block. A password line is kept
# even when it sits inside a block whose end went missing.
rest_of_user_cfg() {
    [[ -f $grub/user.cfg ]] || return 0
    awk -v b="$begin" -v e="$end" '
        $0 == b { inside = 1; next }
        $0 == e { inside = 0; next }
        !inside || /^GRUB2_PASSWORD=/' "$grub/user.cfg"
}

# make_writable: /boot can be mounted read-only. Make it writable for this
# script alone, in a mount namespace of its own, as ostree does for its writes.
make_writable() {
    [[ ! -w $grub ]] || return 0
    ((EUID == 0)) || die "Changing the boot menu needs root. Use: monolith boot-menu on (or off)"
    if [[ -z ${MONOLITH_BOOT_MENU_UNSHARED-} ]]; then
        rm -rf -- "$work"
        work=""
        export MONOLITH_BOOT_MENU_UNSHARED=1
        exec unshare --mount --propagation private -- "$self" sync
    fi
    mount -o remount,rw "$(findmnt -n -o TARGET --target "$grub")"
    [[ -w $grub ]] || die "Couldn't make $grub writable, so the boot menu wasn't changed."
}

# put_user_cfg: swap the new user.cfg in once it is on the disk, so a power
# cut leaves the old file or the new one, never an empty one. 0600 like
# bootupd's grub.cfg: the file can hold a password hash.
put_user_cfg() {
    install -m 0600 -- "$work/user.cfg" "$grub/user.cfg.monolith-new"
    sync -- "$grub/user.cfg.monolith-new"
    mv -f -- "$grub/user.cfg.monolith-new" "$grub/user.cfg"
}

# sync: make /boot match this build's look, or take the look away when it is
# turned off. Says in one line what it did. "sync retry" also asks the
# firmware once more for a half size it didn't have.
sync_menu() {
    local want_on=1 theme_differs=0 cfg_differs=0 themes="$grub/themes" offset theme
    [[ ! -e $note ]] || want_on=0
    # /boot/grub2 is root's alone, so without root it only looks empty.
    [[ ! -e $grub || -r $grub ]] || die "Reading $grub needs root. Use: monolith boot-menu on (or off)"
    if [[ ! -f $grub/grub.cfg ]]; then
        echo "There is no $grub/grub.cfg, so there is no boot menu to change."
        return 0
    fi
    read_state
    learn
    if [[ ${1-} == retry && $half == no ]]; then
        half=""
        write_state
    fi
    if ((want_on)); then
        for theme in theme.txt theme-2x.txt theme-2x-logo.txt; do
            [[ -f $shipped/themes/monolith/$theme ]] ||
                die "This build has no boot menu look in $shipped, so nothing was changed."
        done
        [[ -f $shipped/user.cfg ]] ||
            die "This build has no boot menu look in $shipped, so nothing was changed."
        if ! grep -q 'user\.cfg' "$grub/grub.cfg"; then
            echo "$grub/grub.cfg doesn't read user.cfg, so Monolith's look can't be turned on here."
            return 0
        fi
    fi

    # What should be there.
    work="$(mktemp -d)"
    rest_of_user_cfg >"$work/user.cfg"
    if ((want_on)); then
        mkdir "$work/theme"
        cp -- "$shipped"/themes/monolith/* "$work/theme/"
        # A letter is twice as wide in theme-2x.txt, and so is everything else.
        offset="$(text_offset)"
        set_offset "$work/theme/theme.txt" "$offset"
        set_offset "$work/theme/theme-2x-logo.txt" "$offset"
        set_offset "$work/theme/theme-2x.txt" "$((2 * offset))"
        plan
        {
            printf '%s\n' "$begin"
            if ((scale == 2)); then
                printf 'set monolith_scale=2\n'
                [[ -z $ask ]] || printf 'set monolith_half=%s\n' "$ask"
            fi
            cat -- "$shipped/user.cfg"
            printf '%s\n' "$end"
        } >>"$work/user.cfg"
        diff -rq -- "$work/theme" "$themes/monolith" >/dev/null 2>&1 || theme_differs=1
    elif [[ -e $themes/monolith ]]; then
        theme_differs=1
    fi
    if [[ -e $grub/user.cfg ]]; then
        cmp -s -- "$work/user.cfg" "$grub/user.cfg" || cfg_differs=1
    elif [[ -s $work/user.cfg ]]; then
        cfg_differs=1
    fi
    if ((!theme_differs && !cfg_differs)); then
        if ((want_on)); then
            echo "Monolith's boot menu look is on /boot already."
        else
            echo "Monolith's boot menu look is off already."
        fi
        return 0
    fi

    make_writable
    if ((want_on)); then
        # The theme first: the block must never name a theme that isn't there.
        if ((theme_differs)); then
            rm -rf -- "$themes/.monolith.new" "$themes/.monolith.old"
            install -d -m 0755 -- "$themes" "$themes/.monolith.new"
            install -m 0644 -- "$work/theme"/* "$themes/.monolith.new/"
            # On the disk before it takes the old theme's place, so a power
            # cut never leaves half a theme under the name GRUB reads.
            sync -f -- "$themes/.monolith.new"
            [[ ! -e $themes/monolith ]] || mv -- "$themes/monolith" "$themes/.monolith.old"
            mv -- "$themes/.monolith.new" "$themes/monolith"
            rm -rf -- "$themes/.monolith.old"
        fi
        if ((cfg_differs)); then put_user_cfg; fi
        sync -f "$grub" 2>/dev/null || sync
        echo "Monolith's boot menu look is on /boot. It shows the next time the computer starts."
    else
        # The block first, for the same reason.
        if ((cfg_differs)); then
            if [[ -s $work/user.cfg ]]; then
                put_user_cfg
            else
                rm -f -- "$grub/user.cfg"
            fi
        fi
        rm -rf -- "$themes/monolith" "$themes/.monolith.new" "$themes/.monolith.old"
        rmdir -- "$themes" 2>/dev/null || true
        sync -f "$grub" 2>/dev/null || sync
        echo "Monolith's boot menu look is off /boot. GRUB shows its plain list again, for one second."
    fi
}

case "${1-}" in
    "")
        if [[ -e $note ]]; then
            echo "Monolith's boot menu look is off. Turn it on with: monolith boot-menu on"
        else
            echo "Monolith's boot menu look is on. Turn it off with: monolith boot-menu off"
            read_state
            plan
            if ((scale == 1)); then
                :
            elif ! locked_down; then
                echo "This computer's screen is $native, so the menu is drawn at twice the size."
            elif [[ -n $ask ]]; then
                echo "This computer's screen is $native. Secure Boot is on, so GRUB shows the menu"
                echo "at $ask and the screen scales it up."
            else
                echo "This computer's screen is $native. Secure Boot is on and the firmware has no"
                echo "mode of half that size, so only the logo is drawn at twice the size."
            fi
        fi
        ;;
    on)
        (($# == 1)) || { usage >&2; exit 2; }
        sudo rm -f -- "$note"
        sudo "$self" sync retry
        ;;
    off)
        (($# == 1)) || { usage >&2; exit 2; }
        sudo install -D -m 0644 /dev/null "$note"
        sudo "$self" sync
        ;;
    sync)
        (($# == 1)) || [[ $# == 2 && $2 == retry ]] || { usage >&2; exit 2; }
        sync_menu "${2-}"
        ;;
    -h | --help | help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
