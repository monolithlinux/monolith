#!/usr/bin/bash
# monolith boot-menu [on|off]: Monolith's look for the boot menu, the list of
# builds GRUB shows when the computer starts.
#
# The look is a GRUB theme that comes with the image, in
# /usr/share/monolith/grub. GRUB reads themes from /boot, and /boot isn't part
# of the image, so monolith-boot-menu.service runs "boot-menu sync" each time
# the computer starts. It writes two things, and only when they differ from
# what this build has:
#   /boot/grub2/themes/monolith  the theme, with the entries' text moved in
#                                so the longest one sits in the middle
#   /boot/grub2/user.cfg         the settings that turn the theme on, as a
#                                marked block. Lines outside the block, such
#                                as a GRUB password, stay as they are.
# A new look therefore shows from the second start after the update that
# brought it. "off" takes both away and leaves a note in /var/lib/monolith,
# which keeps sync from putting them back.
#
# Going back to an older build doesn't change /boot, so it can't undo a boot
# menu that looks wrong. "monolith boot-menu off" does.
set -euo pipefail

# No common.sh here: it is written for a person at a terminal and needs HOME,
# which a service started by systemd doesn't have.
die() {
    printf '%s\n' "$*" >&2
    exit 1
}

# Tests point these at stand-ins for /boot, /usr/share and /var/lib/monolith.
boot="${MONOLITH_BOOT:-/boot}"
vendor="${MONOLITH_VENDOR:-/usr/share}"
state="${MONOLITH_STATE:-/var/lib/monolith}"
grub="$boot/grub2"
shipped="$vendor/monolith/grub"
note="$state/boot-menu-off"
self="$(readlink -f -- "${BASH_SOURCE[0]}")"
# These two lines mark Monolith's part of user.cfg. Never change them: sync
# finds the block an older build wrote by them.
begin="### BEGIN Monolith boot menu ###"
end="### END Monolith boot menu ###"
# From theme.txt and select_w.png: the highlight's width and the width of its
# two ends. GRUB's font is 8 pixels a letter.
menu_width=560
end_width=16

usage() {
    cat <<'EOF'
Usage: monolith boot-menu [on|off]

  monolith boot-menu      say whether Monolith's look is on
  monolith boot-menu on   the logo, centred entries, five seconds to choose
  monolith boot-menu off  GRUB's plain list, shown for one second

The boot menu is the list of builds shown when the computer starts. A change
shows from the next start, and takes your password once.
EOF
}

work=""
trap '[[ -z $work ]] || rm -rf -- "$work"' EXIT

# text_offset: how far to move the entries' text in, so the longest title sits
# in the middle of the highlight. GRUB starts every entry at the same place.
text_offset() {
    local longest=22 file title offset # "UEFI Firmware Settings", which is always there
    for file in "$boot"/loader/entries/*.conf; do
        [[ -r $file ]] || continue
        title="$(awk '$1 == "title" { sub(/^title[ \t]+/, ""); print; exit }' "$file")"
        if ((${#title} > longest)); then longest=${#title}; fi
    done
    offset=$(((menu_width - 2 * end_width - 8 * longest) / 2))
    if ((offset < 0)); then offset=0; fi
    printf '%s\n' "$offset"
}

# rest_of_user_cfg: user.cfg without Monolith's block. A password line is kept
# even when it sits inside a block whose end went missing.
rest_of_user_cfg() {
    [[ -f $grub/user.cfg ]] || return 0
    awk -v b="$begin" -v e="$end" '
        $0 == b { inside = 1; next }
        $0 == e { inside = 0; next }
        !inside || /^GRUB2_PASSWORD=/' "$grub/user.cfg"
}

# make_writable: /boot can be mounted read-only. Make it writable for this
# script alone, in a mount namespace of its own, as ostree does for its writes.
make_writable() {
    [[ ! -w $grub ]] || return 0
    ((EUID == 0)) || die "Changing the boot menu needs root. Use: monolith boot-menu on (or off)"
    if [[ -z ${MONOLITH_BOOT_MENU_UNSHARED-} ]]; then
        rm -rf -- "$work"
        work=""
        export MONOLITH_BOOT_MENU_UNSHARED=1
        exec unshare --mount --propagation private -- "$self" sync
    fi
    mount -o remount,rw "$(findmnt -n -o TARGET --target "$grub")"
    [[ -w $grub ]] || die "Couldn't make $grub writable, so the boot menu wasn't changed."
}

# put_user_cfg: swap the new user.cfg in once it is on the disk, so a power
# cut leaves the old file or the new one, never an empty one. 0600 like
# bootupd's grub.cfg: the file can hold a password hash.
put_user_cfg() {
    install -m 0600 -- "$work/user.cfg" "$grub/user.cfg.monolith-new"
    sync -- "$grub/user.cfg.monolith-new"
    mv -f -- "$grub/user.cfg.monolith-new" "$grub/user.cfg"
}

# sync: make /boot match this build's look, or take the look away when it is
# turned off. Says in one line what it did.
sync_menu() {
    local want_on=1 theme_differs=0 cfg_differs=0 themes="$grub/themes"
    [[ ! -e $note ]] || want_on=0
    # /boot/grub2 is root's alone, so without root it only looks empty.
    [[ ! -e $grub || -r $grub ]] || die "Reading $grub needs root. Use: monolith boot-menu on (or off)"
    if [[ ! -f $grub/grub.cfg ]]; then
        echo "There is no $grub/grub.cfg, so there is no boot menu to change."
        return 0
    fi
    if ((want_on)); then
        [[ -f $shipped/themes/monolith/theme.txt && -f $shipped/user.cfg ]] ||
            die "This build has no boot menu look in $shipped, so nothing was changed."
        if ! grep -q 'user\.cfg' "$grub/grub.cfg"; then
            echo "$grub/grub.cfg doesn't read user.cfg, so Monolith's look can't be turned on here."
            return 0
        fi
    fi

    # What should be there.
    work="$(mktemp -d)"
    rest_of_user_cfg >"$work/user.cfg"
    if ((want_on)); then
        mkdir "$work/theme"
        cp -- "$shipped"/themes/monolith/* "$work/theme/"
        sed -i -E "s/^([[:space:]]*item_icon_space[[:space:]]*=[[:space:]]*)[0-9]+[[:space:]]*$/\1$(text_offset)/" \
            "$work/theme/theme.txt"
        {
            printf '%s\n' "$begin"
            cat -- "$shipped/user.cfg"
            printf '%s\n' "$end"
        } >>"$work/user.cfg"
        diff -rq -- "$work/theme" "$themes/monolith" >/dev/null 2>&1 || theme_differs=1
    elif [[ -e $themes/monolith ]]; then
        theme_differs=1
    fi
    if [[ -e $grub/user.cfg ]]; then
        cmp -s -- "$work/user.cfg" "$grub/user.cfg" || cfg_differs=1
    elif [[ -s $work/user.cfg ]]; then
        cfg_differs=1
    fi
    if ((!theme_differs && !cfg_differs)); then
        if ((want_on)); then
            echo "Monolith's boot menu look is on /boot already."
        else
            echo "Monolith's boot menu look is off already."
        fi
        return 0
    fi

    make_writable
    if ((want_on)); then
        # The theme first: the block must never name a theme that isn't there.
        if ((theme_differs)); then
            rm -rf -- "$themes/.monolith.new" "$themes/.monolith.old"
            install -d -m 0755 -- "$themes" "$themes/.monolith.new"
            install -m 0644 -- "$work/theme"/* "$themes/.monolith.new/"
            # On the disk before it takes the old theme's place, so a power
            # cut never leaves half a theme under the name GRUB reads.
            sync -f -- "$themes/.monolith.new"
            [[ ! -e $themes/monolith ]] || mv -- "$themes/monolith" "$themes/.monolith.old"
            mv -- "$themes/.monolith.new" "$themes/monolith"
            rm -rf -- "$themes/.monolith.old"
        fi
        if ((cfg_differs)); then put_user_cfg; fi
        sync -f "$grub" 2>/dev/null || sync
        echo "Monolith's boot menu look is on /boot. It shows the next time the computer starts."
    else
        # The block first, for the same reason.
        if ((cfg_differs)); then
            if [[ -s $work/user.cfg ]]; then
                put_user_cfg
            else
                rm -f -- "$grub/user.cfg"
            fi
        fi
        rm -rf -- "$themes/monolith" "$themes/.monolith.new" "$themes/.monolith.old"
        rmdir -- "$themes" 2>/dev/null || true
        sync -f "$grub" 2>/dev/null || sync
        echo "Monolith's boot menu look is off /boot. GRUB shows its plain list again, for one second."
    fi
}

case "${1-}" in
    "")
        if [[ -e $note ]]; then
            echo "Monolith's boot menu look is off. Turn it on with: monolith boot-menu on"
        else
            echo "Monolith's boot menu look is on. Turn it off with: monolith boot-menu off"
        fi
        ;;
    on)
        (($# == 1)) || { usage >&2; exit 2; }
        sudo rm -f -- "$note"
        sudo "$self" sync
        ;;
    off)
        (($# == 1)) || { usage >&2; exit 2; }
        sudo install -D -m 0644 /dev/null "$note"
        sudo "$self" sync
        ;;
    sync)
        (($# == 1)) || { usage >&2; exit 2; }
        sync_menu
        ;;
    -h | --help | help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
