def folder_state(folder):
    def names(path):
        try:
            return set(os.listdir(path))
        except OSError:
            return None
    return folder, names(folder), names(folder / ".icons")


def launcher_targets(paths):
    """Canonical TryExec and Icon paths of every launcher in Gear Lever's desktop directory."""
    targets = set()
    with contextlib.suppress(OSError):
        for name in os.listdir(paths.apps):
            desktop = read_desktop(paths.apps / name) if name.endswith(".desktop") else None
            for key in ("TryExec", "Icon"):
                if desktop is not None and os.path.isabs(desktop.get(key)):
                    targets.add(canonical(desktop.get(key)))
    return targets


def remove_strays(paths, before, release):
    """Delete only unregistered files a failed Gear Lever call left: new, and exactly the verified download."""
    folder, names_before, icons_before = before
    _, names, icons = folder_state(folder)
    referenced = launcher_targets(paths)
    for name in sorted((names or set()) - (names_before or set())):
        path = folder / name
        status = lstat_or_none(path)
        if (status is None or not stat.S_ISREG(status.st_mode) or status.st_size != release.size
                or canonical(path) in referenced or file_sha256(path) != release.sha256):
            continue
        os.unlink(path)
        stem = os.path.splitext(name)[0]
        for icon in sorted((icons or set()) - (icons_before or set())):
            icon_path = folder / ".icons" / icon
            if (os.path.splitext(icon)[0] == stem and file_kind(icon_path) == "regular"
                    and canonical(icon_path) not in referenced):
                os.unlink(icon_path)
    if icons_before is None:
        remove_empty_dir(folder / ".icons")
    if names_before is None:
        remove_empty_dir(folder)


def undo_fresh_integration(paths, gear_lever, before, release):
    leftovers = []
    for integration in inspect_gear_lever(paths, gear_lever):
        entry = integration.entry
        if entry is not None:
            code, out, err = gear_lever.run("--remove", entry.path, "--yes", "--delete")
            if code == 0 and not any(os.path.lexists(path) for path in integration.paths()):
                continue
        leftovers.extend(path for path in integration.paths() if os.path.lexists(path))
    remove_strays(paths, before, release)
    if leftovers:
        raise HelperError(f"the new WowUp-CF integration could not be removed: {', '.join(leftovers)}. Remove "
                          "it in Gear Lever")


def existing_copy(release, before):
    folder, names_before, _ = before
    for name in sorted(names_before or ()):
        path = folder / name
        status = lstat_or_none(path)
        if (status is not None and stat.S_ISREG(status.st_mode) and status.st_size == release.size
                and file_sha256(path) == release.sha256):
            return path
    return None


def integrate_fresh(paths, gear_lever, transaction, staged, release):
    before = folder_state(gear_lever_folder(paths))
    transaction.on_rollback("remove the new Gear Lever integration",
                            lambda: undo_fresh_integration(paths, gear_lever, before, release))
    print("Integrating WowUp-CF with Gear Lever...", flush=True)
    code, out, err = gear_lever.run("--integrate", str(staged), "--replace", "--yes")
    if code != 0:
        raise HelperError(f"Gear Lever could not integrate WowUp-CF ({summary(code, out, err)}).")
    integrations = inspect_gear_lever(paths, gear_lever)
    if len(integrations) != 1 or integrations[0].entry is None:
        copy = existing_copy(release, before) if not integrations else None
        hint = (f" Gear Lever already has an identical AppImage without a launcher at {copy}; integrate or "
                "delete it in Gear Lever, then retry." if copy else "")
        raise HelperError(f"Gear Lever did not create exactly one WowUp-CF integration "
                          f"({conflict_list(integrations) or 'none found'}).{hint}")
    integration = integrations[0]
    entry = integration.entry
    desktop = read_desktop(integration.desktop_path, follow=False) if integration.desktop_path else None
    if desktop is None or not desktop.points_to(entry.path) or file_kind(entry.path) != "regular":
        raise HelperError(f"Gear Lever's new WowUp-CF launcher does not point to its AppImage "
                          f"({conflict_list(integrations)}).")
    if file_sha256(entry.path) != release.sha256:
        raise HelperError(f"The AppImage Gear Lever integrated at {entry.path} does not match the verified "
                          "download.")
    integration.desktop = desktop
    return integration


def replace_appimage(transaction, appimage, source, release, identity):
    path = Path(appimage)
    temporary = copy_sibling(transaction.scratch, source, path, 0o755, release)

    def unchanged():
        status = lstat_or_none(path)
        return status is not None and (status.st_dev, status.st_ino, status.st_size,
                                       status.st_mtime_ns) == identity

    transaction.replace_with(temporary, path, "appimage", unchanged, large=True)


def restore_missing(transaction, plan, source, release):
    """Recreate only missing Monolith-owned objects from the verified AppImage and saved artifacts."""
    receipt = plan.receipt
    restored = []
    if "appimage" in plan.missing:
        appimage = Path(receipt.appimage)
        transaction.make_dirs(appimage.parent)
        transaction.link_new(copy_sibling(transaction.scratch, source, appimage, 0o755, release), appimage)
        restored.append(str(appimage))
    if "desktop" in plan.missing:
        desktop_path = plan.integration.desktop_path
        transaction.make_dirs(desktop_path.parent)
        transaction.create_file(desktop_path, plan.snapshot_desktop, 0o644)
        restored.append(str(desktop_path))
    if "icon" in plan.missing:
        icon = Path(receipt.icon)
        transaction.make_dirs(icon.parent)
        transaction.create_file(icon, plan.snapshot_icon, 0o644)
        restored.append(str(icon))
    print(f"Restored {', '.join(restored)}.", flush=True)


def find_managed(paths, gear_lever, appimage, desktop_path):
    integrations = inspect_gear_lever(paths, gear_lever)
    key = canonical(desktop_path)
    if (len(integrations) != 1 or integrations[0].key != key or integrations[0].entry is None
            or canonical(integrations[0].entry.path) != canonical(appimage)):
        raise HelperError(f"Gear Lever does not list exactly one WowUp-CF integration at {desktop_path} "
                          f"({conflict_list(integrations) or 'none found'}). Resolve it in Gear Lever, then "
                          "retry.")
    integration = integrations[0]
    integration.desktop = read_desktop(desktop_path, follow=False)
    if integration.desktop is None or not integration.desktop.points_to(appimage):
        raise HelperError(f"The WowUp-CF launcher {desktop_path} does not point to {appimage}.")
    return integration


def set_desktop_version(transaction, integration, release):
    desktop = integration.desktop
    if desktop.get("X-AppImage-Version") == release.version:
        return
    mode = stat.S_IMODE(os.lstat(integration.desktop_path).st_mode)
    transaction.replace_file(integration.desktop_path,
                             set_desktop_value(desktop.data, "X-AppImage-Version", release.version),
                             mode, desktop.data, "launcher.desktop")


def verify(paths, gear_lever, appimage, desktop_path, release):
    integration = find_managed(paths, gear_lever, appimage, desktop_path)
    entry = integration.entry
    status = lstat_or_none(entry.path)
    problems = []
    if integration.desktop.get("X-AppImage-Version") != release.version:
        problems.append("its launcher version was not updated")
    if entry.manager is not None or entry.embedded:
        problems.append(f"Gear Lever still has update source {entry.manager}")
    if status is None or not stat.S_ISREG(status.st_mode) or status.st_size != release.size:
        problems.append(f"{entry.path} is not the verified AppImage")
    if problems:
        raise HelperError(f"The WowUp-CF integration did not verify: {'; '.join(problems)}.")
    return integration


def finalize(paths, transaction, integration, release):
    icon = owned_icon(integration.desktop, integration.entry.path)
    transaction.make_dirs(paths.snapshots)
    transaction.write_private(paths.snapshot_desktop, integration.desktop.data, "integration.desktop")
    if icon is None:
        transaction.remove_private(paths.snapshot_icon, "integration.icon")
    else:
        data = read_regular(icon, MAX_LARGE_FILE)
        if data is None:
            raise HelperError(f"Cannot read the WowUp-CF icon {icon}")
        transaction.write_private(paths.snapshot_icon, data, "integration.icon")
    receipt = Receipt(release.version, release.url, release.channel, release.sha256, integration.entry.path,
                      integration.desktop_path.name, icon or "")
    transaction.make_dirs(paths.receipt.parent)
    # Publishing the receipt is the last step of every successful transaction.
    transaction.write_private(paths.receipt, receipt.encode(), "wowup-cf.managed")


def install(scope):
    paths = Paths()
    require_readelf()
    receipt = load_receipt(paths)
    preferences = Preferences(paths.preferences)
    preferences_before = preferences.read()
    gear_lever = GearLever(scope)
    plan = make_plan(paths, receipt, inspect_gear_lever(paths, gear_lever))
    load_snapshots(paths, plan)
    ensure_closed([plan.entry], [plan.appimage])
    releases = parse_releases(fetch_releases())
    target = select_target(releases, receipt is not None and receipt.channel == "stable")
    current = None
    if plan.mode != "fresh" and "appimage" not in plan.missing:
        current = identify(plan.appimage, receipt, releases)
    elif receipt is not None:
        current = Current(receipt.version, version_key(receipt.version))
    if current is not None and current.key > target.key:
        raise HelperError(f"The installed WowUp-CF {current.version} is newer than {target.version}, the newest "
                          "version Monolith permits; Monolith never downgrades. Nothing was changed.")
    reuse = current is not None and current.sha256 == target.sha256
    print(f"Selected WowUp-CF {target.describe()} from {REPOSITORY}.", flush=True)
    scratch = Scratch(paths)
    success = False
    try:
        source = Path(plan.appimage) if reuse else download(target, scratch.mkdtemp(".stage."))
        check_embedded(source, target)
        recheck(paths, gear_lever, plan)
        transaction = Transaction(scratch)

        def publish():
            preferences.ensure_stable(transaction, preferences_before)
            if plan.mode == "fresh":
                integration = integrate_fresh(paths, gear_lever, transaction, source, target)
            else:
                if plan.missing:
                    restore_missing(transaction, plan, source, target)
                if not reuse and "appimage" not in plan.missing:
                    replace_appimage(transaction, plan.appimage, source, target, current.identity)
                integration = find_managed(paths, gear_lever, plan.appimage, plan.integration.desktop_path)
                if "desktop" not in plan.missing and integration.desktop.data != plan.integration.desktop.data:
                    raise HelperError(f"{integration.desktop_path} changed while Monolith was working; it was "
                                      "not overwritten. Retry.")
            clear_update_source(paths, gear_lever, transaction, integration.entry)
            set_desktop_version(transaction, integration, target)
            integration = verify(paths, gear_lever, integration.entry.path, integration.desktop_path, target)
            finalize(paths, transaction, integration, target)
            return integration

        integration = run_transaction(transaction, publish)
        success = True
    finally:
        with GUARD.shielded():
            scratch.cleanup(success)
    location = integration.entry.path
    if plan.mode == "fresh":
        print(f"Installed WowUp-CF {target.version} with Gear Lever at {location}.")
    elif current is not None and current.key != target.key:
        print(f"Updated WowUp-CF from {current.version} to {target.version} at {location}.")
    else:
        print(f"WowUp-CF {target.version} is installed at {location}.")
    if plan.mode == "adopt":
        print("Monolith now manages this existing Gear Lever integration and its launcher.")


# --- remove ----------------------------------------------------------------------------------------------

def repair_before_removal(paths, gear_lever, plan):
    """Gear Lever can only deregister an integration whose AppImage and launcher exist."""
    receipt = plan.receipt
    scratch = Scratch(paths)
    success = False
    try:
        source = release = None
        if "appimage" in plan.missing:
            releases = parse_releases(fetch_releases())
            release = select_target(releases, receipt.channel == "stable")
            source = download(release, scratch.mkdtemp(".stage."))
        ensure_closed([plan.entry], [plan.appimage])
        transaction = Transaction(scratch)

        def publish():
            restore_missing(transaction, plan, source, release)
            find_managed(paths, gear_lever, receipt.appimage, plan.integration.desktop_path)
            if release is not None:
                updated = dataclasses.replace(receipt, version=release.version, source=release.url,
                                              channel=release.channel, sha256=release.sha256)
                transaction.write_private(paths.receipt, updated.encode(), "wowup-cf.managed")

        run_transaction(transaction, publish)
        success = True
    finally:
        with GUARD.shielded():
            scratch.cleanup(success)


def forget(paths, receipt):
    """Once Gear Lever no longer registers WowUp-CF: drop its owned icon copy, the receipt, then snapshots."""
    if receipt.icon and file_kind(receipt.icon) == "regular" and icons_dir_ok(receipt.icon):
        os.unlink(receipt.icon)
    with GUARD.critical():
        paths.receipt.unlink(missing_ok=True)
    with GUARD.shielded():
        for path in (paths.snapshot_desktop, paths.snapshot_icon):
            path.unlink(missing_ok=True)
        remove_empty_dir(paths.snapshots)


def remove(scope):
    paths = Paths()
    receipt = load_receipt(paths)
    if receipt is None:
        raise HelperError(f"WowUp-CF is not managed by Monolith ({paths.receipt} does not exist), so nothing "
                          "was removed. Remove other WowUp-CF integrations in Gear Lever.")
    gear_lever = GearLever(scope)
    plan = make_plan(paths, receipt, inspect_gear_lever(paths, gear_lever))
    ensure_closed([plan.entry], [plan.appimage])
    if {"appimage", "desktop"} <= plan.missing:
        # Gear Lever lists integrations by launcher; with launcher and AppImage gone none is registered.
        forget(paths, receipt)
        print("WowUp-CF's AppImage and launcher were already gone; Monolith removed its own records. "
              "Settings, addons and game data were kept.")
        return
    if plan.missing:
        load_snapshots(paths, plan)
        repair_before_removal(paths, gear_lever, plan)
        receipt = load_receipt(paths)
        plan = make_plan(paths, receipt, inspect_gear_lever(paths, gear_lever))
        if plan.missing:
            raise HelperError("The WowUp-CF integration is still incomplete; resolve it in Gear Lever.")
        ensure_closed([plan.entry], [plan.appimage])
    integration = plan.integration
    entry = integration.entry
    desktop = integration.desktop
    icon = desktop.get("Icon")
    owned = receipt.icon
    scratch = Scratch(paths)
    transaction = Transaction(scratch)

    def publish():
        # Gear Lever deletes any absolute Icon file; protect icons that are not its own copy.
        if "/" in icon and not (owned and canonical(icon) == canonical(owned)):
            transaction.replace_file(integration.desktop_path,
                                     set_desktop_value(desktop.data, "Icon", NEUTRAL_ICON),
                                     stat.S_IMODE(os.lstat(integration.desktop_path).st_mode),
                                     desktop.data, "launcher.desktop")
        code, out, err = gear_lever.run("--remove", entry.path, "--yes", "--delete")
        remaining = [path for path in (entry.path, str(integration.desktop_path)) if os.path.lexists(path)]
        if code != 0 or remaining:
            raise HelperError(f"Gear Lever did not remove WowUp-CF ({summary(code, out, err)}); still present: "
                              f"{', '.join(remaining) or 'none'}. Monolith kept its receipt so the removal "
                              "can be retried.")
        if any(canonical(item.path) == canonical(entry.path) for item in gear_lever.listing()):
            raise HelperError(f"Gear Lever still lists {entry.path} after removing it.")

    success = False
    try:
        run_transaction(transaction, publish)
        forget(paths, receipt)
        success = True
    finally:
        with GUARD.shielded():
            scratch.cleanup(success)
    print(f"Removed WowUp-CF from Gear Lever ({entry.path}). Its settings, addons and game data were kept.")


# --- read-only inspection ----------------------------------------------------------------------------------

def inspect(paths):
    """Filesystem-only: no Gear Lever, no network, no hashing and no writes."""
    result = {"status": "not installed", "version": None, "appimage": None, "desktop_id": None,
              "source": None, "channel": None, "conflicts": []}
    desktops = scan_cf_desktops(paths.apps)
    try:
        receipt = load_receipt(paths)
    except HelperError:
        return dict(result, status="needs repair", conflicts=[str(paths.receipt)])
    if receipt is not None:
        problems = []
        if file_kind(receipt.appimage) != "regular":
            problems.append(receipt.appimage)
        desktop_path = paths.apps / receipt.desktop_id
        desktop = read_desktop(desktop_path, follow=False)
        if desktop is None or not desktop.points_to(receipt.appimage):
            problems.append(str(desktop_path))
        if receipt.icon and file_kind(receipt.icon) != "regular":
            problems.append(receipt.icon)
        problems.extend(str(item.path) for item in desktops if canonical(item.path) != canonical(desktop_path))
        return dict(result, status="needs repair" if problems else "installed", version=receipt.version,
                    appimage=receipt.appimage, desktop_id=receipt.desktop_id, source=receipt.source,
                    channel=receipt.channel, conflicts=problems)
    if not desktops:
        return result
    if len(desktops) > 1:
        return dict(result, status="external", conflicts=[str(item.path) for item in desktops])
    desktop = desktops[0]
    tryexec = desktop.get("TryExec")
    problem = adoption_problem(desktop.path, tryexec)
    return dict(result, status="external", appimage=tryexec or None, desktop_id=desktop.path.name,
                conflicts=[str(problem[0])] if problem else [])


def build_parser():
    parser = argparse.ArgumentParser(
        prog="wowup-cf",
        description="Install, update and remove WowUp-CF through Gear Lever under Monolith's release policy: "
                    "the 2.24.0 beta series (beta.6 or newer) until a stable release 2.24.0 or newer exists, "
                    "then stable releases only.")
    parser.add_argument("--scope", choices=("user", "system"),
                        help="Flatpak installation providing Gear Lever (required for install and remove)")
    commands = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")
    commands.add_parser("status", help="print installed, needs repair, external or not installed")
    commands.add_parser("info", help="print the inspected integration as a JSON object")
    commands.add_parser("install", help="install, adopt, update or repair the Gear Lever integration")
    commands.add_parser("remove", help="remove the Monolith-managed Gear Lever integration")
    return parser


def main(argv=None):
    parser = build_parser()
    arguments = parser.parse_args(argv)
    if arguments.command in ("install", "remove") and arguments.scope is None:
        parser.error("--scope user|system is required for install and remove")
    GUARD.reset()
    previous = {signum: signal.signal(signum, GUARD.handler) for signum in (signal.SIGINT, signal.SIGTERM)}
    code = 0
    try:
        if arguments.command == "status":
            print(inspect(Paths())["status"])
        elif arguments.command == "info":
            print(json.dumps(inspect(Paths()), ensure_ascii=False))
        elif arguments.command == "install":
            install(arguments.scope)
        else:
            remove(arguments.scope)
    except Interrupted as error:
        code = 128 + error.signum
        detail = f"rollback was incomplete: {error.detail}" if error.detail else "no changes were kept"
        print(f"Error: Cancelled by {signal.Signals(error.signum).name}; {detail}.", file=sys.stderr)
    except RunningError:
        code = 1
        print(RUNNING_MESSAGE, file=sys.stderr)
    except Exception as error:
        code = 1
        print(f"Error: {error}", file=sys.stderr)
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)
    if code == 0 and GUARD.received is not None:
        code = 128 + GUARD.received
    return code


if __name__ == "__main__":
    sys.exit(main())
