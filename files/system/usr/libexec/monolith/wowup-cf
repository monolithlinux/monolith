class Scratch:
    """Private temporary names; everything is removed unless kept as named recovery files."""

    def __init__(self, paths):
        self.paths = paths
        self.created_roots = []
        self.directories = []
        self.files = []

    def ensure_root(self):
        missing = []
        current = self.paths.managed_root
        while not os.path.lexists(current):
            missing.append(current)
            current = current.parent
        for path in reversed(missing):
            with GUARD.critical():
                os.mkdir(path)
                self.created_roots.append(path)

    def mkdtemp(self, prefix):
        self.ensure_root()
        with GUARD.critical():
            directory = Path(tempfile.mkdtemp(prefix=prefix, dir=self.paths.managed_root))
            self.directories.append(directory)
        return directory

    def sibling(self, path, suffix):
        with GUARD.critical():
            name = path.parent / f".{path.name}.{secrets.token_hex(6)}{suffix}"
            self.files.append(name)
        return name

    def keep(self, directory):
        self.directories.remove(directory)

    def cleanup(self, success):
        for file in self.files:
            with contextlib.suppress(OSError):
                file.unlink(missing_ok=True)
        for directory in self.directories:
            shutil.rmtree(directory, ignore_errors=True)
        if not success:
            for path in reversed(self.created_roots):
                remove_empty_dir(path)


def write_sibling(scratch, path, data, mode):
    temporary = scratch.sibling(path, ".monolith-tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
    with os.fdopen(descriptor, "wb") as file:
        file.write(data)
        file.flush()
        os.fsync(file.fileno())
    os.chmod(temporary, mode)
    return temporary


def copy_sibling(scratch, source, path, mode, release=None):
    """Put source's bytes beside path, by hard link or rename when possible, verifying copies."""
    temporary = scratch.sibling(path, ".monolith-new")
    try:
        if release is None:
            os.link(source, temporary)
        else:
            os.rename(source, temporary)
    except OSError:
        digest = hashlib.sha256()
        size = 0
        with open(source, "rb") as reader:
            descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
            with os.fdopen(descriptor, "wb") as writer:
                while chunk := reader.read(CHUNK):
                    digest.update(chunk)
                    size += len(chunk)
                    writer.write(chunk)
                writer.flush()
                os.fsync(writer.fileno())
        if release is not None and (size != release.size or digest.hexdigest() != release.sha256):
            raise HelperError(f"Copying the verified AppImage to {path.parent} corrupted it. Nothing was kept.")
    os.chmod(temporary, mode)
    return temporary


class Transaction:
    """Ordered, state-based undo steps: each restores only what this run demonstrably changed."""

    def __init__(self, scratch):
        self.scratch = scratch
        self.directory = None
        self.undo = []
        self.saved = []

    def workdir(self):
        if self.directory is None:
            self.directory = self.scratch.mkdtemp(".rollback.")
        return self.directory

    def on_rollback(self, description, action):
        self.undo.append((description, action))

    def save(self, path, label, large=False):
        target = self.workdir() / f"{len(self.saved) + 1}-{label}"
        try:
            if not large:
                raise OSError
            os.link(path, target)
        except OSError:
            shutil.copyfile(path, target, follow_symlinks=False)
        self.saved.append(f"{target} (copy of {path})")
        return target

    def make_dirs(self, directory, mode=0o755):
        missing = []
        current = Path(directory)
        while not os.path.lexists(current):
            missing.append(current)
            current = current.parent
        for path in reversed(missing):
            with GUARD.critical():
                os.mkdir(path, mode)
                self.on_rollback(f"remove {path}", lambda path=path: remove_empty_dir(path))

    def create_file(self, path, data, mode):
        temporary = write_sibling(self.scratch, path, data, mode)
        self.link_new(temporary, path)

    def link_new(self, temporary, path):
        identity = file_identity(temporary)
        self.on_rollback(f"remove {path}", lambda: unlink_if_identity(path, identity))
        try:
            os.link(temporary, path)
        except FileExistsError:
            raise HelperError(f"{path} appeared while Monolith was working; it was not overwritten.") from None
        os.unlink(temporary)

    def replace_file(self, path, data, mode, expected, label):
        self.replace_with(write_sibling(self.scratch, path, data, mode), path, label,
                          lambda: read_regular(path, MAX_LARGE_FILE) == expected)

    def replace_with(self, temporary, path, label, unchanged, large=False):
        original_mode = stat.S_IMODE(os.lstat(path).st_mode)
        backup = self.save(path, label, large)
        identity = file_identity(temporary)

        def restore():
            if file_identity(path) == identity:
                os.replace(copy_sibling(self.scratch, backup, path, original_mode), path)

        self.on_rollback(f"restore {path}", restore)
        if not unchanged():
            raise HelperError(f"{path} changed while Monolith was working; it was not overwritten. Retry.")
        os.replace(temporary, path)

    def write_private(self, path, data, label):
        current = read_regular(path, MAX_LARGE_FILE)
        if current == data:
            return
        if current is None:
            if os.path.lexists(path):
                raise HelperError(f"{path} is not a regular file; move it aside, then retry.")
            self.create_file(path, data, 0o644)
        else:
            self.replace_file(path, data, 0o644, current, label)

    def remove_private(self, path, label):
        if read_regular(path, MAX_LARGE_FILE) is None:
            return
        backup = self.save(path, label)

        def restore():
            if not os.path.lexists(path):
                temporary = copy_sibling(self.scratch, backup, path, 0o644)
                os.link(temporary, path)
                os.unlink(temporary)

        self.on_rollback(f"restore {path}", restore)
        os.unlink(path)

    def rollback(self):
        failures = []
        for description, action in reversed(self.undo):
            try:
                action()
            except Exception as error:
                failures.append(f"could not {description}: {error}")
        self.undo.clear()
        if not failures:
            return None
        message = "; ".join(failures)
        if self.directory is not None:
            self.scratch.keep(self.directory)
            message += f". Recovery files were kept in {self.directory}"
            if self.saved:
                message += ": " + "; ".join(self.saved)
        return message


def run_transaction(transaction, body):
    try:
        result = body()
    except BaseException as error:
        with GUARD.shielded():
            failure = transaction.rollback()
        if failure is None:
            raise
        if isinstance(error, Interrupted):
            error.detail = failure
            raise
        raise HelperError(f"{error} Rollback was incomplete: {failure}.") from error
    transaction.undo.clear()
    return result


# --- planning ------------------------------------------------------------------------------------------

@dataclasses.dataclass
class Plan:
    mode: str
    keys: list
    integration: Integration | None = None
    receipt: Receipt | None = None
    missing: frozenset = frozenset()
    snapshot_desktop: bytes | None = None
    snapshot_icon: bytes | None = None

    @property
    def appimage(self):
        if self.receipt is not None:
            return self.receipt.appimage
        return self.integration.entry.path if self.integration else None

    @property
    def entry(self):
        return self.integration.entry if self.integration else None


def conflict_list(integrations):
    return "; ".join(" -> ".join(integration.paths()) for integration in integrations)


def adoption_problem(desktop_path, appimage):
    """Filesystem-only reasons one external integration cannot be adopted, with the offending path."""
    desktop = read_desktop(desktop_path, follow=False) if desktop_path else None
    if desktop is None:
        return desktop_path, "its launcher is not a regular, readable desktop file"
    if desktop.get("X-AppImage-Name") != APP_NAME:
        return desktop_path, "its launcher lacks X-AppImage-Name=WowUp-CF"
    if not appimage or not desktop.points_to(appimage):
        return desktop_path, "its launcher does not start the AppImage Gear Lever lists"
    if file_kind(appimage) != "regular":
        return appimage, "its AppImage is missing or not a regular file"
    return None


def make_plan(paths, receipt, integrations):
    keys = [integration.key for integration in integrations]
    if receipt is None:
        if not integrations:
            return Plan("fresh", keys)
        if len(integrations) > 1:
            raise HelperError(f"Found {len(integrations)} WowUp-CF integrations: {conflict_list(integrations)}. "
                              "Keep only one in Gear Lever, then retry; Monolith will not guess which one "
                              "to replace.")
        integration = integrations[0]
        entry = integration.entry
        if entry is None:
            problem = (integration.desktop_path, "Gear Lever does not list it, because its AppImage is missing "
                                                 "or unsupported")
        else:
            problem = adoption_problem(integration.desktop_path, entry.path)
        if problem:
            raise HelperError(f"Monolith cannot adopt the WowUp-CF integration {conflict_list(integrations)}: "
                              f"{problem[1]}. Resolve it in Gear Lever, then retry.")
        integration.desktop = read_desktop(integration.desktop_path, follow=False)
        return Plan("adopt", keys, integration)

    desktop_path = paths.apps / receipt.desktop_id
    key = canonical(desktop_path)
    others = [integration for integration in integrations if integration.key != key]
    if others:
        raise HelperError(f"Another WowUp-CF integration exists besides Monolith's: {conflict_list(others)}. "
                          "Remove or consolidate it in Gear Lever, then retry.")
    missing = set()
    conflicts = []
    kind = file_kind(receipt.appimage)
    if kind == "missing":
        missing.add("appimage")
    elif kind == "other":
        conflicts.append(receipt.appimage)
    desktop = None
    kind = file_kind(desktop_path)
    if kind == "missing":
        missing.add("desktop")
    else:
        desktop = read_desktop(desktop_path, follow=False)
        if desktop is None or not desktop.points_to(receipt.appimage):
            conflicts.append(str(desktop_path))
    if receipt.icon:
        kind = file_kind(receipt.icon)
        if not icons_dir_ok(receipt.icon):
            conflicts.append(str(Path(receipt.icon).parent))
        elif kind == "missing":
            missing.add("icon")
        elif kind == "other":
            conflicts.append(receipt.icon)
    if conflicts:
        raise HelperError(f"The Monolith-managed WowUp-CF integration has replaced or conflicting files: "
                          f"{', '.join(conflicts)}. Monolith will not overwrite them; resolve that "
                          "integration in Gear Lever (or move those files aside), then retry.")
    entry = integrations[0].entry if integrations else None
    if entry is not None and canonical(entry.path) != canonical(receipt.appimage):
        raise HelperError(f"Gear Lever's WowUp-CF launcher {desktop_path} now points to {entry.path}, not "
                          f"Monolith's {receipt.appimage}. Resolve it in Gear Lever, then retry.")
    if entry is None and not missing:
        raise HelperError(f"Gear Lever does not list the Monolith-managed WowUp-CF integration {desktop_path}. "
                          "Resolve it in Gear Lever, then retry.")
    return Plan("managed", keys, Integration(key, desktop_path, desktop, entry), receipt, frozenset(missing))


def load_snapshots(paths, plan):
    """A repair needs Monolith's last-successful copies of every missing launcher or icon."""
    if "desktop" in plan.missing:
        data = read_regular(paths.snapshot_desktop)
        values = parse_desktop(data) if data is not None else None
        if values is None or not Desktop(paths.snapshot_desktop, data, values).points_to(plan.receipt.appimage):
            raise HelperError(f"{plan.integration.desktop_path} is missing and Monolith's saved launcher "
                              f"{paths.snapshot_desktop} is missing or invalid, so it cannot be repaired. "
                              "Resolve the WowUp-CF integration in Gear Lever, then retry.")
        plan.snapshot_desktop = data
    if "icon" in plan.missing:
        data = read_regular(paths.snapshot_icon, MAX_LARGE_FILE)
        if not data:
            raise HelperError(f"{plan.receipt.icon} is missing and Monolith's saved icon {paths.snapshot_icon} "
                              "is missing, so it cannot be repaired. Resolve the WowUp-CF integration in Gear "
                              "Lever, then retry.")
        plan.snapshot_icon = data


def recheck(paths, gear_lever, plan):
    """Immediately before publication: same integrations and launcher, and WowUp-CF still closed."""
    integrations = inspect_gear_lever(paths, gear_lever)
    if [integration.key for integration in integrations] != plan.keys:
        raise HelperError("Gear Lever's WowUp-CF integrations changed while Monolith was working; nothing "
                          "was changed. Retry.")
    if plan.integration is not None and plan.integration.desktop is not None:
        current = read_desktop(plan.integration.desktop_path, follow=False)
        if current is None or current.data != plan.integration.desktop.data:
            raise HelperError(f"{plan.integration.desktop_path} changed while Monolith was working; nothing "
                              "was changed. Retry.")
    if plan.integration is not None and integrations:
        plan.integration.entry = integrations[0].entry
    ensure_closed([plan.entry], [plan.appimage])


