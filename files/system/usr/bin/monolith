#!/usr/bin/bash
# Install optional software per-user without removing user data on uninstall.

set -Eeuo pipefail
# Keep errexit inside command substitutions so a failed probe cannot be ignored.
shopt -s inherit_errexit

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
BIN_DIR="$HOME/.local/bin"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
MANAGED_ROOT="$DATA_HOME/monolith/software"
STATE_ROOT="$STATE_HOME/monolith/software"
GHOSTTY_THEMES_HELPER="$(dirname -- "$SELF")/../libexec/monolith/ghostty-themes"
GEAR_LEVER_APP_HELPER="$(dirname -- "$SELF")/../libexec/monolith/gear-lever-app"
GEAR_LEVER_ID=it.mijorus.gearlever
GEAR_LEVER_REF=https://dl.flathub.org/repo/appstream/it.mijorus.gearlever.flatpakref
GEAR_LEVER_MIN_VERSION=4.6.2
QUIT_TOKEN=__monolith_quit__
ACTIVE_TEMP=""
GEAR_LEVER_SCOPE=""
RUN_INTERRUPTED=0
SELECTOR=numbered
USE_COLOR=0
PICKED=""

readonly SELF BIN_DIR DATA_HOME STATE_HOME MANAGED_ROOT STATE_ROOT GHOSTTY_THEMES_HELPER GEAR_LEVER_APP_HELPER
readonly GEAR_LEVER_ID GEAR_LEVER_REF GEAR_LEVER_MIN_VERSION QUIT_TOKEN

ALL_TOOLS=(tea superfile nak ngit claude codex opencode omp herdr wowup-cf r2modman ghostty-themes)
CLI_TOOLS=(tea superfile nak ngit)
AI_TOOLS=(claude codex opencode omp herdr)
GAMING_TOOLS=(wowup-cf r2modman)
APPEARANCE_TOOLS=(ghostty-themes)

# Per-render state; menus and list compute each row once. Gear Lever apps
# also keep the helper's summary; APP_CONFLICTS holds one path per line.
declare -A ROW_STATUS=() ROW_VERSION=()
declare -A APP_VERSION=() APP_APPIMAGE=() APP_DESKTOP_ID=() APP_SOURCE=() APP_CHANNEL=() APP_ERROR=()
declare -A APP_CONFLICTS=()

die() {
    echo "Error: $*" >&2
    exit 1
}

note() {
    printf '\n==> %s\n' "$*"
}

warn() {
    printf 'Warning: %s\n' "$*" >&2
}

cleanup_active_temp() {
    [ -n "$ACTIVE_TEMP" ] || return 0
    case "$ACTIVE_TEMP" in
        /tmp/*|"$MANAGED_ROOT"/.stage.*)
            rm -rf -- "$ACTIVE_TEMP"
            ;;
    esac
    ACTIVE_TEMP=""
}

trap cleanup_active_temp EXIT
trap 'cleanup_active_temp; exit 130' INT
trap 'cleanup_active_temp; exit 143' TERM

new_temp_dir() {
    cleanup_active_temp
    # Keep publication on the same filesystem and cleanup independent of TMPDIR.
    mkdir -p "$MANAGED_ROOT"
    ACTIVE_TEMP="$(mktemp -d "$MANAGED_ROOT/.stage.XXXXXX")"
}

safe_remove_tree() {
    local path="$1"

    case "$path" in
        "$MANAGED_ROOT"/*|"$DATA_HOME/claude"|"$HOME/.codex/packages/standalone"|"$HOME/.opencode/bin")
            rm -rf -- "$path"
            ;;
        *)
            die "refusing to remove unexpected path: $path"
            ;;
    esac
}

tool_name() {
    case "$1" in
        tea)       echo "Tea" ;;
        superfile) echo "Superfile" ;;
        nak)       echo "nak" ;;
        ngit)      echo "ngit" ;;
        claude)    echo "Claude Code" ;;
        codex)     echo "Codex CLI" ;;
        opencode)  echo "OpenCode" ;;
        omp)       echo "Oh My Pi" ;;
        herdr)     echo "Herdr" ;;
        wowup-cf)  echo "WowUp-CF" ;;
        r2modman)  echo "r2modman" ;;
        ghostty-themes) echo "Ghostty Themes" ;;
        *)         return 1 ;;
    esac
}

tool_description() {
    case "$1" in
        tea)       echo "Gitea and Forgejo CLI" ;;
        superfile) echo "terminal file manager (spf)" ;;
        nak)       echo "Nostr relay and event CLI" ;;
        ngit)      echo "Git collaboration over Nostr" ;;
        claude)    echo "Anthropic coding agent" ;;
        codex)     echo "OpenAI coding agent" ;;
        opencode)  echo "provider-independent coding agent" ;;
        omp)       echo "coding agent with built-in development tools" ;;
        herdr)     echo "terminal multiplexer for coding agents" ;;
        wowup-cf)  echo "World of Warcraft addon manager with CurseForge and WoW Forever support" ;;
        r2modman)  echo "Thunderstore mod manager for Lethal Company, Risk of Rain 2, Valheim, and more" ;;
        ghostty-themes) echo "official Ghostty theme collection" ;;
        *)         return 1 ;;
    esac
}

tool_category() {
    case "$1" in
        tea|superfile|nak|ngit) echo "Developer CLIs" ;;
        claude|codex|opencode|omp|herdr) echo "AI coding" ;;
        wowup-cf|r2modman) echo "Gaming" ;;
        ghostty-themes) echo "Appearance" ;;
        *) return 1 ;;
    esac
}

tool_commands() {
    case "$1" in
        tea)       echo "tea" ;;
        superfile) echo "spf" ;;
        nak)       echo "nak" ;;
        ngit)      echo "ngit git-remote-nostr" ;;
        claude)    echo "claude" ;;
        codex)     echo "codex" ;;
        opencode)  echo "opencode" ;;
        omp)       echo "omp" ;;
        herdr)     echo "herdr" ;;
        wowup-cf|r2modman|ghostty-themes) return 0 ;;
        *)         return 1 ;;
    esac
}

# Directories that hold each tool's program files. Native installers keep
# their upstream layouts so their own update logic continues to work; Claude
# Code follows XDG_DATA_HOME.
tool_root() {
    case "$1" in
        claude) echo "$DATA_HOME/claude" ;;
        codex) echo "$HOME/.codex/packages/standalone" ;;
        opencode) echo "$HOME/.opencode/bin" ;;
        *) echo "$MANAGED_ROOT/$1" ;;
    esac
}

state_file() {
    echo "$STATE_ROOT/$1.managed"
}

is_known_tool() {
    local candidate="$1" tool
    for tool in "${ALL_TOOLS[@]}"; do
        [ "$candidate" = "$tool" ] && return 0
    done
    return 1
}

has_marker() {
    [ -f "$(state_file "$1")" ]
}

link_points_under() {
    local path="$1" prefix="$2" target
    [ -L "$path" ] || return 1
    # Resolve both sides because Fedora Atomic aliases /home to /var/home.
    prefix="$(readlink -m -- "$prefix")"
    target="$(readlink -- "$path" 2>/dev/null || true)"
    case "$target" in
        /*) target="$(readlink -m -- "$target")" ;;
        *) target="$(readlink -m -- "$(dirname -- "$path")/$target")" ;;
    esac
    [[ "$target" == "$prefix/"* ]]
}

same_file_target() {
    local left="$1" right="$2"
    [ "$(readlink -f -- "$left" 2>/dev/null || true)" = "$(readlink -f -- "$right" 2>/dev/null || true)" ]
}

# A launcher is managed only when it is an executable symlink into the
# tool's root; a broken or replaced launcher needs repair.
launcher_is_managed() {
    local tool="$1" command="$2" root path
    root="$(tool_root "$tool")"
    path="$BIN_DIR/$command"
    [ -x "$path" ] || return 1
    if [ "$tool" = opencode ]; then
        [ -L "$path" ] && same_file_target "$path" "$root/opencode"
    else
        link_points_under "$path" "$root"
    fi
}

# AppImages that Monolith integrates with Gear Lever.
is_gear_lever_app() {
    case "$1" in
        wowup-cf|r2modman) return 0 ;;
        *) return 1 ;;
    esac
}

is_managed() {
    local tool="$1" root command
    has_marker "$tool" || return 1
    if [ "$tool" = ghostty-themes ]; then
        [ "$(ghostty_themes status)" = installed ]
        return
    elif is_gear_lever_app "$tool"; then
        [ "$(gear_lever_app "$tool" status)" = installed ]
        return
    fi
    root="$(tool_root "$tool")"
    [ -d "$root" ] || return 1
    for command in $(tool_commands "$tool"); do
        case "$tool" in
            claude|codex|opencode) ;;
            *) [ -x "$root/bin/$command" ] || return 1 ;;
        esac
        launcher_is_managed "$tool" "$command" || return 1
    done
}

external_path() {
    local tool="$1" command path
    command="$(tool_commands "$tool")"
    [ -n "$command" ] || return 0
    command="${command%% *}"
    path="$(command -v "$command" 2>/dev/null || true)"
    [ -n "$path" ] && printf '%s\n' "$path"
    # Return success when absent so command substitutions do not trip errexit.
    return 0
}

tool_status() {
    local tool="$1"
    if is_gear_lever_app "$tool"; then
        gear_lever_app "$tool" status
    elif is_managed "$tool"; then
        echo "installed"
    elif has_marker "$tool"; then
        echo "needs repair"
    elif [ -n "$(external_path "$tool")" ]; then
        echo "external"
    else
        echo "not installed"
    fi
}

write_marker() {
    local tool="$1" version="$2" source="$3" marker tmp
    marker="$(state_file "$tool")"
    mkdir -p "$STATE_ROOT"
    tmp="$marker.tmp.$$"
    if ! {
        printf 'version=%s\n' "$version"
        printf 'source=%s\n' "$source"
    } >"$tmp"; then
        rm -f -- "$tmp"
        return 1
    fi
    if ! mv -f -- "$tmp" "$marker"; then
        rm -f -- "$tmp"
        return 1
    fi
}

marker_version() {
    local marker
    marker="$(state_file "$1")"
    [ -f "$marker" ] || return 0
    sed -n 's/^version=//p' "$marker" | head -n 1
}

# Only tools with commands own paths in ~/.local/bin.
local_destination_conflict() {
    local tool="$1" path
    [ -n "$(tool_commands "$tool")" ] || return 1
    has_marker "$tool" && return 1

    for path in $(tool_commands "$tool"); do
        path="$BIN_DIR/$path"
        if [ -e "$path" ] || [ -L "$path" ]; then
            printf '%s\n' "$path"
            return 0
        fi
    done

    path="$(tool_root "$tool")"
    if [ -e "$path" ] || [ -L "$path" ]; then
        printf '%s\n' "$path"
        return 0
    fi
    return 1
}

# Print a launcher that the user replaced after Monolith installed the tool.
replaced_launcher() {
    local tool="$1" command path
    [ -n "$(tool_commands "$tool")" ] || return 1
    has_marker "$tool" || return 1
    for command in $(tool_commands "$tool"); do
        path="$BIN_DIR/$command"
        if { [ -e "$path" ] || [ -L "$path" ]; } && ! launcher_points_to_root "$tool" "$command"; then
            printf '%s\n' "$path"
            return 0
        fi
    done
    return 1
}

launcher_points_to_root() {
    local tool="$1" command="$2" root path
    root="$(tool_root "$tool")"
    path="$BIN_DIR/$command"
    if [ "$tool" = opencode ]; then
        [ -L "$path" ] && same_file_target "$path" "$root/opencode"
    else
        link_points_under "$path" "$root"
    fi
}

preflight_install() {
    local tool="$1" conflict path
    mkdir -p "$BIN_DIR" "$MANAGED_ROOT" "$STATE_ROOT"

    if conflict="$(local_destination_conflict "$tool")"; then
        die "$conflict already exists and is not managed by Monolith; move or uninstall it first"
    fi

    # Do not overwrite a managed command that the user later replaced.
    if conflict="$(replaced_launcher "$tool")"; then
        if can_adopt_replaced "$tool"; then
            die "$conflict is a standalone copy outside Monolith's managed layout. To have Monolith manage and update it, run monolith, open $(tool_name "$tool"), and choose Adopt this copy and update; otherwise move it aside before updating"
        fi
        die "$conflict no longer points to the Monolith-managed copy; move it before updating"
    fi

    if ! has_marker "$tool"; then
        path="$(external_path "$tool")"
        if [ -n "$path" ]; then
            warn "an unmanaged $(tool_name "$tool") is already available at $path; ~/.local/bin will take precedence"
        fi
    fi
}

link_command() {
    local command="$1" target="$2" path temporary
    path="$BIN_DIR/$command"
    temporary="$path.monolith.$$"
    mkdir -p "$BIN_DIR"
    # Publish atomically so a failed link replacement leaves the old launcher.
    ln -s -- "$target" "$temporary"
    if ! mv -Tf -- "$temporary" "$path"; then
        rm -f -- "$temporary"
        return 1
    fi
}

# Fetch metadata with a short total deadline, or download a file with stall
# detection only so large binaries are not cut off on slow connections.
curl_fetch() {
    local kind="$1" url="$2" destination="${3:-}"
    local options=(--fail --location --connect-timeout 15)
    case "$kind" in
        metadata)
            options+=(--silent --show-error --max-time 60)
            ;;
        download)
            [ -n "$destination" ] || die "internal error: downloads need an output path"
            options+=(--speed-limit 1024 --speed-time 60)
            if [ -t 2 ]; then
                options+=(--progress-bar)
            else
                options+=(--silent --show-error)
            fi
            ;;
        *)
            die "internal error: unknown fetch kind: $kind"
            ;;
    esac
    if [ -n "$destination" ]; then
        options+=(--output "$destination")
    fi
    curl "${options[@]}" "$url"
}

# Print a release document's top-level tag after validating it for use in
# paths and URLs.
release_tag() {
    python3 -c '
import json, re, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
tag = data.get("tag_name") if isinstance(data, dict) else None
if not isinstance(tag, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", tag):
    sys.exit(1)
print(tag)'
}

latest_github_tag() {
    local repo="$1" json tag
    json="$(curl_fetch metadata "https://api.github.com/repos/$repo/releases/latest")"
    tag="$(printf '%s' "$json" | release_tag)" || die "could not resolve the latest release for $repo"
    printf '%s\n' "$tag"
}

# Print "tag<TAB>url<TAB>sha256" for one exact asset of a repository's latest
# release. GitHub's uploaded-asset SHA256 digest is required.
github_release_asset() {
    local repo="$1" template="$2" json
    json="$(curl_fetch metadata "https://api.github.com/repos/$repo/releases/latest")"
    printf '%s' "$json" | python3 -c '
import json, re, sys

repo, template = sys.argv[1], sys.argv[2]

def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)

try:
    data = json.load(sys.stdin)
except ValueError:
    fail(f"the latest {repo} release metadata is not valid JSON")
if not isinstance(data, dict):
    fail(f"the latest {repo} release metadata is malformed")
tag = data.get("tag_name")
if not isinstance(tag, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", tag):
    fail(f"the latest {repo} release has no valid tag")
name = template.replace("{tag}", tag)
assets = data.get("assets")
if not isinstance(assets, list):
    fail(f"{repo} {tag} lists no assets")
matches = [asset for asset in assets if isinstance(asset, dict) and asset.get("name") == name]
if len(matches) != 1:
    fail(f"{repo} {tag} does not provide exactly one {name} asset")
asset = matches[0]
url = f"https://github.com/{repo}/releases/download/{tag}/{name}"
if asset.get("browser_download_url") != url or asset.get("state") != "uploaded":
    fail(f"{repo} {tag} does not provide an uploaded {name} at {url}")
digest = asset.get("digest")
if not isinstance(digest, str) or not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
    fail(f"{repo} {tag} publishes no SHA256 digest for {name}; refusing an unverified download")
print(tag, url, digest.removeprefix("sha256:"), sep="\t")
' "$repo" "$template"
}

verify_sha256() {
    local file="$1" expected="$2" actual
    actual="$(sha256sum -- "$file")"
    actual="${actual%% *}"
    [ "$actual" = "$expected" ] || die "$(basename -- "$file") failed its SHA256 check; nothing was installed"
}

# Verify FILENAME against exactly one entry in a published checksum list.
verify_listed_checksum() {
    local dir="$1" sums="$2" filename="$3" entries count
    entries="$(awk -v file="$filename" '$2 == file || $2 == "*" file' "$dir/$sums")"
    count="$(printf '%s' "$entries" | grep -c . || true)"
    [ "$count" -eq 1 ] || die "$sums does not list exactly one checksum for $filename; nothing was installed"
    if ! (cd "$dir" && printf '%s\n' "$entries" | sha256sum --check --status -); then
        die "$filename failed its published SHA256 check; nothing was installed"
    fi
}

require_amd64() {
    case "$(uname -m)" in
        x86_64|amd64) ;;
        *) die "$1 is currently configured for Monolith's x86_64 images only" ;;
    esac
}

commit_static_install() {
    # A subshell scopes rollback traps to this transaction. Keep the previous
    # program, launchers, and marker until every part of publication succeeds.
    (
        local tool="$1" stage="$2" version="$3" source="$4" root marker backup command
        local published=0 links_changed=0 committed=0
        root="$(tool_root "$tool")"
        marker="$(state_file "$tool")"
        backup="$(mktemp -d "$MANAGED_ROOT/.rollback.XXXXXX")"

        rollback_static_install() {
            local result=$? restore_failed=0
            trap - EXIT
            for command in $(tool_commands "$tool"); do
                rm -f -- "$BIN_DIR/$command.monolith.$$" || restore_failed=1
            done
            rm -f -- "$marker.tmp.$$" || restore_failed=1
            if [ "$committed" -eq 0 ]; then
                if [ "$published" -eq 1 ]; then
                    rm -rf -- "$root" || restore_failed=1
                fi
                if [ -e "$backup/root" ] || [ -L "$backup/root" ]; then
                    mv -T -- "$backup/root" "$root" || restore_failed=1
                fi
                if [ "$links_changed" -eq 1 ]; then
                    for command in $(tool_commands "$tool"); do
                        if [ -e "$backup/links/$command" ] || [ -L "$backup/links/$command" ]; then
                            mv -Tf -- "$backup/links/$command" "$BIN_DIR/$command" || restore_failed=1
                        else
                            rm -f -- "$BIN_DIR/$command" || restore_failed=1
                        fi
                    done
                    if [ -f "$backup/marker" ]; then
                        mv -Tf -- "$backup/marker" "$marker" || restore_failed=1
                    else
                        rm -f -- "$marker" || restore_failed=1
                    fi
                fi
            fi
            if [ "$restore_failed" -eq 1 ]; then
                warn "could not fully restore $(tool_name "$tool"); recovery files were kept at $backup"
                exit 1
            fi
            rm -rf -- "$backup"
            exit "$result"
        }

        trap rollback_static_install EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        mkdir -p "$backup/links"
        # Keep symlinks and adopted regular files exactly as they were.
        for command in $(tool_commands "$tool"); do
            if [ -e "$BIN_DIR/$command" ] || [ -L "$BIN_DIR/$command" ]; then
                cp -a -- "$BIN_DIR/$command" "$backup/links/$command"
            fi
        done
        if [ -f "$marker" ]; then
            cp -- "$marker" "$backup/marker"
        fi
        if [ -e "$root" ] || [ -L "$root" ]; then
            mv -T -- "$root" "$backup/root"
        fi
        # Record cleanup intent before rename, including signals after it succeeds.
        published=1
        mv -T -- "$stage" "$root"
        links_changed=1
        for command in $(tool_commands "$tool"); do
            link_command "$command" "$root/bin/$command"
        done
        write_marker "$tool" "$version" "$source"
        committed=1
    )
    ACTIVE_TEMP=""
}

install_tea() {
    local tool=tea json tag version filename url tmp
    require_amd64 "Tea"
    preflight_install "$tool"
    note "Installing Tea"

    json="$(curl_fetch metadata https://gitea.com/api/v1/repos/gitea/tea/releases/latest)"
    tag="$(printf '%s' "$json" | release_tag)" || die "could not resolve the latest Tea release"
    version="${tag#v}"
    filename="tea-${version}-linux-amd64"
    url="https://dl.gitea.com/tea/${version}/${filename}"

    new_temp_dir
    tmp="$ACTIVE_TEMP"
    mkdir -p "$tmp/bin"
    curl_fetch download "$url" "$tmp/$filename"
    curl_fetch metadata "$url.sha256" "$tmp/$filename.sha256"
    verify_listed_checksum "$tmp" "$filename.sha256" "$filename"
    install -m0755 "$tmp/$filename" "$tmp/bin/tea"
    rm -f -- "$tmp/$filename" "$tmp/$filename.sha256"
    "$tmp/bin/tea" --version </dev/null >/dev/null
    commit_static_install "$tool" "$tmp" "$version" "$url"
}

install_superfile() {
    local tool=superfile tag filename base tmp
    require_amd64 "Superfile"
    preflight_install "$tool"
    note "Installing Superfile"

    tag="$(latest_github_tag yorukot/superfile)"
    filename="superfile-linux-${tag}-amd64.tar.gz"
    base="https://github.com/yorukot/superfile/releases/download/${tag}"

    new_temp_dir
    tmp="$ACTIVE_TEMP"
    curl_fetch download "$base/$filename" "$tmp/$filename"
    curl_fetch metadata "$base/superfile-${tag}-checksums.txt" "$tmp/checksums.txt"
    verify_listed_checksum "$tmp" checksums.txt "$filename"
    tar -xzf "$tmp/$filename" -C "$tmp"
    mkdir -p "$tmp/bin"
    install -m0755 "$tmp/dist/superfile-linux-${tag}-amd64/spf" "$tmp/bin/spf"
    rm -rf -- "$tmp/dist" "$tmp/$filename" "$tmp/checksums.txt"
    "$tmp/bin/spf" --version </dev/null >/dev/null
    commit_static_install "$tool" "$tmp" "$tag" "$base"
}

install_nak() {
    local tool=nak asset tag url sha256 tmp
    require_amd64 "nak"
    preflight_install "$tool"
    note "Installing nak"

    asset="$(github_release_asset fiatjaf/nak 'nak-{tag}-linux-amd64')"
    IFS=$'\t' read -r tag url sha256 <<<"$asset"
    new_temp_dir
    tmp="$ACTIVE_TEMP"
    mkdir -p "$tmp/bin"
    curl_fetch download "$url" "$tmp/bin/nak"
    verify_sha256 "$tmp/bin/nak" "$sha256"
    chmod 0755 "$tmp/bin/nak"
    "$tmp/bin/nak" --version </dev/null >/dev/null
    commit_static_install "$tool" "$tmp" "$tag" "$url"
}

install_ngit() {
    local tool=ngit asset tag url sha256 filename tmp
    require_amd64 "ngit"
    preflight_install "$tool"
    note "Installing ngit"

    asset="$(github_release_asset DanConwayDev/ngit-cli 'ngit-{tag}-x86_64-unknown-linux-musl.tar.gz')"
    IFS=$'\t' read -r tag url sha256 <<<"$asset"
    filename="${url##*/}"
    new_temp_dir
    tmp="$ACTIVE_TEMP"
    curl_fetch download "$url" "$tmp/$filename"
    verify_sha256 "$tmp/$filename" "$sha256"
    mkdir -p "$tmp/extract" "$tmp/bin"
    tar -xzf "$tmp/$filename" -C "$tmp/extract"
    install -m0755 "$tmp/extract/ngit" "$tmp/bin/ngit"
    install -m0755 "$tmp/extract/git-remote-nostr" "$tmp/bin/git-remote-nostr"
    rm -rf -- "$tmp/extract" "$tmp/$filename"
    "$tmp/bin/ngit" --version </dev/null >/dev/null
    "$tmp/bin/git-remote-nostr" --version </dev/null >/dev/null
    commit_static_install "$tool" "$tmp" "$tag" "$url"
}

download_installer() {
    local url="$1"
    new_temp_dir
    curl_fetch metadata "$url" "$ACTIVE_TEMP/install.sh"
    chmod 0700 "$ACTIVE_TEMP/install.sh"
}

native_installer_url() {
    case "$1" in
        claude) echo "https://claude.ai/install.sh" ;;
        codex) echo "https://chatgpt.com/codex/install.sh" ;;
        opencode) echo "https://opencode.ai/install" ;;
    esac
}

native_executable() {
    case "$1" in
        claude|codex) echo "$BIN_DIR/$1" ;;
        opencode) echo "$(tool_root opencode)/opencode" ;;
    esac
}

# Check the native layout and print the first line of the installed version.
verify_native_install() {
    local tool="$1" executable output
    executable="$(native_executable "$tool")"
    [ -x "$executable" ] || die "$(tool_name "$tool") installer did not create $executable"
    launcher_is_managed "$tool" "$tool" ||
        die "$(tool_name "$tool") installer left an unexpected launcher at $BIN_DIR/$tool"
    output="$("$executable" --version </dev/null 2>/dev/null)" ||
        die "$(tool_name "$tool") did not start: $executable --version failed"
    output="${output%%$'\n'*}"
    [ -n "$output" ] || die "$(tool_name "$tool") did not report a version"
    printf '%s\n' "$output"
}

# Run a native installer or adoption step with its program files, launcher,
# and marker restorable. User authentication, configuration, and sessions
# live outside these paths and are never copied or rolled back.
with_native_rollback() {
    (
        local tool="$1" body="$2" source="${3:-}" root launcher marker backup version
        local started=0 committed=0
        root="$(tool_root "$tool")"
        launcher="$BIN_DIR/$tool"
        marker="$(state_file "$tool")"
        [ -n "$source" ] || source="$(native_installer_url "$tool")"
        mkdir -p "$MANAGED_ROOT" "$BIN_DIR"
        backup="$(mktemp -d "$MANAGED_ROOT/.rollback.XXXXXX")"

        rollback_native_install() {
            local result=$? restore_failed=0
            trap - EXIT
            # Staging belongs to this subshell; the caller never sees it.
            cleanup_active_temp || restore_failed=1
            rm -f -- "$marker.tmp.$$" "$launcher.monolith.$$" || restore_failed=1
            if [ "$started" -eq 1 ] && [ "$committed" -eq 0 ]; then
                if [ -e "$root" ] || [ -L "$root" ]; then
                    rm -rf -- "$root" || restore_failed=1
                fi
                if [ -e "$backup/root" ] || [ -L "$backup/root" ]; then
                    mv -T -- "$backup/root" "$root" || restore_failed=1
                fi
                if [ -e "$backup/launcher" ] || [ -L "$backup/launcher" ]; then
                    mv -Tf -- "$backup/launcher" "$launcher" || restore_failed=1
                else
                    rm -f -- "$launcher" || restore_failed=1
                fi
                if [ -f "$backup/marker" ]; then
                    mv -Tf -- "$backup/marker" "$marker" || restore_failed=1
                else
                    rm -f -- "$marker" || restore_failed=1
                fi
            fi
            if [ "$restore_failed" -eq 1 ]; then
                warn "could not fully restore $(tool_name "$tool"); recovery files were kept at $backup"
                exit 1
            fi
            rm -rf -- "$backup"
            exit "$result"
        }

        trap rollback_native_install EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        if [ -e "$root" ] || [ -L "$root" ]; then
            cp -a --reflink=auto -- "$root" "$backup/root"
        fi
        if [ -e "$launcher" ] || [ -L "$launcher" ]; then
            cp -a -- "$launcher" "$backup/launcher"
        fi
        if [ -f "$marker" ]; then
            cp -a -- "$marker" "$backup/marker"
        fi
        started=1
        "$body"
        version="$(verify_native_install "$tool")"
        write_marker "$tool" "$version" "$source"
        committed=1
    )
}

install_claude() {
    preflight_install claude
    note "Installing Claude Code with Anthropic's native installer"
    with_native_rollback claude install_native_claude
}

install_native_claude() {
    download_installer https://claude.ai/install.sh
    bash "$ACTIVE_TEMP/install.sh" stable 9>&-
}

install_codex() {
    preflight_install codex
    note "Installing Codex CLI with OpenAI's standalone installer"
    with_native_rollback codex install_native_codex
}

install_native_codex() {
    mkdir -p "$BIN_DIR" "$HOME/.codex"
    download_installer https://chatgpt.com/codex/install.sh
    # Pin the managed layout even when the caller uses another CODEX_HOME.
    env -u CODEX_RELEASE \
        PATH="$BIN_DIR:/usr/bin:/bin" \
        CODEX_HOME="$HOME/.codex" \
        CODEX_INSTALL_DIR="$BIN_DIR" \
        CODEX_NON_INTERACTIVE=true \
        bash "$ACTIVE_TEMP/install.sh" 9>&-
}

install_opencode() {
    preflight_install opencode
    note "Installing OpenCode with its upstream installer"
    with_native_rollback opencode install_native_opencode
}

install_native_opencode() {
    download_installer https://opencode.ai/install
    # The installer's current-version check must see only the managed copy.
    env -u VERSION \
        PATH="$(tool_root opencode):/usr/bin:/bin" \
        bash "$ACTIVE_TEMP/install.sh" --no-modify-path 9>&-
    link_native_opencode
}

link_native_opencode() {
    local executable
    executable="$(native_executable opencode)"
    [ -x "$executable" ] || die "OpenCode installer did not create $executable"
    link_command opencode "$executable"
}

install_omp() {
    local tool=omp tag filename=omp-linux-x64 base tmp
    require_amd64 "Oh My Pi"
    preflight_install "$tool"
    note "Installing Oh My Pi"

    tag="$(latest_github_tag can1357/oh-my-pi)"
    base="https://github.com/can1357/oh-my-pi/releases/download/$tag"
    new_temp_dir
    tmp="$ACTIVE_TEMP"
    curl_fetch download "$base/$filename" "$tmp/$filename"
    curl_fetch metadata "$base/SHA256SUMS.txt" "$tmp/SHA256SUMS.txt"
    verify_listed_checksum "$tmp" SHA256SUMS.txt "$filename"
    mkdir -p "$tmp/bin"
    install -m0755 "$tmp/$filename" "$tmp/bin/omp"
    rm -f -- "$tmp/$filename" "$tmp/SHA256SUMS.txt"
    "$tmp/bin/omp" --version </dev/null >/dev/null
    commit_static_install "$tool" "$tmp" "$tag" "$base"
}

install_herdr() {
    local tool=herdr output version tmp
    preflight_install "$tool"
    note "Installing Herdr with its upstream installer"
    download_installer https://herdr.dev/install.sh
    tmp="$ACTIVE_TEMP"
    mkdir -p "$tmp/bin"
    PATH="$tmp/bin:/usr/bin:/bin" \
        HERDR_INSTALL_DIR="$tmp/bin" \
        sh "$tmp/install.sh" 9>&-
    [ -x "$tmp/bin/herdr" ] || die "Herdr installer did not create $tmp/bin/herdr"
    output="$("$tmp/bin/herdr" --version </dev/null 2>/dev/null)" || die "Herdr did not start: herdr --version failed"
    version="${output%%$'\n'*}"
    rm -f -- "$tmp/install.sh"
    commit_static_install "$tool" "$tmp" "${version:-unknown}" "https://herdr.dev/install.sh"
}

# Every launcher of a static tool is a regular executable file, not a symlink.
launchers_are_programs() {
    local command path
    for command in $(tool_commands "$1"); do
        path="$BIN_DIR/$command"
        [ -f "$path" ] && [ ! -L "$path" ] && [ -x "$path" ] || return 1
    done
}

can_adopt() {
    local tool="$1"
    case "$tool" in
        tea|superfile|nak|ngit|omp|herdr)
            [ ! -e "$(tool_root "$tool")" ] && [ ! -L "$(tool_root "$tool")" ] &&
                launchers_are_programs "$tool"
            ;;
        claude|codex)
            [ -d "$(tool_root "$tool")" ] && launcher_is_managed "$tool" "$tool"
            ;;
        opencode)
            [ -x "$(native_executable opencode)" ] &&
                { [ ! -e "$BIN_DIR/opencode" ] && [ ! -L "$BIN_DIR/opencode" ] ||
                  launcher_is_managed opencode opencode; }
            ;;
        *)
            return 1
            ;;
    esac
}

# A managed tool whose launchers are now standalone programs, such as Herdr
# installed directly in ~/.local/bin by older Monolith versions and then
# updated by its own updater. These are adopted only on explicit request.
can_adopt_replaced() {
    local tool="$1"
    case "$tool" in
        tea|superfile|nak|ngit|omp|herdr) ;;
        *) return 1 ;;
    esac
    replaced_launcher "$tool" >/dev/null && launchers_are_programs "$tool"
}

adopt_replaced_tool() {
    local tool="$1" path
    if ! path="$(replaced_launcher "$tool")"; then
        die "$(tool_name "$tool") has no separate copy to adopt"
    fi
    can_adopt_replaced "$tool" ||
        die "$path is not a program Monolith can adopt; move it aside, then repair $(tool_name "$tool")"
    adopt_tool "$tool"
    install_tool "$tool"
}

adopt_tool() {
    local tool="$1" command primary output version stage executable
    note "Adopting the existing supported $(tool_name "$tool") installation"
    case "$tool" in
        tea|superfile|nak|ngit|omp|herdr)
            # Validate every program before copying or changing anything.
            for command in $(tool_commands "$tool"); do
                "$BIN_DIR/$command" --version </dev/null >/dev/null 2>&1 ||
                    die "$BIN_DIR/$command did not run with --version; move it aside before installing a managed copy"
            done
            primary="$(tool_commands "$tool")"
            primary="${primary%% *}"
            output="$("$BIN_DIR/$primary" --version </dev/null 2>/dev/null)"
            version="${output%%$'\n'*}"
            new_temp_dir
            stage="$ACTIVE_TEMP"
            mkdir -p "$stage/bin"
            for command in $(tool_commands "$tool"); do
                cp -p -- "$BIN_DIR/$command" "$stage/bin/$command"
            done
            commit_static_install "$tool" "$stage" "${version:-unknown}" "adopted-supported-layout"
            ;;
        claude|codex|opencode)
            executable="$(native_executable "$tool")"
            "$executable" --version </dev/null >/dev/null 2>&1 ||
                die "$executable did not run with --version; repair or remove it before adopting"
            if [ "$tool" = opencode ]; then
                with_native_rollback "$tool" link_native_opencode "adopted-supported-layout"
            else
                with_native_rollback "$tool" true "adopted-supported-layout"
            fi
            ;;
        *)
            die "$(tool_name "$tool") cannot be adopted"
            ;;
    esac
}

install_tool() {
    local tool="$1"
    is_known_tool "$tool" || die "unknown tool: $tool"
    if [ "$tool" = ghostty-themes ]; then
        ghostty_themes install
    elif is_gear_lever_app "$tool"; then
        install_gear_lever_app "$tool"
    else
        if ! has_marker "$tool" && can_adopt "$tool"; then
            adopt_tool "$tool"
        fi
        "install_$tool"
    fi
    printf '\nInstalled %s.\n' "$(tool_name "$tool")"
}

ghostty_themes() {
    command -v python3 >/dev/null 2>&1 || die "Ghostty Themes requires Python 3"
    [ -f "$GHOSTTY_THEMES_HELPER" ] || die "Ghostty theme helper is missing: $GHOSTTY_THEMES_HELPER"
    python3 "$GHOSTTY_THEMES_HELPER" "$@"
}

# Run the Gear Lever app helper for TOOL: status, info, install, or remove.
gear_lever_app() {
    local tool="$1" action="$2" scope=()
    command -v python3 >/dev/null 2>&1 || die "$(tool_name "$tool") requires Python 3"
    [ -f "$GEAR_LEVER_APP_HELPER" ] || die "Gear Lever app helper is missing: $GEAR_LEVER_APP_HELPER"
    case "$action" in
        install|remove) scope=(--scope "$GEAR_LEVER_SCOPE") ;;
    esac
    python3 "$GEAR_LEVER_APP_HELPER" "${scope[@]}" "$tool" "$action" 9>&-
}

gear_lever_app_policy() {
    case "$1" in
        wowup-cf)
            cat <<'EOF'
WowUp-CF release policy:
  - Added to Gear Lever; one supported existing integration is reused.
  - Follows only the 2.24.0 beta series (beta.6 or newer) until a compatible
    2.24.0 or newer stable exists, then moves permanently to stable releases.
  - WowUp-CF's Application Release Channel is set to Stable; addon release
    settings are unchanged.
  - Monolith, not Gear Lever, selects updates (monolith update wowup-cf).
EOF
            ;;
        r2modman)
            cat <<'EOF'
r2modman release policy:
  - Added to Gear Lever; one supported existing integration is reused.
  - Installs the newest stable release; prereleases are skipped.
  - Monolith, not Gear Lever, selects updates (monolith update r2modman);
    r2modman may also update itself to newer stable releases.
EOF
            ;;
    esac
}

# What removing TOOL keeps, as a noun phrase.
kept_data() {
    case "$1" in
        wowup-cf) echo "settings, game installations, and addons" ;;
        r2modman) echo "profiles, mods, and settings" ;;
        *) echo "settings, authentication, sessions, and project files" ;;
    esac
}

# Print the first Flatpak scope that has Gear Lever installed.
gear_lever_scope() {
    local scope
    for scope in user system; do
        if flatpak info "--$scope" "$GEAR_LEVER_ID" >/dev/null 2>&1; then
            printf '%s\n' "$scope"
            return 0
        fi
    done
    return 1
}

gear_lever_version() {
    local listing
    listing="$(flatpak list --app "--$1" --columns=application:f,version:f 2>/dev/null)" || return 0
    awk -F '\t' -v id="$GEAR_LEVER_ID" '$1 == id { print $2; exit }' <<<"$listing"
}

version_at_least() {
    local version="$1" minimum="$2"
    [[ "$version" =~ ^[0-9]+(\.[0-9]+)*$ ]] || return 1
    [ "$(printf '%s\n%s\n' "$minimum" "$version" | sort -V | head -n 1)" = "$minimum" ]
}

# Find Gear Lever for TOOL, offering a per-user Flathub install when it is
# missing. Runs in the action's own shell so prompts keep the caller's terminal.
ensure_gear_lever() {
    local name scope version answer=0
    name="$(tool_name "$1")"
    command -v flatpak >/dev/null 2>&1 ||
        die "$name needs Gear Lever, but the flatpak command is missing; repair Flatpak, then retry"
    if ! scope="$(gear_lever_scope)"; then
        if [ ! -t 0 ] || [ ! -t 1 ]; then
            die "$name needs Gear Lever. Install it with: flatpak install --user --noninteractive --assumeyes $GEAR_LEVER_REF"
        fi
        confirm_action "Gear Lever is missing. Install its Flathub Flatpak for your account?" \
            "$name is added to Gear Lever. No administrator password is needed." || answer=$?
        case "$answer" in
            0) ;;
            130) exit 130 ;;
            *)
                printf '%s was not changed because Gear Lever is required.\n' "$name" >&2
                exit 125
                ;;
        esac
        note "Installing Gear Lever from Flathub for your account"
        flatpak install --user --noninteractive --assumeyes "$GEAR_LEVER_REF" 9>&- ||
            die "Gear Lever could not be installed; $name was not changed"
        scope="$(gear_lever_scope)" || die "Gear Lever is still missing after installation; $name was not changed"
    fi
    version="$(gear_lever_version "$scope")"
    if ! version_at_least "$version" "$GEAR_LEVER_MIN_VERSION"; then
        die "$name needs Gear Lever $GEAR_LEVER_MIN_VERSION or newer, but the $scope installation reports '${version:-unknown}'. Update it with: flatpak update --$scope $GEAR_LEVER_ID"
    fi
    GEAR_LEVER_SCOPE="$scope"
}

install_gear_lever_app() {
    local tool="$1"
    require_amd64 "$(tool_name "$tool")"
    # The dashboard's details screen has already shown the policy.
    if ! has_marker "$tool" && [ "${MONOLITH_POLICY_SHOWN:-}" != 1 ]; then
        gear_lever_app_policy "$tool"
    fi
    ensure_gear_lever "$tool"
    gear_lever_app "$tool" install
}

remove_link_if_managed() {
    local command="$1" prefix="$2" path
    path="$BIN_DIR/$command"
    if link_points_under "$path" "$prefix"; then
        rm -f -- "$path"
    elif [ -e "$path" ] || [ -L "$path" ]; then
        warn "left $path in place because it no longer points to Monolith-managed files"
    fi
}

remove_tool() {
    local tool="$1" root marker command kept
    is_known_tool "$tool" || die "unknown tool: $tool"
    marker="$(state_file "$tool")"
    has_marker "$tool" || die "$(tool_name "$tool") is not managed by Monolith"
    root="$(tool_root "$tool")"

    note "Removing $(tool_name "$tool")"
    if [ "$tool" = ghostty-themes ]; then
        ghostty_themes remove
    elif is_gear_lever_app "$tool"; then
        ensure_gear_lever "$tool"
        gear_lever_app "$tool" remove
    else
        # Settings, logins, and sessions live outside the program roots.
        for command in $(tool_commands "$tool"); do
            remove_link_if_managed "$command" "$root"
        done
        if [ -e "$root" ] || [ -L "$root" ]; then
            safe_remove_tree "$root"
        fi
        case "$tool" in
            codex) rmdir -- "$HOME/.codex/packages" 2>/dev/null || true ;;
            opencode) rmdir -- "$HOME/.opencode" 2>/dev/null || true ;;
        esac
    fi

    rm -f -- "$marker"
    rmdir -- "$STATE_ROOT" "$STATE_HOME/monolith" 2>/dev/null || true
    rmdir -- "$MANAGED_ROOT" "$DATA_HOME/monolith" 2>/dev/null || true
    kept="$(kept_data "$tool")"
    printf '\nRemoved %s. %s were kept.\n' "$(tool_name "$tool")" "${kept^}"
}

# Serialize every mutation. The descriptor stays open until the action exits;
# third-party installers get it closed so a daemon cannot inherit the lock.
acquire_operation_lock() {
    mkdir -p "$STATE_ROOT"
    exec 9>>"$STATE_ROOT/.lock"
    flock -n 9 || die "Another Monolith software operation is running."
}

# Internal entry point for one action in its own process, where errexit
# protects the whole call tree.
internal_action() {
    local run
    [ "$#" -eq 2 ] || die "internal action needs an action and one tool ID"
    case "$1" in
        install) run=install_tool ;;
        remove) run=remove_tool ;;
        adopt) run=adopt_replaced_tool ;;
        *) die "unknown internal action: $1" ;;
    esac
    is_known_tool "$2" || die "unknown tool: $2"
    acquire_operation_lock
    "$run" "$2"
}

action_verb() {
    local action="$1" tool="$2"
    if [ "$action" = remove ]; then
        echo "Remove"
    elif [ "$action" = adopt ]; then
        echo "Adopt and update"
    elif is_gear_lever_app "$tool"; then
        case "$(tool_status "$tool" 2>/dev/null || true)" in
            installed) echo "Update" ;;
            "needs repair") echo "Repair" ;;
            external) echo "Adopt and update" ;;
            *) echo "Install" ;;
        esac
    elif has_marker "$tool"; then
        if is_managed "$tool"; then echo "Update"; else echo "Repair"; fi
    elif can_adopt "$tool"; then
        echo "Adopt and update"
    else
        echo "Install"
    fi
}

past_tense() {
    case "$1" in
        Install) echo "Installed" ;;
        Update) echo "Updated" ;;
        Repair) echo "Repaired" ;;
        "Adopt and update") echo "Adopted and updated" ;;
        Remove) echo "Removed" ;;
        *) echo "Done" ;;
    esac
}

# Run an action for each tool in a separate process. Ordinary failures do
# not stop later tools; Ctrl-C or TERM ends the batch.
run_actions() {
    local action="$1"
    shift
    local tools=("$@") total="$#" index=0 status verb tool failed=0 cancelled=0
    local names=() results=()

    case "$action" in
        install|remove|adopt) ;;
        *) die "internal error: unknown action: $action" ;;
    esac
    # Validate the whole request before any child starts.
    for tool in "${tools[@]}"; do
        is_known_tool "$tool" || die "unknown tool: $tool"
        if [ "$action" = remove ] && ! has_marker "$tool"; then
            die "$(tool_name "$tool") is not managed by Monolith"
        fi
    done

    RUN_INTERRUPTED=0
    trap 'RUN_INTERRUPTED=130' INT
    trap 'RUN_INTERRUPTED=143' TERM
    for tool in "${tools[@]}"; do
        index=$((index + 1))
        verb="$(action_verb "$action" "$tool")"
        printf '\n(%d/%d) %s — %s\n' "$index" "$total" "$(tool_name "$tool")" "$verb"
        status=0
        bash "$SELF" __action "$action" "$tool" || status=$?
        names+=("$(tool_name "$tool")")
        case "$status" in
            0) results+=("$(past_tense "$verb")") ;;
            125) results+=("Skipped by user"); failed=1 ;;
            130|143) results+=("Cancelled"); cancelled="$status" ;;
            *) results+=("Failed (exit $status)"); failed=1 ;;
        esac
        if [ "$cancelled" -eq 0 ] && [ "$RUN_INTERRUPTED" -ne 0 ]; then
            cancelled="$RUN_INTERRUPTED"
        fi
        if [ "$cancelled" -ne 0 ]; then
            break
        fi
    done
    trap 'cleanup_active_temp; exit 130' INT
    trap 'cleanup_active_temp; exit 143' TERM

    for tool in "${tools[@]:${#names[@]}}"; do
        names+=("$(tool_name "$tool")")
        results+=("Not run")
    done
    printf '\nResults:\n'
    for index in "${!names[@]}"; do
        printf '  %-16s %s\n' "${names[$index]}" "${results[$index]}"
    done
    if [ "$cancelled" -ne 0 ]; then
        printf '\nCancelled. Later items were not started.\n'
        return "$cancelled"
    fi
    if [ "$failed" -ne 0 ]; then
        printf '\nSome items did not complete; see the messages above.\n'
        return 1
    fi
}

update_tools() {
    local requested=("$@") selected=() tool
    if [ "${#requested[@]}" -eq 0 ]; then
        requested=("${ALL_TOOLS[@]}")
    fi
    for tool in "${requested[@]}"; do
        is_known_tool "$tool" || die "unknown tool: $tool"
        if [ "$#" -gt 0 ] && ! has_marker "$tool"; then
            die "$(tool_name "$tool") is not installed by Monolith"
        fi
    done
    for tool in "${requested[@]}"; do
        if has_marker "$tool"; then
            selected+=("$tool")
        fi
    done
    if [ "${#selected[@]}" -eq 0 ]; then
        echo "No Monolith-managed software is installed."
        return 0
    fi
    run_actions install "${selected[@]}"
}

# Print a short version from a managed command. Never runs unmanaged programs.
installed_version() {
    local tool="$1" primary output line pattern='([0-9]+\.[0-9]+(\.[0-9]+)?([-+][0-9A-Za-z.]+)?)'
    primary="$(tool_commands "$tool")"
    primary="${primary%% *}"
    [ -n "$primary" ] || return 1
    output="$(timeout 5 "$BIN_DIR/$primary" --version </dev/null 2>/dev/null)" || return 1
    line="${output%%$'\n'*}"
    if [[ "$line" =~ $pattern ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    elif [ -n "$line" ]; then
        printf '%.30s\n' "$line"
    else
        return 1
    fi
}

# Load a Gear Lever app's filesystem-only summary once per render.
load_app_info() {
    local tool="$1" json fields status version appimage desktop_id source channel lines=()
    APP_VERSION[$tool]="" APP_APPIMAGE[$tool]="" APP_DESKTOP_ID[$tool]="" APP_SOURCE[$tool]=""
    APP_CHANNEL[$tool]="" APP_ERROR[$tool]="" APP_CONFLICTS[$tool]=""
    if json="$(gear_lever_app "$tool" info 2>/dev/null)" && fields="$(printf '%s' "$json" | python3 -c '
import json, sys
data = json.load(sys.stdin)
if data.get("status") not in ("installed", "needs repair", "external", "not installed"):
    sys.exit(1)
def text(key):
    value = data.get(key)
    return "" if value is None else str(value).replace("\x1f", " ").replace("\n", " ")
print("\x1f".join(text(key) for key in ("status", "version", "appimage", "desktop_id", "source", "channel")))
for path in data.get("conflicts") or []:
    print(str(path).replace("\n", " "))
')"; then
        mapfile -t lines <<<"$fields"
        IFS=$'\x1f' read -r status version appimage desktop_id source channel <<<"${lines[0]}"
        ROW_STATUS[$tool]="$status"
        APP_VERSION[$tool]="$version"
        APP_APPIMAGE[$tool]="$appimage"
        APP_DESKTOP_ID[$tool]="$desktop_id"
        APP_SOURCE[$tool]="$source"
        APP_CHANNEL[$tool]="$channel"
        if [ "${#lines[@]}" -gt 1 ]; then
            APP_CONFLICTS[$tool]="$(printf '%s\n' "${lines[@]:1}")"
        fi
    else
        APP_ERROR[$tool]="Monolith could not inspect the $(tool_name "$tool") integration."
        if has_marker "$tool"; then
            ROW_STATUS[$tool]="needs repair"
        else
            ROW_STATUS[$tool]="not installed"
        fi
    fi
}

refresh_status() {
    local tool
    for tool in "$@"; do
        if is_gear_lever_app "$tool"; then
            load_app_info "$tool"
        else
            ROW_STATUS[$tool]="$(tool_status "$tool")"
        fi
    done
}

# Version text for a row: the managed program's own version, the receipt for
# themes and Gear Lever apps, or the marker labelled as last recorded.
display_version() {
    local tool="$1" status="${ROW_STATUS[$1]:-}" actual recorded
    if is_gear_lever_app "$tool"; then
        if [ -n "${APP_VERSION[$tool]}" ]; then printf 'verified %s\n' "${APP_VERSION[$tool]}"; else echo "-"; fi
        return 0
    elif [ "$tool" = ghostty-themes ]; then
        recorded="$(marker_version "$tool")"
        printf '%s\n' "${recorded:--}"
        return 0
    fi
    if [ "$status" = installed ] && actual="$(installed_version "$tool")"; then
        printf '%s\n' "$actual"
        return 0
    fi
    recorded="$(marker_version "$tool")"
    if [ -n "$recorded" ]; then printf 'recorded %s\n' "$recorded"; else echo "-"; fi
}

refresh_versions() {
    local tool
    for tool in "$@"; do
        ROW_VERSION[$tool]="$(display_version "$tool")"
    done
}

list_tools() {
    local tool
    refresh_status "${ALL_TOOLS[@]}"
    refresh_versions "${ALL_TOOLS[@]}"
    printf '%-16s  %-14s  %-14s  %s\n' "CATEGORY" "TOOL" "STATUS" "VERSION"
    printf '%-16s  %-14s  %-14s  %s\n' "----------------" "--------------" "--------------" "-------"
    for tool in "${ALL_TOOLS[@]}"; do
        printf '%-16s  %-14s  %-14s  %s\n' \
            "$(tool_category "$tool")" "$(tool_name "$tool")" "${ROW_STATUS[$tool]}" "${ROW_VERSION[$tool]}"
    done
}

fzf_available() {
    local path
    # command -v also reports a non-executable file when nothing else matches.
    path="$(command -v fzf 2>/dev/null)" || return 1
    [ -x "$path" ]
}

init_terminal_ui() {
    if [ "${MONOLITH_SELECTOR:-}" != numbered ] && [ "${TERM:-dumb}" != dumb ] && fzf_available; then
        SELECTOR=fzf
    fi
    if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ] && [ -t 1 ]; then
        USE_COLOR=1
    fi
}

fzf_color_options() {
    if [ "$USE_COLOR" -eq 1 ]; then
        printf '%s\n' --ansi
    else
        printf '%s\n' --color=bw
    fi
}

# Show numbered choices on stderr and print the selected option. Only the
# header's heading line applies here; its key help is for fzf.
# Returns 1 for 0, q, or end of input.
choose_numbered() {
    local prompt="$1" header="$2" answer index
    shift 2
    local options=("$@")
    while true; do
        printf '\n%s\n' "${header%%$'\n'*}" >&2
        for index in "${!options[@]}"; do
            printf '  %2d) %s\n' "$((index + 1))" "${options[$index]%%$'\t'*}" >&2
        done
        printf 'Enter a number; 0 or q goes back.\n' >&2
        if ! read -r -p "$prompt > " answer; then
            printf '\n' >&2
            return 1
        fi
        case "$answer" in
            0|q|Q) return 1 ;;
        esac
        if [[ "$answer" =~ ^[0-9]{1,4}$ ]] && [ "$((10#$answer))" -ge 1 ] &&
            [ "$((10#$answer))" -le "${#options[@]}" ]; then
            printf '%s\n' "${options[$((10#$answer - 1))]}"
            return 0
        fi
        printf 'Enter a number from the list, or 0 to go back.\n' >&2
    done
}

# Print the selected "label<TAB>action" option. Returns 1 for Back, 2 when
# nothing matched the filter, 3 when fzf failed, and 130 for Ctrl-C.
choose_line() {
    local prompt="$1" header="$2" output status=0 options=()
    shift 2
    if [ "$SELECTOR" != fzf ]; then
        choose_numbered "$prompt" "$header" "$@"
        return
    fi
    mapfile -t options < <(fzf_color_options)
    # Feed fzf without a pipeline so its own exit status is the one reported.
    output="$(fzf \
        "${options[@]}" \
        --layout=reverse \
        --border=rounded \
        --height='~70%' \
        --no-multi \
        --header-first \
        --header="$header" \
        --delimiter=$'\t' \
        --with-nth=1 \
        --prompt="$prompt > " \
        --bind='enter:accept' \
        --bind="ctrl-c:print($QUIT_TOKEN)+accept" < <(printf '%s\n' "$@"))" || status=$?
    if [ "${output%%$'\n'*}" = "$QUIT_TOKEN" ]; then
        return 130
    fi
    case "$status" in
        0)
            [ -n "$output" ] || return 2
            printf '%s\n' "$output"
            ;;
        1) return 2 ;;
        130) return 1 ;;
        *)
            printf 'Error: fzf failed with exit status %s; using numbered menus for this session.\n' "$status" >&2
            return 3
            ;;
    esac
}

# Select an option and store its action token in PICKED. Returns 1 for Back.
pick() {
    local choice status
    while true; do
        status=0
        choice="$(choose_line "$@")" || status=$?
        case "$status" in
            0)
                PICKED="${choice##*$'\t'}"
                return 0
                ;;
            2) ;;
            3)
                SELECTOR=numbered
                export MONOLITH_SELECTOR=numbered
                ;;
            130) exit 130 ;;
            *) return 1 ;;
        esac
    done
}

# Ask a default-No question. Returns 0 for yes, 1 for no, Esc, or end of
# input, and 130 for Ctrl-C.
confirm_action() {
    local question="$1" detail="${2:-}" answer status=0 header options=()
    if [ "$SELECTOR" = fzf ] && [ -t 0 ] && [ -t 1 ]; then
        header="$question"
        if [ -n "$detail" ]; then
            header="$header"$'\n'"$detail"
        fi
        mapfile -t options < <(fzf_color_options)
        answer="$(fzf \
            "${options[@]}" \
            --layout=reverse \
            --border=rounded \
            --height='~40%' \
            --no-multi \
            --header-first \
            --header="$header"$'\n'"Enter: confirm  ·  Esc: cancel" \
            --prompt='> ' \
            --bind='enter:accept' \
            --bind="ctrl-c:print($QUIT_TOKEN)+accept" < <(printf 'No\nYes\n'))" || status=$?
        if [ "${answer%%$'\n'*}" = "$QUIT_TOKEN" ]; then
            return 130
        fi
        case "$status" in
            0) [ "$answer" = Yes ]; return ;;
            1|130) return 1 ;;
        esac
        printf 'Error: fzf failed with exit status %s; asking in the terminal instead.\n' "$status" >&2
        SELECTOR=numbered
        export MONOLITH_SELECTOR=numbered
    fi
    if [ -n "$detail" ]; then
        printf '%s\n' "$detail"
    fi
    if ! read -r -p "$question [y/N] " answer; then
        printf '\n'
        return 1
    fi
    case "$answer" in
        y|Y|yes|Yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

pause_after_action() {
    [ -t 0 ] || return 0
    printf '\nPress Enter to return to the menu... '
    read -r _ || true
}

clear_screen() {
    if [ "$SELECTOR" = fzf ]; then
        printf '\033[H\033[2J'
    fi
}

status_badge() {
    local status="$1" color=""
    if [ "$USE_COLOR" -eq 1 ]; then
        case "$status" in
            installed) color=$'\033[32m' ;;
            "needs repair") color=$'\033[33m' ;;
            external) color=$'\033[36m' ;;
            *) color=$'\033[2m' ;;
        esac
        printf '%s%-13s\033[0m' "$color" "$status"
    else
        printf '%-13s' "$status"
    fi
}

row_label() {
    local tool="$1" prefix="${2:-}"
    printf '%-14s  %s  %-22.22s  %s%s' "$(tool_name "$tool")" "$(status_badge "${ROW_STATUS[$tool]}")" \
        "${ROW_VERSION[$tool]}" "$prefix" "$(tool_description "$tool")"
}

category_label() {
    local title="$1" tool installed=0 repair=0 names="" summary
    shift
    for tool in "$@"; do
        case "${ROW_STATUS[$tool]}" in
            installed) installed=$((installed + 1)) ;;
            "needs repair") repair=$((repair + 1)) ;;
        esac
        names="${names:+$names, }$(tool_name "$tool")"
    done
    summary="$installed installed"
    if [ "$repair" -gt 0 ]; then
        summary="$summary, $repair needs repair"
    fi
    printf '%-16s  %-28s  %s' "$title" "$summary" "$names"
}

menu_help() {
    printf '%s\n%s' "$1" "Enter: ${2:-open}  ·  Esc: ${3:-back}  ·  Type to filter  ·  Ctrl-C: quit"
}

# Run actions from the menu, show their results once, and keep the menu.
menu_actions() {
    run_actions "$@" || true
    pause_after_action
}

menu_update() {
    local tool selected=()
    for tool in "$@"; do
        if has_marker "$tool"; then
            selected+=("$tool")
        fi
    done
    if [ "${#selected[@]}" -eq 0 ]; then
        printf '\nNo Monolith-managed software is installed here.\n'
        pause_after_action
        return 0
    fi
    menu_actions install "${selected[@]}"
}

show_gear_lever_app_details() {
    local tool="$1" path
    if [ -n "${APP_ERROR[$tool]}" ]; then
        printf '\n%s\n' "${APP_ERROR[$tool]}"
    fi
    if [ -n "${APP_VERSION[$tool]}" ]; then
        printf 'Last verified version: %s\n' "${APP_VERSION[$tool]}"
    fi
    if [ -n "${APP_SOURCE[$tool]}" ]; then
        printf 'Source:   %s\n' "${APP_SOURCE[$tool]}"
    fi
    case "${APP_CHANNEL[$tool]}" in
        beta-bridge) printf 'Releases: 2.24.0 beta series until a compatible stable exists\n' ;;
        stable) printf 'Releases: stable\n' ;;
    esac
    if [ -n "${APP_APPIMAGE[$tool]}" ]; then
        printf 'AppImage: %s\n' "${APP_APPIMAGE[$tool]}"
    fi
    if [ -n "${APP_DESKTOP_ID[$tool]}" ]; then
        printf 'Launcher: %s (Gear Lever)\n' "${APP_DESKTOP_ID[$tool]}"
    fi
    if [ -n "${APP_CONFLICTS[$tool]}" ]; then
        printf '\nResolve these %s integrations in Gear Lever, then return here:\n' "$(tool_name "$tool")"
        while IFS= read -r path; do
            printf '  %s\n' "$path"
        done <<<"${APP_CONFLICTS[$tool]}"
    fi
    # Disclose the release policy where it is accepted: install and adoption.
    case "${ROW_STATUS[$tool]}" in
        "not installed"|external)
            printf '\n'
            gear_lever_app_policy "$tool"
            ;;
    esac
}

show_tool_details() {
    local tool="$1" status="${ROW_STATUS[$1]}" version="${ROW_VERSION[$1]}" command path
    printf '%s (%s)\n' "$(tool_name "$tool")" "$tool"
    printf 'Category: %s\n' "$(tool_category "$tool")"
    printf 'About:    %s\n' "$(tool_description "$tool")"
    printf 'Status:   %s\n' "$status"
    if is_gear_lever_app "$tool"; then
        show_gear_lever_app_details "$tool"
        return 0
    fi
    case "$tool" in
        ghostty-themes)
            if [ "$version" != "-" ]; then
                printf 'Bundle:   %s\n' "$version"
            fi
            printf 'Location: %s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/themes"
            return 0
            ;;
    esac
    case "$version" in
        -) ;;
        recorded\ *) printf 'Last recorded version: %s\n' "${version#recorded }" ;;
        *) printf 'Version:  %s\n' "$version" ;;
    esac
    if has_marker "$tool"; then
        path="$(tool_root "$tool")"
        if [ -e "$path" ]; then
            printf 'Location: %s\n' "$path"
        else
            printf 'Location: %s (missing)\n' "$path"
        fi
        for command in $(tool_commands "$tool"); do
            printf 'Command:  %s\n' "$BIN_DIR/$command"
        done
    else
        path="$(external_path "$tool")"
        if [ -n "$path" ]; then
            printf 'Found at: %s (not managed by Monolith)\n' "$path"
        fi
    fi
}

manage_tool() {
    local tool="$1" status conflict options=() answer kept
    while true; do
        refresh_status "$tool"
        refresh_versions "$tool"
        status="${ROW_STATUS[$tool]}"
        clear_screen
        show_tool_details "$tool"
        options=()
        case "$status" in
            installed)
                options+=("Update"$'\t'"install" "Remove"$'\t'"remove")
                ;;
            "needs repair")
                if conflict="$(replaced_launcher "$tool")"; then
                    if can_adopt_replaced "$tool"; then
                        printf '\n%s is a standalone copy outside Monolith'\''s managed layout.\n' "$conflict"
                        printf 'Adopt it so Monolith manages and updates it, or remove Monolith'\''s record and keep the file.\n'
                        options+=("Adopt this copy and update"$'\t'"adopt")
                    else
                        printf '\n%s no longer points to the Monolith-managed copy.\n' "$conflict"
                        printf 'Move it aside to repair, or remove the managed files and keep that command.\n'
                    fi
                else
                    options+=("Repair"$'\t'"install")
                fi
                options+=("Remove"$'\t'"remove")
                ;;
            *)
                if is_gear_lever_app "$tool"; then
                    if [ "$status" = external ] && [ -n "${APP_CONFLICTS[$tool]}" ]; then
                        :
                    elif [ "$status" = external ]; then
                        options+=("Adopt and update"$'\t'"install")
                    else
                        options+=("Install"$'\t'"install")
                    fi
                elif can_adopt "$tool"; then
                    printf '\nA supported installation was found; Monolith can adopt and update it.\n'
                    options+=("Adopt and update"$'\t'"install")
                elif conflict="$(local_destination_conflict "$tool")"; then
                    printf '\nBlocking path: %s\n' "$conflict"
                    printf 'It is not managed by Monolith. Move or uninstall it to install a managed copy.\n'
                elif [ "$status" = external ]; then
                    printf '\nA managed copy in %s would take precedence.\n' "$BIN_DIR"
                    options+=("Install a Monolith-managed copy"$'\t'"install")
                else
                    options+=("Install"$'\t'"install")
                fi
                ;;
        esac
        options+=("Back"$'\t'"back")
        printf '\n'
        pick "$(tool_name "$tool")" "$(menu_help "Actions for $(tool_name "$tool")" choose)" "${options[@]}" || return 0
        case "$PICKED" in
            install)
                MONOLITH_POLICY_SHOWN=1 menu_actions install "$tool"
                ;;
            adopt)
                menu_actions adopt "$tool"
                ;;
            remove)
                answer=0
                kept="$(kept_data "$tool")"
                confirm_action "Remove $(tool_name "$tool")?" "${kept^} are kept." || answer=$?
                case "$answer" in
                    0) menu_actions remove "$tool" ;;
                    130) exit 130 ;;
                esac
                ;;
            back)
                return 0
                ;;
        esac
    done
}

manage_category() {
    local title="$1" tool prefix=""
    shift
    local tools=("$@") options=()

    while true; do
        refresh_status "${tools[@]}"
        refresh_versions "${tools[@]}"
        options=()
        for tool in "${tools[@]}"; do
            if [ "$title" = "All applications" ]; then
                prefix="$(tool_category "$tool"): "
            fi
            options+=("$(row_label "$tool" "$prefix")"$'\t'"tool:$tool")
        done
        options+=("Update installed items"$'\t'"update")
        options+=("Back"$'\t'"back")

        clear_screen
        pick "$title" "$(menu_help "Monolith Software › $title" details)" "${options[@]}" || return 0
        case "$PICKED" in
            back) return 0 ;;
            update) menu_update "${tools[@]}" ;;
            tool:*) manage_tool "${PICKED#tool:}" ;;
        esac
    done
}

interactive_menu() {
    local options=() tool marked
    [ -t 0 ] && [ -t 1 ] || die "interactive mode needs a terminal; use list, install, remove, or update"

    while true; do
        refresh_status "${ALL_TOOLS[@]}"
        marked=0
        for tool in "${ALL_TOOLS[@]}"; do
            if has_marker "$tool"; then
                marked=$((marked + 1))
            fi
        done
        options=(
            "$(category_label "Developer CLIs" "${CLI_TOOLS[@]}")"$'\t'"cli"
            "$(category_label "AI coding" "${AI_TOOLS[@]}")"$'\t'"ai"
            "$(category_label "Gaming" "${GAMING_TOOLS[@]}")"$'\t'"gaming"
            "$(category_label "Appearance" "${APPEARANCE_TOOLS[@]}")"$'\t'"appearance"
            "All applications"$'\t'"all"
            "Update installed ($marked managed)"$'\t'"update"
            "Exit"$'\t'"exit"
        )
        clear_screen
        pick "Monolith Software" "$(menu_help "Monolith Software" open exit)" "${options[@]}" || return 0
        case "$PICKED" in
            cli) manage_category "Developer CLIs" "${CLI_TOOLS[@]}" ;;
            ai) manage_category "AI coding" "${AI_TOOLS[@]}" ;;
            gaming) manage_category "Gaming" "${GAMING_TOOLS[@]}" ;;
            appearance) manage_category "Appearance" "${APPEARANCE_TOOLS[@]}" ;;
            all) manage_category "All applications" "${ALL_TOOLS[@]}" ;;
            update) menu_update "${ALL_TOOLS[@]}" ;;
            exit) return 0 ;;
        esac
    done
}

usage() {
    cat <<'EOF'
Usage: monolith [command] [tool ...]

Without a command, opens the interactive software dashboard.

Commands:
  list                  Show every tool and its current state
  install TOOL [...]    Install, adopt, or update one or more tools
  remove TOOL [...]     Remove managed files; keep user settings and edited themes
  update [TOOL ...]     Update selected tools, or every managed tool
  help                  Show this help

Tool IDs:
  Developer CLIs   tea superfile nak ngit
  AI coding        claude codex opencode omp herdr
  Gaming           wowup-cf r2modman
  Appearance       ghostty-themes
EOF
}

main() {
    local command="${1:-menu}"
    [ "$#" -eq 0 ] || shift

    init_terminal_ui
    case "$command" in
        menu) interactive_menu ;;
        list) [ "$#" -eq 0 ] || die "list takes no tool arguments"; list_tools ;;
        install)
            [ "$#" -gt 0 ] || die "install needs at least one tool ID"
            run_actions install "$@"
            ;;
        remove|uninstall)
            [ "$#" -gt 0 ] || die "remove needs at least one tool ID"
            run_actions remove "$@"
            ;;
        update) update_tools "$@" ;;
        __action) internal_action "$@" ;;
        help|-h|--help) usage ;;
        *) die "unknown command: $command (run monolith help)" ;;
    esac
}

main "$@"
