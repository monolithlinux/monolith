#!/usr/bin/bash
# Former name of the system commands, which `monolith` runs now. Kept so old
# habits keep working: `mjust` on its own lists every command, and
# `mjust update` is `monolith update`.
monolith="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/monolith"
if [ "$#" -eq 0 ]; then
    exec "$monolith" help
fi
exec "$monolith" "$@"
