@dataclasses.dataclass(frozen=True)
class Link:
    label: str
    url: str


@dataclasses.dataclass(frozen=True)
class Announcement:
    id: str
    date: datetime.date
    title: str
    category: str | None
    install_path: tuple[str, ...]
    body: str
    note: str | None
    links: tuple[Link, ...]


@dataclasses.dataclass(frozen=True)
class FeedResult:
    announcements: tuple[Announcement, ...]
    source: str  # "network" | "cache" | "none"


@dataclasses.dataclass(frozen=True)
class NewsState:
    # Listed in a window that was then closed; only other ids open News at login.
    dismissed: frozenset[str]
    # Opened in the reading pane or marked read.
    read: frozenset[str]


class FeedError(ValueError):
    """The feed as a whole cannot be used."""


def warn(message: str) -> None:
    # Autostart stderr lands in the user journal.
    print(f"monolith-news: {message}", file=sys.stderr)


def xdg_dir(variable: str, default: str) -> Path:
    # The XDG base directory spec says to ignore relative values.
    path = Path(os.environ.get(variable, ""))
    return path if path.is_absolute() else Path.home() / default


def state_path() -> Path:
    return xdg_dir("XDG_STATE_HOME", ".local/state") / "monolith/news/state.json"


def cache_path() -> Path:
    return xdg_dir("XDG_CACHE_HOME", ".cache") / "monolith/news/announcements.toml"


def login_override_path() -> Path:
    return xdg_dir("XDG_CONFIG_HOME", ".config") / "autostart/monolith-news.desktop"


def atomic_write(path: Path, data: bytes) -> None:
    """Replace a file only with complete contents."""
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, name = tempfile.mkstemp(prefix=".monolith-news-", dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, "wb") as file:
            file.write(data)
            file.flush()
            os.fsync(file.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


@contextlib.contextmanager
def locked(directory: Path):
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def one_line(value: object, limit: int) -> str | None:
    """Return value stripped if it is one line of 1-limit characters."""
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not 0 < len(text) <= limit or "\n" in text or "\r" in text:
        return None
    return text


def optional_line(entry: dict, key: str, limit: int) -> str | None:
    value = entry.get(key)
    if value is None:
        return None
    text = one_line(value, limit)
    if text is None:
        raise ValueError(f"{key} must be one line of 1-{limit} characters")
    return text


def parse_announcement(entry: object) -> Announcement:
    """Validate one feed entry; ValueError says why it cannot be shown."""
    if not isinstance(entry, dict):
        raise ValueError("not a table")
    identifier = entry.get("id")
    if not isinstance(identifier, str) or not ID_PATTERN.fullmatch(identifier):
        raise ValueError("id must be 1-64 lowercase letters, digits, or hyphens")
    date = entry.get("date")
    # Date-times load as datetime.datetime, a subclass of datetime.date.
    if type(date) is not datetime.date:
        raise ValueError("date must be a plain date such as 2026-01-31")
    title = one_line(entry.get("title"), MAX_TITLE_CHARS)
    if title is None:
        raise ValueError(f"title must be one line of 1-{MAX_TITLE_CHARS} characters")
    category = optional_line(entry, "category", MAX_CATEGORY_CHARS)
    steps = entry.get("install_path", [])
    if not isinstance(steps, list) or len(steps) > MAX_INSTALL_STEPS:
        raise ValueError(f"install_path must be a list of at most {MAX_INSTALL_STEPS} steps")
    install_path = tuple(one_line(step, MAX_STEP_CHARS) for step in steps)
    if None in install_path:
        raise ValueError(f"install_path steps must be one line of 1-{MAX_STEP_CHARS} characters")
    body = entry.get("body")
    if not isinstance(body, str) or not body.strip():
        raise ValueError("body must be non-empty text")
    note = optional_line(entry, "note", MAX_NOTE_CHARS)
    links = entry.get("links", [])
    if not isinstance(links, list) or len(links) > MAX_LINKS:
        raise ValueError(f"links must be a list of at most {MAX_LINKS} tables")
    parsed = []
    for link in links:
        if not isinstance(link, dict):
            raise ValueError("each link must be a table")
        label = one_line(link.get("label"), MAX_LABEL_CHARS)
        if label is None:
            raise ValueError(f"link labels must be one line of 1-{MAX_LABEL_CHARS} characters")
        url = link.get("url")
        if not isinstance(url, str) or not URL_PATTERN.fullmatch(url):
            raise ValueError("link urls must start with https:// and contain no spaces")
        parsed.append(Link(label, url))
    return Announcement(id=identifier, date=date, title=title, category=category,
                        install_path=install_path, body=body.strip(), note=note,
                        links=tuple(parsed))


def parse_feed(data: bytes) -> tuple[list[Announcement], list[str]]:
    """Return valid announcements, newest first, and why others were skipped."""
    if len(data) > MAX_FEED_BYTES:
        raise FeedError(f"feed is larger than {MAX_FEED_BYTES} bytes")
    try:
        document = tomllib.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise FeedError(f"feed is not valid TOML: {error}") from error
    entries = document.get("announcements")
    if not isinstance(entries, list):
        raise FeedError("feed has no announcements array; use announcements = [] for none")
    valid = []
    problems = []
    ids = set()
    for index, entry in enumerate(entries, 1):
        try:
            announcement = parse_announcement(entry)
        except ValueError as error:
            problems.append(f"announcement {index}: {error}")
            continue
        if announcement.id in ids:
            problems.append(f"announcement {index}: duplicate id {announcement.id}")
            continue
        ids.add(announcement.id)
        valid.append(announcement)
    # Stable: entries with the same date keep their file order.
    return sorted(valid, key=lambda a: a.date, reverse=True), problems


def download_feed(url: str) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=FETCH_TIMEOUT_SECONDS) as response:
        # parse_feed rejects the extra byte, so oversized feeds never reach the cache.
        return response.read(MAX_FEED_BYTES + 1)


def load_cached_feed() -> list[Announcement] | None:
    path = cache_path()
    try:
        announcements, _problems = parse_feed(path.read_bytes())
    except FileNotFoundError:
        return None
    except (OSError, FeedError) as error:
        warn(f"ignoring saved announcements {path}: {error}")
        return None
    return announcements


def refresh_feed(attempts: int) -> FeedResult:
    """Download the feed, falling back to the last valid download."""
    for attempt in range(1, attempts + 1):
        try:
            data = download_feed(FEED_URL)
        except urllib.error.HTTPError as error:
            # The server answered, so retrying will not help.
            error.close()
            warn(f"could not download announcements: {error}")
            break
        except (OSError, http.client.HTTPException) as error:
            if attempt < attempts:
                time.sleep(LOGIN_RETRY_SECONDS)
                continue
            warn(f"could not download announcements: {error}")
            break
        try:
            announcements, problems = parse_feed(data)
        except FeedError as error:
            warn(f"ignoring downloaded announcements: {error}")
            break
        for problem in problems:
            warn(f"skipped {problem}")
        try:
            atomic_write(cache_path(), data)
        except OSError as error:
            warn(f"could not save announcements: {error}")
        return FeedResult(tuple(announcements), "network")
    cached = load_cached_feed()
    if cached is not None:
        return FeedResult(tuple(cached), "cache")
    return FeedResult((), "none")


def string_list(value: object) -> bool:
    return isinstance(value, list) and all(isinstance(item, str) for item in value)


def load_state() -> NewsState:
    path = state_path()
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return NewsState(frozenset(), frozenset())
    except (OSError, ValueError):
        state = None
    if isinstance(state, dict) and state.get("version") == 1:
        dismissed = state.get("dismissed")
        # Releases before the reading pane saved only dismissals, and their window
        # showed every announcement in full.
        read = state.get("read", dismissed)
        if string_list(dismissed) and string_list(read):
            return NewsState(frozenset(dismissed), frozenset(read))
    # Showing announcements again is the safe failure.
    warn(f"ignoring invalid state file {path}")
    return NewsState(frozenset(), frozenset())


def save_state(dismissed, read) -> None:
    # Never prune ids missing from the feed; a reverted commit would reopen them.
    path = state_path()
    with locked(path.parent):
        saved = load_state()
        state = {"version": 1, "dismissed": sorted(saved.dismissed | set(dismissed)),
                 "read": sorted(saved.read | set(read))}
        atomic_write(path, (json.dumps(state, indent=2) + "\n").encode())


def unseen(announcements, dismissed) -> list[Announcement]:
    return [a for a in announcements if a.id not in dismissed]


def login_check_enabled() -> bool:
    """Honor the user copy that Plasma's Autostart page and the switch manage."""
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.optionxform = str
    try:
        if not parser.read(login_override_path(), encoding="utf-8"):
            return True
        return not parser.getboolean("Desktop Entry", "Hidden", fallback=False)
    except (configparser.Error, ValueError):
        return True


def set_login_check(enabled: bool) -> None:
    path = login_override_path()
    if enabled:
        path.unlink(missing_ok=True)
    else:
        atomic_write(path, LOGIN_OVERRIDE.encode())


def widget_classes():
    """Define the window's painted widgets; Qt loads only when a window opens."""
    from PySide6 import QtCore, QtGui, QtWidgets
    Qt = QtCore.Qt
    policy = QtWidgets.QSizePolicy.Policy
    left = Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter
    wrapped = (Qt.AlignmentFlag.AlignLeft.value | Qt.AlignmentFlag.AlignTop.value
               | Qt.TextFlag.TextWordWrap.value)
    antialiasing = QtGui.QPainter.RenderHint.Antialiasing

    def wrapped_box(metrics, text, width):
        return metrics.boundingRect(QtCore.QRect(0, 0, width, 1 << 16), wrapped, text)

    def balanced_width(metrics, text, width):
        """Return the narrowest width that keeps text's line count (CSS text-wrap: balance)."""
        height = wrapped_box(metrics, text, width).height()
        low, high = 1, max(1, width)
        while low < high:
            middle = (low + high) // 2
            box = wrapped_box(metrics, text, middle)
            if box.height() <= height and box.width() <= middle:
                high = middle
            else:
                low = middle + 1
        return low

    def cursor_x(line, position):
        x = line.cursorToX(position)
        return x[0] if isinstance(x, tuple) else x

    class TextButton(QtWidgets.QAbstractButton):
        """A flat button drawn to the design, with an optional trailing arrow."""

        ARROW = "↗"
        ARROW_GAP = 6
        RADIUS = 6

        def __init__(self, text, font, *, ink, hover_ink, fill=None, hover_fill=None,
                     border=None, padding=(0, 0), arrow=False, focus=Color.ACCENT):
            super().__init__()
            # Show & literally instead of as a keyboard mnemonic.
            self.setText(text.replace("&", "&&"))
            self.label = text
            self.setFont(font)
            self.inks = (ink, hover_ink)
            self.fills = (fill, hover_fill)
            self.border = border
            self.arrow = arrow
            self.focus = focus
            edge = 1 if border else 0
            self.setContentsMargins(padding[0] + edge, padding[1] + edge,
                                    padding[0] + edge, padding[1] + edge)
            self.setSizePolicy(policy.Fixed, policy.Fixed)
            self.setCursor(Qt.CursorShape.PointingHandCursor)
            # Clicks leave no focus ring; Tab still reaches the button.
            self.setFocusPolicy(Qt.FocusPolicy.TabFocus)
            self.setAttribute(Qt.WidgetAttribute.WA_Hover)

        def sizeHint(self):
            metrics = self.fontMetrics()
            width = metrics.horizontalAdvance(self.label)
            if self.arrow:
                width += self.ARROW_GAP + metrics.horizontalAdvance(self.ARROW)
            margins = self.contentsMargins()
            return QtCore.QSize(width + margins.left() + margins.right(),
                                metrics.height() + margins.top() + margins.bottom())

        def minimumSizeHint(self):
            return self.sizeHint()

        def event(self, event):
            if event.type() in (QtCore.QEvent.Type.HoverEnter, QtCore.QEvent.Type.HoverLeave):
                self.update()
            return super().event(event)

        def keyPressEvent(self, event):
            if event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
                self.click()
            else:
                super().keyPressEvent(event)

        def paintEvent(self, _event):
            painter = QtGui.QPainter(self)
            painter.setRenderHint(antialiasing)
            hot = self.isDown() or self.underMouse()
            fill = self.fills[hot]
            outline = self.focus if self.hasFocus() else self.border
            if fill or outline:
                painter.setPen(QtGui.QPen(QtGui.QColor(outline), 1) if outline else Qt.PenStyle.NoPen)
                painter.setBrush(QtGui.QColor(fill) if fill else Qt.BrushStyle.NoBrush)
                box = QtCore.QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
                painter.drawRoundedRect(box, self.RADIUS, self.RADIUS)
            area = QtCore.QRectF(self.contentsRect())
            painter.setPen(QtGui.QColor(self.inks[hot]))
            painter.drawText(area, left, self.label)
            if self.arrow:
                area.setLeft(area.left() + self.fontMetrics().horizontalAdvance(self.label)
                             + self.ARROW_GAP)
                painter.setPen(QtGui.QColor(Color.MUTED))
                painter.drawText(area, left, self.ARROW)

    class LoginSwitch(QtWidgets.QAbstractButton):
        """A switch whose label is part of what you click."""

        TRACK_WIDTH, TRACK_HEIGHT, KNOB, KNOB_INSET, GAP, RING = 32, 18, 14, 2, 10, 2

        def __init__(self, text, font, checked):
            super().__init__()
            self.setText(text)
            self.setFont(font)
            self.setCheckable(True)
            self.setChecked(checked)
            self.setSizePolicy(policy.Fixed, policy.Fixed)
            self.setCursor(Qt.CursorShape.PointingHandCursor)
            self.setFocusPolicy(Qt.FocusPolicy.TabFocus)
            self.slide = QtCore.QVariantAnimation(self)
            self.slide.setDuration(150)
            self.slide.valueChanged.connect(lambda _value: self.update())
            self.toggled.connect(self.animate)

        def running(self):
            return self.slide.state() == QtCore.QAbstractAnimation.State.Running

        def animate(self, checked):
            start = self.slide.currentValue() if self.running() else (0.0 if checked else 1.0)
            self.slide.stop()
            self.slide.setStartValue(float(start))
            self.slide.setEndValue(1.0 if checked else 0.0)
            self.slide.start()

        def sizeHint(self):
            metrics = self.fontMetrics()
            width = (2 * self.RING + self.TRACK_WIDTH + self.GAP
                     + metrics.horizontalAdvance(self.text()))
            return QtCore.QSize(width, max(self.TRACK_HEIGHT + 2 * self.RING, metrics.height()))

        def paintEvent(self, _event):
            painter = QtGui.QPainter(self)
            painter.setRenderHint(antialiasing)
            # The animation runs only while sliding; otherwise follow the state.
            on = self.slide.currentValue() if self.running() else float(self.isChecked())
            off_color, on_color = QtGui.QColor(Color.SWITCH_OFF), QtGui.QColor(Color.ACCENT)
            track_color = QtGui.QColor.fromRgbF(
                *(a + (b - a) * on for a, b in zip(off_color.getRgbF()[:3], on_color.getRgbF()[:3])))
            top = (self.height() - self.TRACK_HEIGHT) / 2
            track = QtCore.QRectF(self.RING, top, self.TRACK_WIDTH, self.TRACK_HEIGHT)
            radius = self.TRACK_HEIGHT / 2
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(track_color)
            painter.drawRoundedRect(track, radius, radius)
            travel = self.TRACK_WIDTH - self.KNOB - 2 * self.KNOB_INSET
            painter.setBrush(QtGui.QColor(Color.WHITE))
            painter.drawEllipse(QtCore.QRectF(track.left() + self.KNOB_INSET + travel * on,
                                              top + self.KNOB_INSET, self.KNOB, self.KNOB))
            if self.hasFocus():
                painter.setPen(QtGui.QPen(QtGui.QColor(Color.TEXT), 1))
                painter.setBrush(Qt.BrushStyle.NoBrush)
                ring = track.adjusted(-1.5, -1.5, 1.5, 1.5)
                painter.drawRoundedRect(ring, radius + 1.5, radius + 1.5)
            painter.setPen(QtGui.QColor(Color.SECONDARY))
            text = QtCore.QRectF(self.rect())
            text.setLeft(track.right() + self.GAP)
            painter.drawText(text, left, self.text())

    class Pill(QtWidgets.QWidget):
        """The NEW badge beside an announcement's date."""

        def __init__(self, text, font):
            super().__init__()
            self.label = text
            self.setFont(font)
            self.setSizePolicy(policy.Fixed, policy.Fixed)
            self.setAccessibleName(text)

        def sizeHint(self):
            metrics = self.fontMetrics()
            return QtCore.QSize(metrics.horizontalAdvance(self.label) + 16, metrics.height() + 4)

        def paintEvent(self, _event):
            painter = QtGui.QPainter(self)
            painter.setRenderHint(antialiasing)
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QtGui.QColor(Color.PILL))
            radius = self.height() / 2
            painter.drawRoundedRect(QtCore.QRectF(self.rect()), radius, radius)
            painter.setPen(QtGui.QColor(Color.ACCENT_LIGHT))
            painter.drawText(self.rect(), Qt.AlignmentFlag.AlignCenter, self.label)

    class InfoIcon(QtWidgets.QWidget):
        """The note's ⓘ, drawn so it never depends on a font's symbol coverage."""

        def __init__(self, diameter, line_height):
            super().__init__()
            self.diameter = diameter
            self.setFixedSize(diameter, line_height)

        def paintEvent(self, _event):
            painter = QtGui.QPainter(self)
            painter.setRenderHint(antialiasing)
            color = QtGui.QColor(Color.ACCENT)
            top = (self.height() - self.diameter) / 2
            circle = QtCore.QRectF(0.6, top + 0.6, self.diameter - 1.2, self.diameter - 1.2)
            painter.setPen(QtGui.QPen(color, 1.2))
            painter.drawEllipse(circle)
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(color)
            middle = circle.center().x()
            painter.drawEllipse(QtCore.QPointF(middle, circle.top() + circle.height() * 0.28), 0.9, 0.9)
            painter.drawRect(QtCore.QRectF(middle - 0.6, circle.top() + circle.height() * 0.42,
                                           1.2, circle.height() * 0.36))

    class Heading(QtWidgets.QWidget):
        """An announcement title that wraps into balanced lines."""

        def __init__(self, text, font, ink):
            super().__init__()
            self.label = text
            self.ink = ink
            self.setFont(font)
            self.setAccessibleName(text)
            size_policy = QtWidgets.QSizePolicy(policy.Ignored, policy.Preferred)
            size_policy.setHeightForWidth(True)
            self.setSizePolicy(size_policy)

        def hasHeightForWidth(self):
            return True

        def heightForWidth(self, width):
            return wrapped_box(self.fontMetrics(), self.label, width).height()

        def sizeHint(self):
            metrics = self.fontMetrics()
            return QtCore.QSize(metrics.horizontalAdvance(self.label), metrics.height())

        def paintEvent(self, _event):
            painter = QtGui.QPainter(self)
            painter.setPen(QtGui.QColor(self.ink))
            width = balanced_width(self.fontMetrics(), self.label, self.width())
            painter.drawText(QtCore.QRect(0, 0, width, self.height()), wrapped, self.label)

    class Body(QtWidgets.QTextBrowser):
        """Markdown that grows with its text, so only the reading pane scrolls."""

        CHIP_PAD = 6
        CHIP_RADIUS = 4

        def __init__(self, document, chips, chip_font, has_links):
            super().__init__()
            document.setParent(self)
            self.setDocument(document)
            # Document positions of inline code, drawn as chips behind the text.
            self.chips = chips
            self.chip_metrics = QtGui.QFontMetricsF(chip_font)
            self.setFrameShape(QtWidgets.QFrame.Shape.NoFrame)
            self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
            self.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
            # Long words and URLs wrap instead of widening the reading pane.
            self.setWordWrapMode(QtGui.QTextOption.WrapMode.WrapAtWordBoundaryOrAnywhere)
            self.setOpenLinks(False)
            # Tab reaches the body only when it has links to follow.
            self.setFocusPolicy(Qt.FocusPolicy.StrongFocus if has_links
                                else Qt.FocusPolicy.ClickFocus)
            self.viewport().setAutoFillBackground(False)
            self.setSizePolicy(policy.Ignored, policy.Fixed)
            document.documentLayout().documentSizeChanged.connect(
                lambda size: self.setFixedHeight(math.ceil(size.height())))

        def wheelEvent(self, event):
            # The body never scrolls itself, so the wheel goes on to the reading pane.
            event.ignore()

        def chip_rects(self, start, end):
            block = self.document().findBlock(start)
            layout = block.layout()
            origin = layout.position()
            first, last = start - block.position(), end - block.position()
            ascent, descent = self.chip_metrics.ascent(), self.chip_metrics.descent()
            line = layout.lineForTextPosition(first)
            while line.isValid() and line.textStart() < last:
                # The padding sits in letter spacing that run_gui reserves around the code.
                x1 = origin.x() + cursor_x(line, max(first, line.textStart())) - self.CHIP_PAD
                x2 = origin.x() + cursor_x(line, min(last, line.textStart() + line.textLength()))
                baseline = origin.y() + line.y() + line.ascent()
                yield QtCore.QRectF(max(0.0, x1), baseline - ascent - 1, x2 - max(0.0, x1),
                                    ascent + descent + 2)
                line = layout.lineAt(line.lineNumber() + 1)

        def paintEvent(self, event):
            painter = QtGui.QPainter(self.viewport())
            painter.setRenderHint(antialiasing)
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QtGui.QColor(Color.CODE))
            for start, end in self.chips:
                for rect in self.chip_rects(start, end):
                    painter.drawRoundedRect(rect, self.CHIP_RADIUS, self.CHIP_RADIUS)
            painter.end()
            super().paintEvent(event)

    class FlowLayout(QtWidgets.QLayout):
        """Place widgets in rows that wrap, like the design's link buttons."""

        def __init__(self, spacing):
            super().__init__()
            self.entries = []
            self.gap = spacing
            self.setContentsMargins(0, 0, 0, 0)

        def addItem(self, item):
            self.entries.append(item)

        def count(self):
            return len(self.entries)

        def itemAt(self, index):
            return self.entries[index] if 0 <= index < len(self.entries) else None

        def takeAt(self, index):
            return self.entries.pop(index) if 0 <= index < len(self.entries) else None

        def expandingDirections(self):
            return Qt.Orientation(0)

        def hasHeightForWidth(self):
            return True

        def heightForWidth(self, width):
            return self.arrange(QtCore.QRect(0, 0, width, 0), move=False)

        def setGeometry(self, rect):
            super().setGeometry(rect)
            self.arrange(rect, move=True)

        def sizeHint(self):
            return self.minimumSize()

        def minimumSize(self):
            size = QtCore.QSize()
            for item in self.entries:
                size = size.expandedTo(item.minimumSize())
            return size

        def arrange(self, rect, move):
            x, y, row_height = rect.x(), rect.y(), 0
            for item in self.entries:
                hint = item.sizeHint()
                if row_height and x + hint.width() > rect.right() + 1:
                    x, y, row_height = rect.x(), y + row_height + self.gap, 0
                if move:
                    item.setGeometry(QtCore.QRect(QtCore.QPoint(x, y), hint))
                x += hint.width() + self.gap
                row_height = max(row_height, hint.height())
            return y + row_height - rect.y()

    class NewsList(QtWidgets.QListWidget):
        def __init__(self):
            super().__init__()
            # The design's list padding; a margin keeps it outside the items' hit area.
            self.setViewportMargins(8, 0, 8, 8)

    class NewsDelegate(QtWidgets.QStyledItemDelegate):
        """Draw an announcement: unread dot, balanced title, short date and category."""

        PAD, RIGHT, DOT, DOT_TOP, DOT_GAP, LINE_GAP, ITEM_GAP, RADIUS = 12, 10, 7, 7, 10, 4, 2, 7
        UNREAD = Qt.ItemDataRole.UserRole.value + 1
        META = Qt.ItemDataRole.UserRole.value + 2

        def __init__(self, view, title_font, meta_font):
            super().__init__(view)
            self.view = view
            self.title_font = title_font
            self.meta_font = meta_font
            self.balanced = {}

        def text_width(self, item_width):
            return int(item_width) - self.PAD - self.DOT - self.DOT_GAP - self.RIGHT

        def sizeHint(self, _option, index):
            width = self.view.viewport().width()
            title = wrapped_box(QtGui.QFontMetrics(self.title_font), index.data(),
                                self.text_width(width)).height()
            meta = QtGui.QFontMetrics(self.meta_font).height()
            return QtCore.QSize(width, 2 * self.PAD + title + self.LINE_GAP + meta + self.ITEM_GAP)

        def paint(self, painter, option, index):
            painter.save()
            painter.setRenderHint(antialiasing)
            box = QtCore.QRectF(option.rect).adjusted(0, 0, 0, -self.ITEM_GAP)
            current = index.row() == self.view.currentRow()
            unread = bool(index.data(self.UNREAD))
            if current:
                painter.setPen(QtGui.QPen(QtGui.QColor(Color.RING), 1))
                painter.setBrush(QtGui.QColor(Color.SELECTED))
                painter.drawRoundedRect(box.adjusted(0.5, 0.5, -0.5, -0.5), self.RADIUS, self.RADIUS)
            elif option.state & QtWidgets.QStyle.StateFlag.State_MouseOver:
                painter.setPen(Qt.PenStyle.NoPen)
                painter.setBrush(QtGui.QColor(Color.HOVER))
                painter.drawRoundedRect(box, self.RADIUS, self.RADIUS)
            top = box.top() + self.PAD
            if unread:
                painter.setPen(Qt.PenStyle.NoPen)
                painter.setBrush(QtGui.QColor(Color.ACCENT))
                painter.drawEllipse(QtCore.QRectF(box.left() + self.PAD, top + self.DOT_TOP,
                                                  self.DOT, self.DOT))
            text_left = box.left() + self.PAD + self.DOT + self.DOT_GAP
            width = self.text_width(box.width())
            title = index.data()
            metrics = QtGui.QFontMetrics(self.title_font)
            title_height = wrapped_box(metrics, title, width).height()
            if (title, width) not in self.balanced:
                self.balanced[title, width] = balanced_width(metrics, title, width)
            painter.setFont(self.title_font)
            painter.setPen(QtGui.QColor(Color.TEXT if unread or current else Color.TERTIARY))
            painter.drawText(QtCore.QRectF(text_left, top, self.balanced[title, width], title_height),
                             wrapped, title)
            metrics = QtGui.QFontMetrics(self.meta_font)
            meta = metrics.elidedText(index.data(self.META), Qt.TextElideMode.ElideRight, width)
            painter.setFont(self.meta_font)
            painter.setPen(QtGui.QColor(Color.MUTED))
            painter.drawText(QtCore.QRectF(text_left, top + title_height + self.LINE_GAP, width,
                                           metrics.height()), left, meta)
            painter.restore()

    class Bridge(QtCore.QObject):
        finished = QtCore.Signal(object)

    return types.SimpleNamespace(TextButton=TextButton, LoginSwitch=LoginSwitch, Pill=Pill,
                                 InfoIcon=InfoIcon, Heading=Heading, Body=Body,
                                 FlowLayout=FlowLayout, NewsList=NewsList,
                                 NewsDelegate=NewsDelegate, Bridge=Bridge)


def run_gui(result: FeedResult, state: NewsState, *, refresh: bool, record: bool) -> int:
    """Show announcements; closing the window dismisses every announcement it lists."""
    # Qt loads only when there is something to show, keeping quiet logins cheap.
    from PySide6 import QtCore, QtGui, QtNetwork, QtWidgets
    Qt = QtCore.Qt

    app = QtWidgets.QApplication.instance() or QtWidgets.QApplication(sys.argv[:1])
    app.setApplicationName("monolith-news")
    app.setApplicationDisplayName("Monolith News")
    # The Wayland app_id then matches the launcher's name and icon.
    app.setDesktopFileName("monolith-news")
    app.setWindowIcon(QtGui.QIcon.fromTheme("monolith-logo"))

    # Previews skip this so they never raise or replace the real window.
    server_name = None
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if record and os.path.isabs(runtime):
        server_name = os.path.join(runtime, "monolith-news.socket")
        probe = QtNetwork.QLocalSocket()
        probe.connectToServer(server_name)
        if probe.waitForConnected(1000):
            # The running window raises itself and records its own dismissals.
            probe.disconnectFromServer()
            return 0

    ui = widget_classes()
    weight = QtGui.QFont.Weight
    database = QtGui.QFontDatabase
    sans = database.systemFont(database.SystemFont.GeneralFont).family()
    mono = database.systemFont(database.SystemFont.FixedFont).family()

    def font(pixels, bold=weight.Normal, *, fixed_pitch=False, spacing=0.0):
        # The desktop's fonts stand in when IBM Plex is missing.
        value = QtGui.QFont()
        value.setFamilies(["IBM Plex Mono", mono] if fixed_pitch else ["IBM Plex Sans", sans])
        value.setPixelSize(pixels)
        value.setWeight(bold)
        if spacing:
            value.setLetterSpacing(QtGui.QFont.SpacingType.AbsoluteSpacing, spacing)
        return value

    small_font = font(12)
    button_font = font(13)
    body_font = font(15)
    code_font = font(13, fixed_pitch=True)

    def label(text, label_font, ink, *, wrap=False, rich=False):
        widget = QtWidgets.QLabel(text)
        widget.setTextFormat(Qt.TextFormat.RichText if rich else Qt.TextFormat.PlainText)
        widget.setFont(label_font)
        widget.setWordWrap(wrap)
        if wrap:
            # Take the width the layout offers instead of demanding the longest word's.
            size_policy = widget.sizePolicy()
            size_policy.setHorizontalPolicy(QtWidgets.QSizePolicy.Policy.Ignored)
            widget.setSizePolicy(size_policy)
        palette = widget.palette()
        palette.setColor(QtGui.QPalette.ColorRole.WindowText, QtGui.QColor(ink))
        widget.setPalette(palette)
        return widget

    def open_url(url):
        # Feed link buttons are validated, but Markdown links in bodies are not.
        if url.startswith("https://"):
            QtGui.QDesktopServices.openUrl(QtCore.QUrl(url))

    # The design is dark whatever the desktop color scheme; native parts such as
    # text selection follow this palette.
    palette = QtGui.QPalette()
    role = QtGui.QPalette.ColorRole
    for color_role, value in (
            (role.Window, Color.WINDOW), (role.WindowText, Color.TEXT), (role.Base, Color.WINDOW),
            (role.AlternateBase, Color.SIDEBAR), (role.Text, Color.BODY),
            (role.Button, Color.SELECTED), (role.ButtonText, Color.TEXT),
            (role.Highlight, Color.ACCENT), (role.HighlightedText, Color.ON_ACCENT),
            (role.Link, Color.ACCENT), (role.LinkVisited, Color.ACCENT),
            (role.PlaceholderText, Color.MUTED), (role.ToolTipBase, Color.CHROME),
            (role.ToolTipText, Color.TEXT), (role.Light, Color.RING), (role.Midlight, Color.RING),
            (role.Mid, Color.DIVIDER), (role.Dark, Color.CHROME), (role.Shadow, "#000000")):
        palette.setColor(color_role, QtGui.QColor(value))

    window = QtWidgets.QWidget()
    window.setObjectName("newsWindow")
    window.setWindowTitle("Monolith News")
    window.resize(900, 640)
    window.setMinimumSize(720, 480)
    window.setPalette(palette)
    window.setStyleSheet(STYLESHEET)
    layout = QtWidgets.QVBoxLayout(window)
    layout.setContentsMargins(0, 0, 0, 0)
    layout.setSpacing(0)
    panes = QtWidgets.QHBoxLayout()
    panes.setSpacing(0)
    layout.addLayout(panes, 1)

    sidebar = QtWidgets.QFrame()
    sidebar.setObjectName("sidebar")
    sidebar.setFixedWidth(270)
    side = QtWidgets.QVBoxLayout(sidebar)
    side.setContentsMargins(0, 0, 0, 0)
    side.setSpacing(0)
    panes.addWidget(sidebar)

    header = QtWidgets.QHBoxLayout()
    header.setContentsMargins(18, 20, 18, 14)
    heading_font = font(20, weight.Bold, spacing=-0.3)
    header.addWidget(label("News", heading_font, Color.TEXT), 0, Qt.AlignmentFlag.AlignBottom)
    header.addStretch()
    mark_all = ui.TextButton("Mark all read", small_font, ink=Color.MUTED, hover_ink=Color.TEXT)
    # Raise the smaller text onto the heading's baseline.
    mark_all.setContentsMargins(0, 0, 0, QtGui.QFontMetrics(heading_font).descent()
                                - QtGui.QFontMetrics(small_font).descent())
    header.addWidget(mark_all, 0, Qt.AlignmentFlag.AlignBottom)
    side.addLayout(header)

    news_list = ui.NewsList()
    news_list.setAccessibleName("Announcements")
    news_list.setFrameShape(QtWidgets.QFrame.Shape.NoFrame)
    news_list.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
    news_list.setVerticalScrollMode(QtWidgets.QAbstractItemView.ScrollMode.ScrollPerPixel)
    news_list.setResizeMode(QtWidgets.QListView.ResizeMode.Adjust)
    news_list.setMouseTracking(True)
    news_list.viewport().setAttribute(Qt.WidgetAttribute.WA_Hover)
    news_list.viewport().setCursor(Qt.CursorShape.PointingHandCursor)
    list_palette = news_list.palette()
    for color_role in (role.Window, role.Base):
        list_palette.setColor(color_role, QtGui.QColor(Color.SIDEBAR))
    news_list.setPalette(list_palette)
    delegate = ui.NewsDelegate(news_list, font(14, weight.DemiBold), small_font)
    news_list.setItemDelegate(delegate)
    side.addWidget(news_list, 1)

    older_bar = QtWidgets.QFrame()
    older_bar.setObjectName("olderBar")
    older_layout = QtWidgets.QVBoxLayout(older_bar)
    older_layout.setContentsMargins(0, 0, 0, 0)
    older = ui.TextButton("Older announcements on GitHub →", small_font, ink=Color.MUTED,
                          hover_ink=Color.TEXT, padding=(18, 12))
    older.setSizePolicy(QtWidgets.QSizePolicy.Policy.Expanding,
                        QtWidgets.QSizePolicy.Policy.Fixed)
    older.clicked.connect(lambda: open_url(HISTORY_URL))
    older_layout.addWidget(older)
    side.addWidget(older_bar)

    def note(text):
        frame = QtWidgets.QFrame()
        frame.setObjectName("note")
        row = QtWidgets.QHBoxLayout(frame)
        row.setContentsMargins(14, 12, 14, 12)
        row.setSpacing(10)
        line_height = QtGui.QFontMetrics(button_font).height()
        row.addWidget(ui.InfoIcon(13, line_height), 0, Qt.AlignmentFlag.AlignTop)
        row.addWidget(label(text, button_font, Color.TERTIARY, wrap=True), 1)
        return frame

    reading = QtWidgets.QScrollArea()
    reading.setWidgetResizable(True)
    reading.setFrameShape(QtWidgets.QFrame.Shape.NoFrame)
    reading.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
    page = QtWidgets.QWidget()
    page_layout = QtWidgets.QHBoxLayout(page)
    page_layout.setContentsMargins(36, 28, 36, 32)
    column = QtWidgets.QWidget()
    column.setMaximumWidth(600)
    page_layout.addWidget(column, 1)
    page_layout.addStretch(0)
    column_layout = QtWidgets.QVBoxLayout(column)
    column_layout.setContentsMargins(0, 0, 0, 0)
    column_layout.setSpacing(16)
    status_note = note(STATUS_CACHED)
    column_layout.addWidget(status_note)
    column_layout.addStretch(1)
    reading.setWidget(page)
    panes.addWidget(reading, 1)

    footer = QtWidgets.QFrame()
    footer.setObjectName("footerBar")
    bar = QtWidgets.QHBoxLayout(footer)
    bar.setContentsMargins(18, 12, 14, 12)
    bar.setSpacing(16)
    login = ui.LoginSwitch("Show at login", button_font, login_check_enabled())

    def toggle_login(checked):
        try:
            set_login_check(checked)
        except OSError as error:
            warn(f"could not change the login check: {error}")
            login.blockSignals(True)
            login.setChecked(not checked)
            login.blockSignals(False)

    login.toggled.connect(toggle_login)
    bar.addWidget(login)
    bar.addStretch()
    footer_links = QtWidgets.QHBoxLayout()
    footer_links.setSpacing(4)
    for text, url in FOOTER_LINKS:
        button = ui.TextButton(text, button_font, ink=Color.SECONDARY, hover_ink=Color.TEXT,
                               hover_fill=Color.SELECTED, padding=(10, 7))
        button.clicked.connect(lambda _checked=False, url=url: open_url(url))
        footer_links.addWidget(button)
    bar.addLayout(footer_links)
    done = ui.TextButton("Done", font(13, weight.DemiBold), ink=Color.ON_ACCENT,
                         hover_ink=Color.ON_ACCENT, fill=Color.ACCENT, hover_fill=Color.ACCENT_LIGHT,
                         padding=(18, 8), focus=Color.TEXT)
    done.setObjectName("doneButton")
    done.clicked.connect(window.close)
    bar.addWidget(done)
    layout.addWidget(footer)
    QtGui.QShortcut(QtGui.QKeySequence(Qt.Key.Key_Escape), window).activated.connect(window.close)

    def short_date(day):
        pattern = "MMM d" if day.year == datetime.date.today().year else "MMM d, yyyy"
        return QtCore.QLocale().toString(QtCore.QDate(day.year, day.month, day.day), pattern)

    def long_date(day):
        return QtCore.QLocale().toString(QtCore.QDate(day.year, day.month, day.day),
                                         QtCore.QLocale.FormatType.LongFormat)

    def body(markdown):
        document = QtGui.QTextDocument()
        document.setDefaultFont(body_font)
        document.setDocumentMargin(0)
        # Qt's Markdown importer shows raw HTML as text instead of rendering it.
        document.setMarkdown(markdown, QtGui.QTextDocument.MarkdownFeature.MarkdownDialectGitHub
                             | QtGui.QTextDocument.MarkdownFeature.MarkdownNoHTML)
        cursor = QtGui.QTextCursor(document)

        def restyle(start, end, change):
            cursor.setPosition(start)
            cursor.setPosition(end, QtGui.QTextCursor.MoveMode.KeepAnchor)
            cursor.mergeCharFormat(change)

        chips = []
        has_links = False
        block = document.begin()
        while block.isValid():
            following = block.next()
            lists = block.textList(), following.textList() if following.isValid() else None
            same_list = None not in lists and lists[0].objectIndex() == lists[1].objectIndex()
            block_format = block.blockFormat()
            block_format.setTopMargin(0)
            block_format.setBottomMargin(0 if not following.isValid() else 6 if same_list else 12)
            # CSS line-height 1.6 at 15px.
            block_format.setLineHeight(24, QtGui.QTextBlockFormat.LineHeightTypes.MinimumHeight.value)
            cursor.setPosition(block.position())
            cursor.setBlockFormat(block_format)
            spans = []
            fragments = block.begin()
            while not fragments.atEnd():
                fragment = fragments.fragment()
                spans.append((fragment.position(), fragment.length(), fragment.charFormat()))
                fragments += 1
            for position, length, char_format in spans:
                change = QtGui.QTextCharFormat()
                if char_format.isAnchor():
                    has_links = True
                    change.setForeground(QtGui.QColor(Color.ACCENT))
                elif char_format.fontFixedPitch():
                    change.setFont(code_font, QtGui.QTextCharFormat.FontPropertiesInheritanceBehavior
                                   .FontPropertiesSpecifiedOnly)
                    change.setForeground(QtGui.QColor(Color.TEXT))
                    if chips and chips[-1][1] == position:
                        chips[-1] = (chips[-1][0], position + length)
                    else:
                        chips.append((position, position + length))
                elif char_format.fontWeight() >= weight.DemiBold.value:
                    change.setForeground(QtGui.QColor(Color.TEXT))
                else:
                    continue
                restyle(position, position + length, change)
            block = following
        # Letter spacing after the character before each chip and after its last
        # character makes room for the chip's padding without changing copied text.
        padding = QtGui.QTextCharFormat()
        padding.setFontLetterSpacingType(QtGui.QFont.SpacingType.AbsoluteSpacing)
        padding.setFontLetterSpacing(ui.Body.CHIP_PAD)
        for start, end in chips:
            if start > document.findBlock(start).position():
                restyle(start - 1, start, padding)
            restyle(end - 1, end, padding)
        view = ui.Body(document, chips, code_font, has_links)
        view.anchorClicked.connect(lambda url: open_url(url.toString()))
        return view

    def build_article(announcement):
        widget = QtWidgets.QWidget()
        box = QtWidgets.QVBoxLayout(widget)
        box.setContentsMargins(0, 0, 0, 0)
        box.setSpacing(16)
        head = QtWidgets.QVBoxLayout()
        head.setSpacing(10)
        meta = QtWidgets.QHBoxLayout()
        meta.setSpacing(10)
        if announcement.id not in state.dismissed:
            meta.addWidget(ui.Pill("NEW", font(11, weight.DemiBold, spacing=0.3)))
        meta.addWidget(label(long_date(announcement.date), small_font, Color.MUTED))
        if announcement.category:
            meta.addWidget(label("·", small_font, Color.MUTED))
            meta.addWidget(label(announcement.category, small_font, Color.MUTED))
        meta.addStretch()
        head.addLayout(meta)
        head.addWidget(ui.Heading(announcement.title, font(26, weight.Bold, spacing=-0.4),
                                  Color.TEXT))
        box.addLayout(head)
        if announcement.install_path:
            strip = QtWidgets.QFrame()
            strip.setObjectName("getIt")
            row = QtWidgets.QHBoxLayout(strip)
            row.setContentsMargins(14, 12, 14, 12)
            row.setSpacing(12)
            row.addWidget(label("Get it", small_font, Color.MUTED))
            arrow = f' <span style="color:{Color.FAINT}">→</span> '
            steps = arrow.join(html.escape(step) for step in announcement.install_path)
            row.addWidget(label(steps, code_font, Color.TEXT, wrap=True, rich=True), 1)
            box.addWidget(strip)
        box.addWidget(body(announcement.body))
        if announcement.note:
            box.addWidget(note(announcement.note))
        if announcement.links:
            buttons = ui.FlowLayout(8)
            for link in announcement.links:
                button = ui.TextButton(link.label, button_font, ink=Color.TEXT, hover_ink=Color.WHITE,
                                       hover_fill=Color.SELECTED, border=Color.RING,
                                       padding=(12, 7), arrow=True)
                button.clicked.connect(lambda _checked=False, url=link.url: open_url(url))
                buttons.addWidget(button)
            box.addLayout(buttons)
        return widget

    listed = []
    shown = set()
    read = set(state.read)
    chosen = None  # The user's pick survives a refresh; otherwise show the newest.
    article = None

    def show(widget):
        nonlocal article
        if article is not None:
            column_layout.removeWidget(article)
            article.deleteLater()
        article = widget
        column_layout.insertWidget(1, widget)
        reading.verticalScrollBar().setValue(0)

    def update_unread():
        for row, announcement in enumerate(listed):
            item = news_list.item(row)
            unread = announcement.id not in read
            item.setData(delegate.UNREAD, unread)
            description = item.data(delegate.META) + (", unread" if unread else "")
            item.setData(Qt.ItemDataRole.AccessibleDescriptionRole, description)

    def open_row(row):
        announcement = listed[row]
        read.add(announcement.id)
        update_unread()
        show(build_article(announcement))

    def selected(row):
        nonlocal chosen
        if 0 <= row < len(listed):
            chosen = listed[row].id
            open_row(row)

    def mark_all_read():
        read.update(announcement.id for announcement in listed)
        update_unread()

    def render(feed, checking=False):
        nonlocal listed
        listed = list(feed.announcements)
        ids = [announcement.id for announcement in listed]
        row = ids.index(chosen) if chosen in ids else 0
        # Qt makes a row current while items arrive; fill the list silently so only
        # the user's own picks count as choices.
        news_list.blockSignals(True)
        news_list.clear()
        for announcement in listed:
            item = QtWidgets.QListWidgetItem(announcement.title)
            category = f" · {announcement.category}" if announcement.category else ""
            item.setData(delegate.META, short_date(announcement.date) + category)
            news_list.addItem(item)
        if listed:
            news_list.setCurrentRow(row)
        news_list.blockSignals(False)
        status_note.setVisible(bool(listed) and feed.source == "cache" and not checking)
        if listed:
            open_row(row)
        else:
            empty = (STATUS_CHECKING if checking
                     else STATUS_UNAVAILABLE if feed.source == "none" else STATUS_EMPTY)
            show(label(empty, body_font, Color.MUTED, wrap=True))
        shown.clear()
        shown.update(ids)

    news_list.currentRowChanged.connect(selected)
    mark_all.clicked.connect(mark_all_read)
    render(result, checking=refresh)

    if server_name is not None:
        QtNetwork.QLocalServer.removeServer(server_name)
        server = QtNetwork.QLocalServer(window)
        if server.listen(server_name):
            def activate():
                while server.hasPendingConnections():
                    server.nextPendingConnection().deleteLater()
                window.showNormal()
                window.raise_()
                window.activateWindow()

            server.newConnection.connect(activate)
        else:
            warn(f"could not listen on {server_name}: {server.errorString()}")

    if refresh:
        def refreshed(feed):
            # A download finishing as the window closes must not change what it dismisses.
            if window.isVisible():
                render(feed)

        # Render on the GUI thread. The daemon thread lets closing the window exit
        # during a slow download.
        bridge = ui.Bridge()
        bridge.finished.connect(refreshed, Qt.ConnectionType.QueuedConnection)
        threading.Thread(target=lambda: bridge.finished.emit(refresh_feed(1)), daemon=True).start()

    window.show()
    news_list.setFocus()
    code = app.exec()
    if record and shown:
        try:
            save_state(shown, read)
        except OSError as error:
            warn(f"could not save which announcements were seen: {error}")
    return code


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="monolith-news", description="Show Monolith announcements from the project repository.")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--autostart", action="store_true",
                      help="open only when there are new announcements; used at login")
    mode.add_argument("--preview", metavar="PATH", type=Path,
                      help="show a local feed file without saving anything")
    args = parser.parse_args(argv)

    if args.preview is not None:
        try:
            announcements, problems = parse_feed(args.preview.read_bytes())
        except (OSError, FeedError) as error:
            warn(str(error))
            return 1
        for problem in problems:
            warn(problem)
        return run_gui(FeedResult(tuple(announcements), "network"),
                       NewsState(frozenset(), frozenset()), refresh=False, record=False)

    if args.autostart:
        # Also covers a user manager that has not rerun the autostart generator.
        if not login_check_enabled():
            return 0
        result = refresh_feed(LOGIN_ATTEMPTS)
        state = load_state()
        if not unseen(result.announcements, state.dismissed):
            return 0
        return run_gui(result, state, refresh=False, record=True)

    cached = load_cached_feed()
    initial = FeedResult(tuple(cached), "cache") if cached is not None else FeedResult((), "none")
    return run_gui(initial, load_state(), refresh=True, record=True)


if __name__ == "__main__":
    sys.exit(main())
