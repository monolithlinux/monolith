    ACCENT_LIGHT = "#f0b65c"
    ON_ACCENT = "#1a1408"
    SWITCH_OFF = "#3a3f46"
    # rgba(232, 163, 61, 0.14) over WINDOW, the only background behind the pill.
    PILL = "#383126"


