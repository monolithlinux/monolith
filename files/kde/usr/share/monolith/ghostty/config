# Keep Monolith's terminal shell and font when moving from Ptyxis.
# Copied on first launch only; subsequent changes belong to the user.
command = /usr/bin/fish
font-family = JetBrainsMono Nerd Font
font-size = 12

# Show GTK titlebar buttons on KDE and use Gruvbox Dark Medium.
window-decoration = client
gtk-titlebar = true
theme = base16-gruvbox-dark-medium
